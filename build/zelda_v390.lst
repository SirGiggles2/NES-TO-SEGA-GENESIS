                            	   290: GENESIS_RESET:
                            	   291:     ; Disable interrupts immediately
02:0000038C 46FC2700        	   292:     move    #$2700,SR
                            	   293: 
                            	   294:     ; ?"??"? Initialize the TMSS (trademark security system) ?"??"?
                            	   295:     ; Required on real hardware or it won't boot
02:00000390 103900A10001    	   296:     move.b  ($A10001),D0            ; read hardware version
02:00000396 0200000F        	   297:     andi.b  #$0F,D0                 ; mask version bits
02:0000039A 670A            	   298:     beq     .skip_tmss              ; version 0 = no TMSS
02:0000039C 23FC5345474100A1	   299:     move.l  #'SEGA',($A14000)       ; write TMSS signature
02:000003A4 4000
                            	   300: .skip_tmss:
                            	   301: 
                            	   302:     ; ?"??"? Stop the Z80 (sound CPU) ?"??"?
02:000003A6 33FC010000A11100	   303:     move.w  #$0100,($A11100)        ; request Z80 bus
02:000003AE 33FC010000A11200	   304:     move.w  #$0100,($A11200)        ; reset Z80
