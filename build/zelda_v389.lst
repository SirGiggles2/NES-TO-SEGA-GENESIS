                            	   550: ; ResetHandler_NES - Entry point into translated Zelda code
                            	   551: ; This bridges the Genesis init to the NES reset handler
                            	   552: ; The actual NES reset handler is in bank_FF_gen68k_vdp.asm
                            	   553: ; ?.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.?
                            	   554: ResetHandler_NES:
                            	   555:     ; NES reset is in bank_FF (the fixed bank)
                            	   556:     ; After our Genesis init above, skip the NES hardware init
                            	   557:     ; (SEI, CLD, stack setup) since we've done it Genesis-style
                            	   558:     ; Jump straight to the game init proper
02:00000654 4EF849C9        	   559:     JMP     MainInit                ; defined in bank_FF_gen68k_vdp.asm
