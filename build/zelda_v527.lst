Source: "bank_FF_gen68k_vdp.asm"
                            	     1: ; ═══════════════════════════════════════
                            	     2: ; AUTO-TRANSLATED from NES 6502 → Sega Genesis 68000
                            	     3: ; ── VDP Layer included via vdp_layer.asm ──
                            	     4: ; Run: include "vdp_layer.asm" in your main build
                            	     5: 
                            	     6: ; Source: bank_FF.asm
                            	     7: ; !! This is a FIRST PASS - hardware I/O needs manual work !!
                            	     8: ; Register mapping:
                            	     9: ;   A (accumulator) → D0
                            	    10: ;   X (index)       → D1
                            	    11: ;   Y (index)       → D2
                            	    12: ;   Temp            → D3, D4, D5
                            	    13: ;   NES RAM base    → A0 = $FF0000
                            	    14: ; ═══════════════════════════════════════
                            	    15: 
                            	    16:     ; [DIRECTIVE] .SEGMENT "BANK_FF"  -- needs manual handling  ; orig: .segment "BANK_FF"
