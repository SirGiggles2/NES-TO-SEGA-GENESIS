02:0000DFD0 103900FF0438    	  2396:     MOVE.B  ($00FF0438).l,D0  ; orig: C - - J - - 0x009B89 02:9B79: AD 38 04  LDA ram_0437_enemy +
02:0000DFD6 6000011A        	  2397:     JMP     b02_bra_9BD0  ; replaced BNE (forced for build reliability)
                            	  2398:     ; FIX v487: Direct ROM table access for palette fade data
                            	  2399:     ; Original code had two bugs:
                            	  2400:     ;   1. NES ADC translated as ADD.B by Fix G (drops carry, wrong pointer for steps >= 5)
                            	  2401:     ;   2. MOVEA.W sign-extends ROM pointers >= $8000 (reads from $FE9969 instead of ROM $9969)
                            	  2402:     ; Fix: compute table offset directly and read from correct ROM address
02:0000DFDA 7A00            	  2403:     MOVEQ   #0,D5
02:0000DFDC 1A3900FF0437    	  2404:     MOVE.B  ram_0437_link,D5             ; D5 = fade step (0-13)
02:0000DFE2 EB4D            	  2405:     LSL.W   #5,D5                        ; D5 = step * 32 (each fade entry is 32 bytes)
02:0000DFE4 227C0000DE46    	  2406:     MOVEA.L #tbl_9969_logo_blackout_palette,A1
02:0000DFEA D2C5            	  2407:     ADDA.W  D5,A1                        ; A1 = &tbl_9969[step * 32]
02:0000DFEC 103C003F        	  2408:     MOVE.B  #$3F,D0
02:0000DFF0 13C000FF0302    	  2409:     MOVE.B  D0,ram_0302_ppu_buffer       ; PPU addr high = $3F
02:0000DFF6 103C0000        	  2410:     MOVE.B  #$00,D0
02:0000DFFA 13C000FF0303    	  2411:     MOVE.B  D0,ram_0302_ppu_buffer+1     ; PPU addr low = $00 → write to $3F00 (palette)
02:0000E000 103C0020        	  2412:     MOVE.B  #$20,D0
02:0000E004 13C000FF0304    	  2413:     MOVE.B  D0,ram_0302_ppu_buffer+2     ; control: 32 bytes, literal, increment by 1
02:0000E00A 143C001F        	  2414:     MOVE.B  #$1F,D2                      ; loop counter: 31 down to 0
02:0000E00E 103C00FF        	  2415:     MOVE.B  #$FF,D0
02:0000E012 41F900FF0306    	  2416:     LEA     (ram_0302_ppu_buffer+4).l,A0
02:0000E018 11802000        	  2417:     MOVE.B  D0,(A0,D2.W)                ; set $FF terminator at buffer end
                            	  2418:     ; FIX v487: Set buffer index to non-zero so VDP_VBLANK_HANDLER doesn't
                            	  2419:     ; clear the buffer before the NMI handler can process it
02:0000E01C 13FC000100FF0301	  2420:     MOVE.B  #$01,ram_0301_buffer_index
                            	  2421: b02_bra_9BAE_loop:
02:0000E024 10312000        	  2422:     MOVE.B  (A1,D2.W),D0                ; FIX v487: read palette from ROM directly
02:0000E028 41F900FF0305    	  2423:     LEA     (ram_0302_ppu_buffer+3).l,A0
02:0000E02E 11802000        	  2424:     MOVE.B  D0,(A0,D2.W)  ; orig: C - - - - - 0x009BC0 02:9BB0: 99 05 03  STA ram_0302_ppu_buf
02:0000E032 5302            	  2425:     SUBQ.B  #1,D2           ; DEY  ; orig: C - - - - - 0x009BC3 02:9BB3: 88        DEY
02:0000E034 6074            	  2426:     JMP     b02_bra_9BAE_loop  ; replaced BPL (forced for build reliability)
02:0000E036 523900FF0437    	  2427:     ADDQ.B  #1,ram_0437_link  ; orig: C - - - - - 0x009BC6 02:9BB6: EE 37 04  INC ram_0437_link
02:0000E03C 143900FF0437    	  2428:     MOVE.B  ram_0437_link,D2  ; orig: C - - - - - 0x009BC9 02:9BB9: AC 37 04  LDY ram_0437_link
02:0000E042 207C0000E045    	  2429:     MOVEA.L #tbl_9B69-1,A0
02:0000E048 10302800        	  2430:     MOVE.B  (A0,D2.L),D0  ; orig: C - - - - - 0x009BCC 02:9BBC: B9 68 9B  LDA tbl_9B69 - $01,Y
02:0000E04C 11400438        	  2431:     MOVE.B  D0,$0438(A0)  ; orig: C - - - - - 0x009BCF 02:9BBF: 8D 38 04  STA ram_0437_enemy +  ; auto: large disp → 
02:0000E050 0C02000E        	  2432:     CMPI.B  #$0E,D2  ; orig: C - - - - - 0x009BD2 02:9BC2: C0 0E     CPY #$0E
02:0000E054 6000009C        	  2433:     JMP     b02_bra_9BD0  ; replaced BCS (forced for build reliability)
02:0000E058 523900FF042C    	  2434:     ADDQ.B  #1,ram_042B_enemy  ; orig: C - - - - - 0x009BD6 02:9BC6: EE 2C 04  INC ram_042B_enemy
