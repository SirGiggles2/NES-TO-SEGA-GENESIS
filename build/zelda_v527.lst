                            	    74: ; This table is required for palette calibration and static guard scripts.
                            	    75: NES_PALETTE_DATA:
02:00000690 0F              	    76: 	dc.b $0F,$30,$21,$12, $0F,$30,$21,$12
02:00000691 30
02:00000692 21
02:00000693 12
02:00000694 0F
02:00000695 30
02:00000696 21
02:00000697 12
