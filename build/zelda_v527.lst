                            	    30:     ; [DIRECTIVE] .EXPORT sub_0x01E607_hide_all_sprites  -- needs manual handling  ; orig: .export sub_0x01E607_hide_al
                            	    31:     ; [DIRECTIVE] .EXPORT loc_0x01E607_hide_all_sprites  -- needs manual handling  ; orig: .export loc_0x01E607_hide_al
