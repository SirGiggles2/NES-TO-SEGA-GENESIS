02:00000699 30
02:0000069A 21
02:0000069B 12
02:0000069C 0F
02:0000069D 30
02:0000069E 21
02:0000069F 12
02:000006A0 0F              	    78: 	dc.b $0F,$30,$21,$12, $0F,$30,$21,$12
02:000006A1 30
02:000006A2 21
