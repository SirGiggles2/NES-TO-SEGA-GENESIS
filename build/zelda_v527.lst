                            	    18:     ; [DIRECTIVE] .INCLUDE "copy_bank_val.inc"  -- needs manual handling  ; orig: .include "copy_bank_val.inc"
                            	    19:     ; [DIRECTIVE] .ORG $C000  -- needs manual handling  ; orig: .org $C000  ; for listing file
                            	    20: 
                            	    21: ; 0x01C010-0x02000F
                            	    22: 
                            	    23: 
                            	    24: 
