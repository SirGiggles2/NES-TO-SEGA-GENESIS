02:0000059C 48F97FFF00FFEE40	   493:     movem.l D0-D7/A0-A6,(CRASH_REGS).l
02:000005A4 23CF00FFEE04    	   494:     move.l  A7,(CRASH_SP).l         ; exception frame SP on entry
02:000005AA 33FCBEEF00FFEE00	   495:     move.w  #$BEEF,(CRASH_MAGIC).l
02:000005B2 4A7900FFEE02    	   496:     tst.w   (CRASH_VECTOR).l
02:000005B8 6608            	   497:     bne     .vector_ready
02:000005BA 33FCFFFF00FFEE02	   498:     move.w  #$FFFF,(CRASH_VECTOR).l
                            	   499: .vector_ready:
02:000005C2 33D700FFEE08    	   500:     move.w  (A7),(CRASH_SR).l       ; generic SR
02:000005C8 23EF000200FFEE0A	   501:     move.l  2(A7),(CRASH_PC).l      ; generic PC
02:000005D0 42B900FFEE80    	   502:     clr.l   (CRASH_AUX).l
02:000005D6 427900FFEE84    	   503:     clr.w   (CRASH_AUX+$04).l
02:000005DC 0C79000200FFEE02	   504:     cmpi.w  #$0002,(CRASH_VECTOR).l
02:000005E4 670A            	   505:     beq     .decode_bus_addr
02:000005E6 0C79000300FFEE02	   506:     cmpi.w  #$0003,(CRASH_VECTOR).l
02:000005EE 6620            	   507:     bne     .copy_frame_data
