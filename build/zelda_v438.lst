02:000003E6 427900FFF000    	   331:     clr.w   (TRACE_LAST).l
02:000003EC 427900FFF0AC    	   332:     clr.w   (TRACE_SEQ_EVT_COUNT).l
02:000003F2 427900FFF0AE    	   333:     clr.w   (TRACE_PPU_EVT_COUNT).l
02:000003F8 427900FFF0B0    	   334:     clr.w   (TRACE_PPU_EVT_ARG0).l
02:000003FE 427900FFF0B2    	   335:     clr.w   (TRACE_PPU_EVT_ARG1).l
02:00000404 427900FFF0B4    	   336:     clr.w   (TRACE_PPU_EVT_ARG2).l
02:0000040A 423900FFF0B6    	   337:     clr.b   (TRACE_PPU_ROM_REC_HI).l
02:00000410 423900FFF0B7    	   338:     clr.b   (TRACE_PPU_ROM_REC_LO).l
02:00000416 423900FFF0B8    	   339:     clr.b   (TRACE_PPU_ROM_REC_CTRL).l
02:0000041C 42B900FFF0BA    	   340:     clr.l   (TRACE_PPU_ROM_REC_DATA).l
02:00000422 423900FF0011    	   341:     clr.b   (ram_0011_screen_ready_flag).l
