                            	   345:     ; ?"??"? Allow VBlank (Level 6) interrupts ?"??"?
                            	   346:     ; NES NMI is non-maskable: fires regardless of I flag.
                            	   347:     ; Genesis Level 6 is maskable: blocked while IPM >= 6.
                            	   348:     ; Zelda never uses CLI (doesn't need to on NES), so we must lower IPM here.
02:0000042E 027CF8FF        	   349:     andi    #$F8FF,SR               ; clear IPM bits ??' allow Level 6 VBlank
