                            	   529: ; CHR_VRAM_LOAD - Copy pre-converted 4bpp tile data into VDP VRAM
                            	   530: ; Called once at startup after VDP_INIT.
                            	   531: ; Loads 512 tiles (16KB) into VRAM $0000-$3FFF:
                            	   532: ;   Tiles   0-255  (VRAM $0000-$1FFF) = PT0 background tiles
                            	   533: ;   Tiles 256-511  (VRAM $2000-$3FFF) = PT1 sprite tiles
                            	   534: ; Source: zelda_tiles_4bpp.bin (generated by chr_convert.py)
                            	   535: ; ?.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.?
                            	   536: CHR_VRAM_LOAD:
                            	   537:     ; Set VRAM write address to $0000 (tile area base)
02:00000634 23FC4000000000C0	   538:     move.l  #$40000000,($C00004)    ; VRAM write cmd for addr $0000
02:0000063C 0004
                            	   539:     ; Stream 16KB of 4bpp tile data from ROM to VRAM
                            	   540:     ; VDP auto-increment = 2, MOVE.L writes 4 bytes per iteration
02:0000063E 207C0002A3D0    	   541:     movea.l #ZELDA_TILES_4BPP,A0
02:00000644 303C0FFF        	   542:     move.w  #(16384/4)-1,D0        ; 4095 = 4096 iterations
                            	   543: .chr_loop:
02:00000648 23D800C00000    	   544:     move.l  (A0)+,($C00000)        ; 4 bytes ??' 2 VDP words ??' VRAM +4
02:0000064E 51C8FFF8        	   545:     dbra    D0,.chr_loop
02:00000652 4E75            	   546:     rts
                            	   547: 
                            	   548: CHR_SHADOW_LOAD:
                            	   549:     ; Keep emulated PPU pattern reads in sync with the startup VRAM upload.
02:00000654 207C0002E3D0    	   550:     movea.l #ZELDA_CHR_2BPP,A0
02:0000065A 227C00FFC000    	   551:     movea.l #$00FFC000,A1
02:00000660 303C07FF        	   552:     move.w  #(8192/4)-1,D0
                            	   553: .chr_shadow_loop:
02:00000664 22D8            	   554:     move.l  (A0)+,(A1)+
02:00000666 51C8FFFC        	   555:     dbra    D0,.chr_shadow_loop
02:0000066A 4E75            	   556:     rts
