                            	  6891:     ; Fix: advance 16-bit PPU buffer pointer by (Y+1) bytes
                            	  6892:     ; NES was: SEC; TYA; ADC ptr_lo; STA ptr_lo; LDA #0; ADC ptr_hi; STA ptr_hi
02:00024E66 123900FF0000    	  6893:     MOVE.B  ram_0000_t11_ppu_data,D1            ; start from current low byte
02:00024E6C 1802            	  6894:     MOVE.B  D2,D4                               ; D4 = Y (bytes consumed this record)
02:00024E6E 5204            	  6895:     ADDQ.B  #1,D4                               ; D4 = Y+1 (NES SEC effect)
02:00024E70 D204            	  6896:     ADD.B   D4,D1                               ; D1 = lo_ptr + Y + 1, carry = high-byte bump
02:00024E72 13C100FF0000    	  6897:     MOVE.B  D1,ram_0000_t11_ppu_data            ; store new low byte without clobbering carry first
