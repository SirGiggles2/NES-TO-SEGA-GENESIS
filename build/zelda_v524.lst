                            	   583: 
                            	   584: ; BRIDGE: NES serial controller read replaced with Genesis parallel read.
                            	   585: ; NES reads $4016 serially (1 bit per read, active-high). Genesis data port
                            	   586: ; is parallel (all bits at once, active-low). The serial protocol cannot work.
                            	   587: ; READ_JOYPAD in main.asm already reads the Genesis controller, converts to
                            	   588: ; NES button format, and stores at $FF00F0. We just use that directly.
                            	   589: sub_E62D_read_joysticks:  ; orig: sub_E62D_read_joysticks:
02:0000185C 6100ECC4        	   590:     BSR     READ_JOYPAD                          ; read Genesis pad → D0 + $FF00F0
02:00001860 7200            	   591:     MOVEQ   #0,D1                                ; Player 1 (X=0)
02:00001862 6102            	   592:     BSR.S   sub_E640_read_player_input
02:00001864 5201            	   593:     ADDQ.B  #1,D1                                ; Player 2 (X=1)
                            	   594: sub_E640_read_player_input:
                            	   595:     ; Get button state: P1 from $FF00F0 (set by READ_JOYPAD), P2 = 0
02:00001866 4A01            	   596:     TST.B   D1
02:00001868 6608            	   597:     BNE.S   .joy_p2_zero
02:0000186A 103900FF00F0    	   598:     MOVE.B  ($FF00F0).l,D0                       ; P1: NES-format from READ_JOYPAD
02:00001870 6002            	   599:     BRA.S   .joy_got_buttons
                            	   600: .joy_p2_zero:
02:00001872 7000            	   601:     MOVEQ   #0,D0                                ; P2: no controller
                            	   602: .joy_got_buttons:
                            	   603:     ; Press detection: press = (new XOR old) AND new
02:00001874 1600            	   604:     MOVE.B  D0,D3                                ; D3 = full button state (hold)
                            	   605:     ; Load previous hold into D2 (avoid indexed EOR that fix_syntax mangles)
02:00001876 207C00FF00FA    	   606:     MOVEA.L #ram_btn_hold,A0
02:0000187C 14301800        	   607:     MOVE.B  (A0,D1.L),D2                         ; D2 = previous hold
02:00001880 B500            	   608:     EOR.B   D2,D0                                ; D0 = changed buttons
02:00001882 C003            	   609:     AND.B   D3,D0                                ; D0 = newly pressed only
02:00001884 207C00FF00F8    	   610:     MOVEA.L #ram_btn_press,A0
02:0000188A 11801800        	   611:     MOVE.B  D0,(A0,D1.L)                         ; store new presses
02:0000188E 207C00FF00FA    	   612:     MOVEA.L #ram_btn_hold,A0
02:00001894 11831800        	   613:     MOVE.B  D3,(A0,D1.L)                         ; update hold state
02:00001898 4E75            	   614:     RTS                     ; RTS  ; orig: C - - - - - 0x01E688 07:E678: 60        RTS
