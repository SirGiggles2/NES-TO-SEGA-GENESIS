                            	     5: 
                            	     6: ; Source: bank_FF.asm
                            	     7: ; !! This is a FIRST PASS - hardware I/O needs manual work !!
                            	     8: ; Register mapping:
                            	     9: ;   A (accumulator) → D0
                            	    10: ;   X (index)       → D1
                            	    11: ;   Y (index)       → D2
                            	    12: ;   Temp            → D3, D4, D5
                            	    13: ;   NES RAM base    → A0 = $FF0000
                            	    14: ; ═══════════════════════════════════════
