02:0000151E 303C0318        	   510:     MOVE.W  #$0318,D0
02:00001522 6100EF18        	   511:     BSR     TRACE_MARK
02:00001526 301F            	   512:     MOVE.W  (A7)+,D0
02:00001528 4ED0            	   513:     JMP     (A0)            ; jump to target (does not return through BSR)
