                            	   494:     ; bzk rewrite: NES JSR dispatch → 68K BSR dispatch with DC.L jump table
                            	   495:     ; NES: JSR pushed 2-byte return addr; PLA/PLA recovered it; table was .WORD (16-bit)
                            	   496:     ; 68K: BSR pushes 4-byte return addr pointing right at DC.L table entries
                            	   497:     ; D0 = script index (0-based, byte)
02:000014EA 33C000FFF084    	   498:     MOVE.W  D0,(TRACE_SCRIPT_RAW).l
02:000014F0 23CF00FFF090    	   499:     MOVE.L  A7,(TRACE_DISP_STACK).l
02:000014F6 024000FF        	   500:     ANDI.W  #$00FF,D0
02:000014FA E540            	   501:     ASL.W   #2,D0           ; D0 = index * 4 (DC.L entry = 4 bytes each)
02:000014FC 33C000FFF086    	   502:     MOVE.W  D0,(TRACE_DISP_INDEX).l
02:00001502 225F            	   503:     MOVEA.L (A7)+,A1        ; pop BSR's 4-byte return address → A1 = DC.L table base
02:00001504 20710000        	   504:     MOVEA.L (A1,D0.W),A0   ; read 32-bit target address from table[index]
02:00001508 23C900FFF088    	   505:     MOVE.L  A1,(TRACE_DISP_BASE).l
02:0000150E 23C800FFF08C    	   506:     MOVE.L  A0,(TRACE_DISP_TARGET).l
02:00001514 3F00            	   507:     MOVE.W  D0,-(A7)
02:00001516 303C0317        	   508:     MOVE.W  #$0317,D0
