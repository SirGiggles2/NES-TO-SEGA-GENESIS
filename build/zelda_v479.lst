                            	   582: 
                            	   583: ; BRIDGE: NES serial controller read replaced with Genesis parallel read.
                            	   584: ; NES reads $4016 serially (1 bit per read, active-high). Genesis data port
                            	   585: ; is parallel (all bits at once, active-low). The serial protocol cannot work.
                            	   586: ; READ_JOYPAD in main.asm already reads the Genesis controller, converts to
                            	   587: ; NES button format, and stores at $FF00F0. We just use that directly.
                            	   588: sub_E62D_read_joysticks:  ; orig: sub_E62D_read_joysticks:
02:000015BA 6100EF66        	   589:     BSR     READ_JOYPAD                          ; read Genesis pad → D0 + $FF00F0
02:000015BE 7200            	   590:     MOVEQ   #0,D1                                ; Player 1 (X=0)
02:000015C0 6102            	   591:     BSR.S   sub_E640_read_player_input
02:000015C2 5201            	   592:     ADDQ.B  #1,D1                                ; Player 2 (X=1)
                            	   593: sub_E640_read_player_input:
                            	   594:     ; Get button state: P1 from $FF00F0 (set by READ_JOYPAD), P2 = 0
02:000015C4 4A01            	   595:     TST.B   D1
02:000015C6 6608            	   596:     BNE.S   .joy_p2_zero
02:000015C8 103900FF00F0    	   597:     MOVE.B  ($FF00F0).l,D0                       ; P1: NES-format from READ_JOYPAD
02:000015CE 6002            	   598:     BRA.S   .joy_got_buttons
                            	   599: .joy_p2_zero:
