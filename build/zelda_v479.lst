                            	   415: ; READ_JOYPAD - Read Genesis 3-button controller
                            	   416: ; Returns NES-format button byte in D0:
                            	   417: ;   bit 7=A(NES), 6=B, 5=Select, 4=Start, 3=Up, 2=Down, 1=Left, 0=Right
                            	   418: ;
                            	   419: ; Genesis button mapping to NES:
                            	   420: ;   Genesis START ??' NES START
                            	   421: ;   Genesis A     ??' NES A
                            	   422: ;   Genesis B     ??' NES B
                            	   423: ;   Genesis C     ??' NES A (second button)
                            	   424: ;   D-pad         ??' D-pad (direct)
                            	   425: ; ?.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.?
                            	   426: READ_JOYPAD:
02:00000522 4A3900FFEE91    	   427:     tst.b   (JOYPAD_OVERRIDE_ENABLE).l
02:00000528 6710            	   428:     beq     .read_hardware
02:0000052A 7000            	   429:     moveq   #0,D0
02:0000052C 103900FFEE90    	   430:     move.b  (JOYPAD_OVERRIDE_P1).l,D0
02:00000532 13C000FF00F0    	   431:     move.b  D0,($FF0000+$00F0)
02:00000538 4E75            	   432:     rts
                            	   433: .read_hardware:
                            	   434:     ; Strobe high
02:0000053A 13FC004000A10003	   435:     move.b  #$40,($A10003)
02:00000542 4E71            	   436:     nop
02:00000544 4E71            	   437:     nop
                            	   438:     ; Read high nibble (Start, A, C, B + directions)
02:00000546 123900A10003    	   439:     move.b  ($A10003),D1
                            	   440:     ; Strobe low
02:0000054C 13FC000000A10003	   441:     move.b  #$00,($A10003)
02:00000554 4E71            	   442:     nop
02:00000556 4E71            	   443:     nop
                            	   444:     ; Read low nibble (Start, A, C, B again + mode)
02:00000558 143900A10003    	   445:     move.b  ($A10003),D2
                            	   446: 
                            	   447:     ; Build NES-format byte in D0
02:0000055E 4200            	   448:     clr.b   D0
                            	   449: 
                            	   450:     ; D-pad from D1 bits 0-3 (Up=3, Down=2, Left=1, Right=0)
02:00000560 1601            	   451:     move.b  D1,D3
02:00000562 0203000F        	   452:     andi.b  #$0F,D3                 ; mask direction bits
                            	   453:     ; NES: bit3=Up, bit2=Down, bit1=Left, bit0=Right (active low on Genesis)
02:00000566 0A03000F        	   454:     eori.b  #$0F,D3                 ; invert (Genesis is active low)
02:0000056A 8003            	   455:     or.b    D3,D0
                            	   456: 
                            	   457:     ; Start button: Genesis D1 bit 5
02:0000056C 08010005        	   458:     btst    #5,D1
02:00000570 6604            	   459:     bne     .no_start               ; active low - not pressed if bit set
02:00000572 08C00004        	   460:     bset    #4,D0                   ; NES Start = bit 4
                            	   461: .no_start:
                            	   462: 
                            	   463:     ; A button: Genesis D1 bit 6 ??' NES A = bit 7
02:00000576 08010006        	   464:     btst    #6,D1
02:0000057A 6604            	   465:     bne     .no_a
02:0000057C 08C00007        	   466:     bset    #7,D0
                            	   467: .no_a:
                            	   468: 
                            	   469:     ; B button: Genesis D2 bit 4 ??' NES B = bit 6
02:00000580 08020004        	   470:     btst    #4,D2
02:00000584 6604            	   471:     bne     .no_b
02:00000586 08C00006        	   472:     bset    #6,D0
                            	   473: .no_b:
                            	   474: 
                            	   475:     ; Select: Genesis has no Select - map to C button (D1 bit 4)
02:0000058A 08010004        	   476:     btst    #4,D1
02:0000058E 6604            	   477:     bne     .no_select
02:00000590 08C00005        	   478:     bset    #5,D0
                            	   479: .no_select:
                            	   480: 
                            	   481:     ; Store for NES input routines to read
                            	   482:     ; NES reads controller state from RAM - we mirror it there
02:00000594 13C000FF00F0    	   483:     move.b  D0,($FF0000+$00F0)      ; joypad 1 state in NES RAM mirror
02:0000059A 4E75            	   484:     rts
