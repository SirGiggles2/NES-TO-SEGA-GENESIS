                            	   493: sub_0x01E5F2_jump_to_pointers_after_JSR:  ; orig: sub_0x01E5F2_jump_to_pointers_after_JSR:
                            	   494:     ; bzk rewrite: NES JSR dispatch → 68K BSR dispatch with DC.L jump table
                            	   495:     ; NES: JSR pushed 2-byte return addr; PLA/PLA recovered it; table was .WORD (16-bit)
                            	   496:     ; 68K: BSR pushes 4-byte return addr pointing right at DC.L table entries
                            	   497:     ; D0 = script index (0-based, byte)
02:00001306 33C000FFF084    	   498:     MOVE.W  D0,(TRACE_SCRIPT_RAW).l
02:0000130C 23CF00FFF090    	   499:     MOVE.L  A7,(TRACE_DISP_STACK).l
02:00001312 024000FF        	   500:     ANDI.W  #$00FF,D0
02:00001316 E540            	   501:     ASL.W   #2,D0           ; D0 = index * 4 (DC.L entry = 4 bytes each)
02:00001318 33C000FFF086    	   502:     MOVE.W  D0,(TRACE_DISP_INDEX).l
