02:00001BC2 1000            	   578:     MOVE.B  D0,D0  ; prep for PPU_WRITE_2001  ; was: C - - - - - 0x01E637 07:E627: 8D 01 20  STA $2001
02:00001BC4 6100ECA6        	   579:     BSR     PPU_WRITE_2001
