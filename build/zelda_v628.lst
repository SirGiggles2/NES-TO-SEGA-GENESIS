                            	   237: 
                            	   238: sub_80D7_copy_bat_table_to_bat:  ; orig: sub_80D7_copy_bat_table_to_bat:
                            	   239: 
                            	   240: ; in
                            	   241: 
                            	   242: ; ram_0000_t09_copy_data_from
                            	   243: 
                            	   244: ; ram_0002_t06_copy_data_into
                            	   245: 
                            	   246: ; ram_0004_t08_max_addr_lo
                            	   247: 
                            	   248: ; ram_0005_t01_max_addr_hi
                            	   249: 
                            	   250: ; FIX v590: Rewrite battery table copy.
                            	   251: ; Original NES used indirect pointers (LDA (zp),Y / STA (zp),Y) to copy data
                            	   252: ; from ROM bank 06 addresses ($8000+) into NES RAM ($6000-$7FFF).
                            	   253: ; On Genesis, ROM is at assembled label addresses, not at $FF8000+.
                            	   254: ; This rewrite correctly reads from ROM using tbl_8000_1st_quest as bank 06 base.
                            	   255: 
                            	   256:     ; Build source address from ZP $00/$01 (little-endian NES pointer)
02:000230B8 7A00            	   257:     MOVEQ   #0,D5
02:000230BA 1A3900FF0001    	   258:     MOVE.B  $FF0001,D5               ; high byte of NES source addr
02:000230C0 E14D            	   259:     LSL.W   #8,D5
02:000230C2 1A3900FF0000    	   260:     MOVE.B  $FF0000,D5               ; low byte → D5.W = NES addr (e.g., $8400)
02:000230C8 04458000        	   261:     SUBI.W  #$8000,D5                ; offset within bank 06
02:000230CC 41FAFE54        	   262:     LEA     tbl_8000_1st_quest,A0
02:000230D0 D0C5            	   263:     ADDA.W  D5,A0                    ; A0 = Genesis ROM source
                            	   264: 
                            	   265:     ; Build dest address from ZP $02/$03
02:000230D2 7A00            	   266:     MOVEQ   #0,D5
02:000230D4 1A3900FF0003    	   267:     MOVE.B  $FF0003,D5               ; high byte of NES dest addr
02:000230DA E14D            	   268:     LSL.W   #8,D5
02:000230DC 1A3900FF0002    	   269:     MOVE.B  $FF0002,D5               ; low byte → D5.W = NES addr (e.g., $687E)
02:000230E2 43F900FF0000    	   270:     LEA     $FF0000.l,A1
02:000230E8 D2C5            	   271:     ADDA.W  D5,A1                    ; A1 = Genesis RAM dest
                            	   272: 
                            	   273:     ; Build max address from ZP $04/$05
02:000230EA 7A00            	   274:     MOVEQ   #0,D5
02:000230EC 1A3900FF0005    	   275:     MOVE.B  ram_0005_t01_max_addr_hi,D5
02:000230F2 E14D            	   276:     LSL.W   #8,D5
02:000230F4 1A3900FF0004    	   277:     MOVE.B  ram_0004_t08_max_addr_lo,D5
02:000230FA 47F900FF0000    	   278:     LEA     $FF0000.l,A3
02:00023100 D6C5            	   279:     ADDA.W  D5,A3                    ; A3 = Genesis RAM max address
                            	   280: 
                            	   281: b06_bat_copy_loop:
02:00023102 12D8            	   282:     MOVE.B  (A0)+,(A1)+
02:00023104 B3CB            	   283:     CMPA.L  A3,A1
02:00023106 66FA            	   284:     BNE     b06_bat_copy_loop
                            	   285: 
02:00023108 523900FF0013    	   286:     ADDQ.B  #1,ram_subscript
02:0002310E 4E75            	   287:     RTS
                            	   288: 
                            	   289: 
                            	   290: 
                            	   291: sub_b06_copy_bank_s1_bat_import:
02:00023110 41FA5071        	   292:     LEA     ofs_bat_67F0_bank_s1_asm_import(PC),A0
02:00023114 43F900FF67F0    	   293:     LEA     ($FF67F0).l,A1
02:0002311A 3E3C008D        	   294:     MOVE.W  #$008E-1,D7
