                            	   538: sub_0x01E618_clear_memory:  ; orig: sub_0x01E618_clear_memory:
                            	   539: 
                            	   540: ; in
                            	   541: ; D0.B = hi address page
                            	   542: ; D2.B = highest lo address for first page (Y)
                            	   543: ; Clears NES RAM from (D0<<8)+D2 down to $0300
                            	   544: ; REWRITE: NES STA (zp),Y uses little-endian pointer; 68K MOVEA.W is big-endian.
                            	   545: ; Original MOVEA.W read $00,$05 as $0005 instead of $0500, clearing zero page.
02:00001B62 13C001FE0001    	   546:     MOVE.B  D0,(ram_0000_t06_data+1+$FF0000).l  ; store hi page byte
02:00001B68 13FC000001FE0000	   547:     MOVE.B  #$00,(ram_0000_t06_data+$FF0000).l   ; store lo = 0
02:00001B70 024200FF        	   548:     ANDI.W  #$00FF,D2         ; clean D2.W high byte for indexed addressing
                            	   549: bFF_bra_E60E_loop:  ; orig: bFF_bra_E60E_loop:
                            	   550:     ; Read NES little-endian pointer: lo at +0, hi at +1
02:00001B74 7000            	   551:     MOVEQ   #0,D0
02:00001B76 103901FE0001    	   552:     MOVE.B  (ram_0000_t06_data+1+$FF0000).l,D0   ; hi byte
02:00001B7C E148            	   553:     LSL.W   #8,D0
02:00001B7E 103901FE0000    	   554:     MOVE.B  (ram_0000_t06_data+$FF0000).l,D0     ; lo byte
02:00001B84 43F900FF0000    	   555:     LEA     ($FF0000).l,A1
02:00001B8A D2C0            	   556:     ADDA.W  D0,A1             ; A1 = $FF0000 + (hi<<8|lo)
02:00001B8C 42312000        	   557:     CLR.B   (A1,D2.W)         ; orig: STA (ram_0000_t06_data),Y
02:00001B90 5302            	   558:     SUBQ.B  #1,D2           ; DEY
02:00001B92 0C0200FF        	   559:     CMPI.B  #$FF,D2          ; CPY #$FF
02:00001B96 66DC            	   560:     BNE     bFF_bra_E60E_loop
02:00001B98 533901FE0001    	   561:     SUBQ.B  #1,(ram_0000_t06_data+1+$FF0000).l  ; DEC hi page
02:00001B9E 103901FE0001    	   562:     MOVE.B  (ram_0000_t06_data+1+$FF0000).l,D0  ; LDA hi page
02:00001BA4 0C000003        	   563:     CMPI.B  #$03,D0
02:00001BA8 64CA            	   564:     BCC     bFF_bra_E60E_loop             ; BCS: loop while page >= 3
02:00001BAA 4A3900FF0301    	   565:     TST.B   ram_0301_buffer_index
