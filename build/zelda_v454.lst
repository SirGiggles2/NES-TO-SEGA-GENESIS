02:000003C0 207C00FF0000    	   315:     movea.l #$FF0000,A0
02:000003C6 303C3BFF        	   316:     move.w  #$3BFF,D0               ; 15360 longs = 60KB (stops before VDP shadow regs at $FFEF00)
