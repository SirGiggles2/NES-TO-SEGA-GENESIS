                            	   295: 
                            	   296:     ; ?"??"? Initialize the TMSS (trademark security system) ?"??"?
                            	   297:     ; Required on real hardware or it won't boot
02:00000390 103900A10001    	   298:     move.b  ($A10001),D0            ; read hardware version
02:00000396 0200000F        	   299:     andi.b  #$0F,D0                 ; mask version bits
02:0000039A 670A            	   300:     beq     .skip_tmss              ; version 0 = no TMSS
