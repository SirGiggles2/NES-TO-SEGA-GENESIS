                            	  6889:     ; Fix: advance 16-bit PPU buffer pointer by (Y+1) bytes
                            	  6890:     ; NES was: SEC; TYA; ADC ptr_lo; STA ptr_lo; LDA #0; ADC ptr_hi; STA ptr_hi
02:000246E2 123900FF0000    	  6891:     MOVE.B  ram_0000_t11_ppu_data,D1            ; start from current low byte
02:000246E8 1802            	  6892:     MOVE.B  D2,D4                               ; D4 = Y (bytes consumed this record)
02:000246EA 5204            	  6893:     ADDQ.B  #1,D4                               ; D4 = Y+1 (NES SEC effect)
02:000246EC D204            	  6894:     ADD.B   D4,D1                               ; D1 = lo_ptr + Y + 1, carry = high-byte bump
02:000246EE 13C100FF0000    	  6895:     MOVE.B  D1,ram_0000_t11_ppu_data            ; store new low byte without clobbering carry first
02:000246F4 6406            	  6896:     BCC     b06_bra_b06_ppu_ptr_nocarry             ; no carry into high byte
