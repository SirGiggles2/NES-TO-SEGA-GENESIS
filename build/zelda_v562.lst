                            	   452: ; ?.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.?
                            	   453: ; READ_JOYPAD - Read Genesis 3-button controller
                            	   454: ; Returns NES-format button byte in D0:
                            	   455: ;   bit 7=A(NES), 6=B, 5=Select, 4=Start, 3=Up, 2=Down, 1=Left, 0=Right
                            	   456: ;
                            	   457: ; Genesis button mapping to NES:
                            	   458: ;   Genesis START ??' NES START
                            	   459: ;   Genesis A     ??' NES A
                            	   460: ;   Genesis B     ??' NES B
                            	   461: ;   Genesis C     ??' NES A (second button)
                            	   462: ;   D-pad         ??' D-pad (direct)
                            	   463: ; ?.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.?
                            	   464: READ_JOYPAD:
02:0000058A 4A3900FFEE91    	   465:     tst.b   (JOYPAD_OVERRIDE_ENABLE).l
02:00000590 6710            	   466:     beq     .read_hardware
02:00000592 7000            	   467:     moveq   #0,D0
02:00000594 103900FFEE90    	   468:     move.b  (JOYPAD_OVERRIDE_P1).l,D0
02:0000059A 13C000FF00F0    	   469:     move.b  D0,($FF0000+$00F0)
02:000005A0 4E75            	   470:     rts
                            	   471: .read_hardware:
                            	   472:     ; Strobe high
02:000005A2 13FC004000A10003	   473:     move.b  #$40,($A10003)
02:000005AA 4E71            	   474:     nop
02:000005AC 4E71            	   475:     nop
                            	   476:     ; Read high nibble (Start, A, C, B + directions)
02:000005AE 123900A10003    	   477:     move.b  ($A10003),D1
                            	   478:     ; Strobe low
02:000005B4 13FC000000A10003	   479:     move.b  #$00,($A10003)
02:000005BC 4E71            	   480:     nop
02:000005BE 4E71            	   481:     nop
                            	   482:     ; Read low nibble (Start, A, C, B again + mode)
02:000005C0 143900A10003    	   483:     move.b  ($A10003),D2
                            	   484: 
                            	   485:     ; Build NES-format byte in D0
02:000005C6 4200            	   486:     clr.b   D0
                            	   487: 
                            	   488:     ; D-pad from D1 bits 0-3 (Up=3, Down=2, Left=1, Right=0)
02:000005C8 1601            	   489:     move.b  D1,D3
02:000005CA 0203000F        	   490:     andi.b  #$0F,D3                 ; mask direction bits
                            	   491:     ; NES: bit3=Up, bit2=Down, bit1=Left, bit0=Right (active low on Genesis)
02:000005CE 0A03000F        	   492:     eori.b  #$0F,D3                 ; invert (Genesis is active low)
02:000005D2 8003            	   493:     or.b    D3,D0
                            	   494: 
                            	   495:     ; Start button: Genesis D1 bit 5
02:000005D4 08010005        	   496:     btst    #5,D1
02:000005D8 6604            	   497:     bne     .no_start               ; active low - not pressed if bit set
02:000005DA 08C00004        	   498:     bset    #4,D0                   ; NES Start = bit 4
                            	   499: .no_start:
                            	   500: 
                            	   501:     ; A button: Genesis D1 bit 6 ??' NES A = bit 7
02:000005DE 08010006        	   502:     btst    #6,D1
02:000005E2 6604            	   503:     bne     .no_a
02:000005E4 08C00007        	   504:     bset    #7,D0
                            	   505: .no_a:
                            	   506: 
                            	   507:     ; B button: Genesis D2 bit 4 ??' NES B = bit 6
02:000005E8 08020004        	   508:     btst    #4,D2
02:000005EC 6604            	   509:     bne     .no_b
02:000005EE 08C00006        	   510:     bset    #6,D0
                            	   511: .no_b:
                            	   512: 
                            	   513:     ; Select: Genesis has no Select - map to C button (D1 bit 4)
02:000005F2 08010004        	   514:     btst    #4,D1
02:000005F6 6604            	   515:     bne     .no_select
02:000005F8 08C00005        	   516:     bset    #5,D0
                            	   517: .no_select:
                            	   518: 
                            	   519:     ; Store for NES input routines to read
                            	   520:     ; NES reads controller state from RAM - we mirror it there
02:000005FC 13C000FF00F0    	   521:     move.b  D0,($FF0000+$00F0)      ; joypad 1 state in NES RAM mirror
02:00000602 4E75            	   522:     rts
