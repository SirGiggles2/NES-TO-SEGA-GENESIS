                            	   525: ; EXCEPTION_HANDLER - Catch all unexpected exceptions
                            	   526: ; Stores stack/register state in RAM and flashes red.
                            	   527: ; Generic 68000 exception frames place SR at (SP) and PC at 2(SP).
                            	   528: ; The raw frame bytes are also copied for deeper inspection.
                            	   529: ; ?.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.?
                            	   530: EXCEPTION_HANDLER:
02:00000604 48F97FFF00FFEE40	   531:     movem.l D0-D7/A0-A6,(CRASH_REGS).l
02:0000060C 23CF00FFEE04    	   532:     move.l  A7,(CRASH_SP).l         ; exception frame SP on entry
02:00000612 33FCBEEF00FFEE00	   533:     move.w  #$BEEF,(CRASH_MAGIC).l
02:0000061A 4A7900FFEE02    	   534:     tst.w   (CRASH_VECTOR).l
02:00000620 6608            	   535:     bne     .vector_ready
02:00000622 33FCFFFF00FFEE02	   536:     move.w  #$FFFF,(CRASH_VECTOR).l
                            	   537: .vector_ready:
02:0000062A 33D700FFEE08    	   538:     move.w  (A7),(CRASH_SR).l       ; generic SR
02:00000630 23EF000200FFEE0A	   539:     move.l  2(A7),(CRASH_PC).l      ; generic PC
02:00000638 42B900FFEE80    	   540:     clr.l   (CRASH_AUX).l
02:0000063E 427900FFEE84    	   541:     clr.w   (CRASH_AUX+$04).l
02:00000644 0C79000200FFEE02	   542:     cmpi.w  #$0002,(CRASH_VECTOR).l
02:0000064C 670A            	   543:     beq     .decode_bus_addr
02:0000064E 0C79000300FFEE02	   544:     cmpi.w  #$0003,(CRASH_VECTOR).l
02:00000656 6620            	   545:     bne     .copy_frame_data
                            	   546: .decode_bus_addr:
02:00000658 23EF000200FFEE80	   547:     move.l  2(A7),(CRASH_AUX).l
02:00000660 33EF000600FFEE84	   548:     move.w  6(A7),(CRASH_AUX+$04).l
02:00000668 33EF000800FFEE08	   549:     move.w  8(A7),(CRASH_SR).l
02:00000670 23EF000A00FFEE0A	   550:     move.l  10(A7),(CRASH_PC).l
                            	   551: 
                            	   552: .copy_frame_data:
02:00000678 41F900FFEE10    	   553:     lea     CRASH_FRAME,A0
02:0000067E 224F            	   554:     movea.l A7,A1
02:00000680 7E0F            	   555:     moveq   #15,D7                  ; copy first 16 words (32 bytes) of raw frame
                            	   556: .copy_frame_loop:
02:00000682 30D9            	   557:     move.w  (A1)+,(A0)+
02:00000684 51CFFFFC        	   558:     dbra    D7,.copy_frame_loop
                            	   559: 
                            	   560:     ; Write red to CRAM entry 0 (background color)
02:00000688 23FCC000000000C0	   561:     move.l  #$C0000000,($C00004)    ; CRAM write addr 0
02:00000690 0004
02:00000692 33FC000E00C00000	   562:     move.w  #$000E,($C00000)        ; red in BGR555
                            	   563: .halt:
02:0000069A 60FE            	   564:     bra     .halt                   ; infinite loop - inspect diag/debugger
                            	   565: 
                            	   566: ; ?.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.?
                            	   567: ; CHR_VRAM_LOAD - Copy pre-converted 4bpp tile data into VDP VRAM
                            	   568: ; Called once at startup after VDP_INIT.
                            	   569: ; Loads 512 tiles (16KB) into VRAM $0000-$3FFF:
                            	   570: ;   Tiles   0-255  (VRAM $0000-$1FFF) = PT0 background tiles
                            	   571: ;   Tiles 256-511  (VRAM $2000-$3FFF) = PT1 sprite tiles
                            	   572: ; Source: zelda_tiles_4bpp.bin (generated by chr_convert.py)
                            	   573: ; ?.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.?
                            	   574: CHR_VRAM_LOAD:
                            	   575:     ; Set VRAM write address to $0000 (tile area base)
02:0000069C 23FC4000000000C0	   576:     move.l  #$40000000,($C00004)    ; VRAM write cmd for addr $0000
02:000006A4 0004
                            	   577:     ; Stream 16KB of 4bpp tile data from ROM to VRAM
                            	   578:     ; VDP auto-increment = 2, MOVE.L writes 4 bytes per iteration
02:000006A6 207C0002A57C    	   579:     movea.l #ZELDA_TILES_4BPP,A0
02:000006AC 303C0FFF        	   580:     move.w  #(16384/4)-1,D0        ; 4095 = 4096 iterations
                            	   581: .chr_loop:
02:000006B0 23D800C00000    	   582:     move.l  (A0)+,($C00000)        ; 4 bytes ??' 2 VDP words ??' VRAM +4
02:000006B6 51C8FFF8        	   583:     dbra    D0,.chr_loop
02:000006BA 4E75            	   584:     rts
                            	   585: 
                            	   586: CHR_SHADOW_LOAD:
                            	   587:     ; Keep emulated PPU pattern reads in sync with the startup VRAM upload.
02:000006BC 207C0002E57C    	   588:     movea.l #ZELDA_CHR_2BPP,A0
02:000006C2 227C00FFC000    	   589:     movea.l #$00FFC000,A1
02:000006C8 303C07FF        	   590:     move.w  #(8192/4)-1,D0
                            	   591: .chr_shadow_loop:
02:000006CC 22D8            	   592:     move.l  (A0)+,(A1)+
02:000006CE 51C8FFFC        	   593:     dbra    D0,.chr_shadow_loop
