                            	   519: ; ?.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.?
                            	   520: ; CHR_VRAM_LOAD - Copy pre-converted 4bpp tile data into VDP VRAM
                            	   521: ; Called once at startup after VDP_INIT.
                            	   522: ; Loads 512 tiles (16KB) into VRAM $0000-$3FFF:
                            	   523: ;   Tiles   0-255  (VRAM $0000-$1FFF) = PT0 background tiles
                            	   524: ;   Tiles 256-511  (VRAM $2000-$3FFF) = PT1 sprite tiles
                            	   525: ; Source: zelda_tiles_4bpp.bin (generated by chr_convert.py)
                            	   526: ; ?.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.?
                            	   527: CHR_VRAM_LOAD:
                            	   528:     ; Set VRAM write address to $0000 (tile area base)
02:0000061C 23FC4000000000C0	   529:     move.l  #$40000000,($C00004)    ; VRAM write cmd for addr $0000
02:00000624 0004
                            	   530:     ; Stream 16KB of 4bpp tile data from ROM to VRAM
                            	   531:     ; VDP auto-increment = 2, MOVE.L writes 4 bytes per iteration
02:00000626 207C0001A776    	   532:     movea.l #ZELDA_TILES_4BPP,A0
02:0000062C 303C0FFF        	   533:     move.w  #(16384/4)-1,D0        ; 4095 = 4096 iterations
                            	   534: .chr_loop:
02:00000630 23D800C00000    	   535:     move.l  (A0)+,($C00000)        ; 4 bytes ??' 2 VDP words ??' VRAM +4
02:00000636 51C8FFF8        	   536:     dbra    D0,.chr_loop
02:0000063A 4E75            	   537:     rts
                            	   538: 
                            	   539: CHR_SHADOW_LOAD:
                            	   540:     ; Keep emulated PPU pattern reads in sync with the startup VRAM upload.
02:0000063C 207C0001E776    	   541:     movea.l #ZELDA_CHR_2BPP,A0
02:00000642 227C00FFC000    	   542:     movea.l #$00FFC000,A1
02:00000648 303C07FF        	   543:     move.w  #(8192/4)-1,D0
                            	   544: .chr_shadow_loop:
02:0000064C 22D8            	   545:     move.l  (A0)+,(A1)+
02:0000064E 51C8FFFC        	   546:     dbra    D0,.chr_shadow_loop
02:00000652 4E75            	   547:     rts
