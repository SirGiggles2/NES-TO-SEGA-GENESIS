                            	   505: .copy_frame_data:
02:000005F8 41F900FFEE10    	   506:     lea     CRASH_FRAME,A0
02:000005FE 224F            	   507:     movea.l A7,A1
02:00000600 7E0F            	   508:     moveq   #15,D7                  ; copy first 16 words (32 bytes) of raw frame
                            	   509: .copy_frame_loop:
02:00000602 30D9            	   510:     move.w  (A1)+,(A0)+
02:00000604 51CFFFFC        	   511:     dbra    D7,.copy_frame_loop
                            	   512: 
                            	   513:     ; Write red to CRAM entry 0 (background color)
02:00000608 23FCC000000000C0	   514:     move.l  #$C0000000,($C00004)    ; CRAM write addr 0
02:00000610 0004
02:00000612 33FC000E00C00000	   515:     move.w  #$000E,($C00000)        ; red in BGR555
                            	   516: .halt:
02:0000061A 60FE            	   517:     bra     .halt                   ; infinite loop - inspect diag/debugger
