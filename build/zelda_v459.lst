02:0001EDEC 5204            	  6893:     ADDQ.B  #1,D4                               ; D4 = Y+1 (NES SEC effect)
02:0001EDEE D204            	  6894:     ADD.B   D4,D1                               ; D1 = lo_ptr + Y + 1, carry = high-byte bump
02:0001EDF0 13C100FF0000    	  6895:     MOVE.B  D1,ram_0000_t11_ppu_data            ; store new low byte without clobbering carry first
