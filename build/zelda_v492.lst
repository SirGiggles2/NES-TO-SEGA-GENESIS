                            	   494: sub_0x01E5F2_jump_to_pointers_after_JSR:  ; orig: sub_0x01E5F2_jump_to_pointers_after_JSR:
                            	   495:     ; bzk rewrite: NES JSR dispatch → 68K BSR dispatch with DC.L jump table
                            	   496:     ; NES: JSR pushed 2-byte return addr; PLA/PLA recovered it; table was .WORD (16-bit)
                            	   497:     ; 68K: BSR pushes 4-byte return addr pointing right at DC.L table entries
                            	   498:     ; D0 = script index (0-based, byte)
02:00001602 33C000FFF084    	   499:     MOVE.W  D0,(TRACE_SCRIPT_RAW).l
02:00001608 23CF00FFF090    	   500:     MOVE.L  A7,(TRACE_DISP_STACK).l
02:0000160E 024000FF        	   501:     ANDI.W  #$00FF,D0
02:00001612 E540            	   502:     ASL.W   #2,D0           ; D0 = index * 4 (DC.L entry = 4 bytes each)
02:00001614 33C000FFF086    	   503:     MOVE.W  D0,(TRACE_DISP_INDEX).l
