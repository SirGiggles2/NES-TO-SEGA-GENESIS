02:00024CE4 5204            	  6895:     ADDQ.B  #1,D4                               ; D4 = Y+1 (NES SEC effect)
02:00024CE6 D204            	  6896:     ADD.B   D4,D1                               ; D1 = lo_ptr + Y + 1, carry = high-byte bump
02:00024CE8 13C100FF0000    	  6897:     MOVE.B  D1,ram_0000_t11_ppu_data            ; store new low byte without clobbering carry first
