                            	    61: NES_BACKDROP_TILE_VRAM  EQU $8000
                            	    62: ; FIX v490: Sprite tile copies live at VRAM $4000-$7FFF (tiles 512-1023)
                            	    63: ; These copies have pixel values shifted +4 so sprites use palette colors 4-7
                            	    64: SPRITE_TILE_VRAM_BASE   EQU $4000
                            	    65: SPRITE_TILE_INDEX_OFS   EQU $0200
