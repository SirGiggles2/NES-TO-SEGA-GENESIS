                            	   588: 
                            	   589: 
                            	   590: ; BRIDGE: NES serial controller read replaced with Genesis parallel read.
                            	   591: ; NES reads $4016 serially (1 bit per read, active-high). Genesis data port
                            	   592: ; is parallel (all bits at once, active-low). The serial protocol cannot work.
                            	   593: ; READ_JOYPAD in main.asm already reads the Genesis controller, converts to
                            	   594: ; NES button format, and stores at $FF00F0. We just use that directly.
                            	   595: sub_E62D_read_joysticks:  ; orig: sub_E62D_read_joysticks:
02:00001BD0 6100E9B8        	   596:     BSR     READ_JOYPAD                          ; read Genesis pad → D0 + $FF00F0
02:00001BD4 7200            	   597:     MOVEQ   #0,D1                                ; Player 1 (X=0)
02:00001BD6 6102            	   598:     BSR.S   sub_E640_read_player_input
02:00001BD8 5201            	   599:     ADDQ.B  #1,D1                                ; Player 2 (X=1)
                            	   600: sub_E640_read_player_input:
                            	   601:     ; Get button state: P1 from $FF00F0 (set by READ_JOYPAD), P2 = 0
02:00001BDA 4A01            	   602:     TST.B   D1
02:00001BDC 6608            	   603:     BNE.S   .joy_p2_zero
02:00001BDE 103900FF00F0    	   604:     MOVE.B  ($FF00F0).l,D0                       ; P1: NES-format from READ_JOYPAD
02:00001BE4 6002            	   605:     BRA.S   .joy_got_buttons
                            	   606: .joy_p2_zero:
02:00001BE6 7000            	   607:     MOVEQ   #0,D0                                ; P2: no controller
                            	   608: .joy_got_buttons:
                            	   609:     ; Press detection: press = (new XOR old) AND new
02:00001BE8 1600            	   610:     MOVE.B  D0,D3                                ; D3 = full button state (hold)
                            	   611:     ; Load previous hold into D2 (avoid indexed EOR that fix_syntax mangles)
02:00001BEA 207C00FF00FA    	   612:     MOVEA.L #ram_btn_hold,A0
02:00001BF0 14301800        	   613:     MOVE.B  (A0,D1.L),D2                         ; D2 = previous hold
