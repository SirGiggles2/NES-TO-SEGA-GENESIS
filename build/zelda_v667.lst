                            	   499: sub_0x01E5F2_jump_to_pointers_after_JSR:  ; orig: sub_0x01E5F2_jump_to_pointers_after_JSR:
                            	   500:     ; bzk rewrite: NES JSR dispatch → 68K BSR dispatch with DC.L jump table
                            	   501:     ; NES: JSR pushed 2-byte return addr; PLA/PLA recovered it; table was .WORD (16-bit)
                            	   502:     ; 68K: BSR pushes 4-byte return addr pointing right at DC.L table entries
                            	   503:     ; D0 = script index (0-based, byte)
02:00001AFE 33C000FFF084    	   504:     MOVE.W  D0,(TRACE_SCRIPT_RAW).l
02:00001B04 23CF00FFF090    	   505:     MOVE.L  A7,(TRACE_DISP_STACK).l
02:00001B0A 024000FF        	   506:     ANDI.W  #$00FF,D0
02:00001B0E E540            	   507:     ASL.W   #2,D0           ; D0 = index * 4 (DC.L entry = 4 bytes each)
02:00001B10 33C000FFF086    	   508:     MOVE.W  D0,(TRACE_DISP_INDEX).l
02:00001B16 225F            	   509:     MOVEA.L (A7)+,A1        ; pop BSR's 4-byte return address → A1 = DC.L table base
02:00001B18 20710000        	   510:     MOVEA.L (A1,D0.W),A0   ; read 32-bit target address from table[index]
02:00001B1C 23C900FFF088    	   511:     MOVE.L  A1,(TRACE_DISP_BASE).l
02:00001B22 23C800FFF08C    	   512:     MOVE.L  A0,(TRACE_DISP_TARGET).l
02:00001B28 3F00            	   513:     MOVE.W  D0,-(A7)
02:00001B2A 303C0317        	   514:     MOVE.W  #$0317,D0
02:00001B2E 6100E91E        	   515:     BSR     TRACE_MARK
02:00001B32 303C0318        	   516:     MOVE.W  #$0318,D0
02:00001B36 6100E916        	   517:     BSR     TRACE_MARK
02:00001B3A 301F            	   518:     MOVE.W  (A7)+,D0
02:00001B3C 4ED0            	   519:     JMP     (A0)            ; jump to target (does not return through BSR)
