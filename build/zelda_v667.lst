02:0000EB1C 103900FF0438    	  2449:     MOVE.B  ($00FF0438).l,D0  ; orig: C - - J - - 0x009B89 02:9B79: AD 38 04  LDA ram_0437_enemy +
02:0000EB22 66000096        	  2450:     BNE     b02_bra_9BD0             ; BNE  ; orig: C - - - - - 0x009B8C 02:9B7C: D0 52     BNE b02_bra_9BD0
                            	  2451:     ; FIX v487: Direct ROM table access for palette fade data
                            	  2452:     ; Original code had two bugs:
                            	  2453:     ;   1. NES ADC translated as ADD.B by Fix G (drops carry, wrong pointer for steps >= 5)
                            	  2454:     ;   2. MOVEA.W sign-extends ROM pointers >= $8000 (reads from $FE9969 instead of ROM $9969)
                            	  2455:     ; Fix: compute table offset directly and read from correct ROM address
02:0000EB26 7A00            	  2456:     MOVEQ   #0,D5
02:0000EB28 1A3900FF0437    	  2457:     MOVE.B  ram_0437_link,D5             ; D5 = fade step (0-13)
02:0000EB2E EB4D            	  2458:     LSL.W   #5,D5                        ; D5 = step * 32 (each fade entry is 32 bytes)
02:0000EB30 227C0000E90C    	  2459:     MOVEA.L #tbl_9969_logo_blackout_palette,A1
02:0000EB36 D2C5            	  2460:     ADDA.W  D5,A1                        ; A1 = &tbl_9969[step * 32]
02:0000EB38 103C003F        	  2461:     MOVE.B  #$3F,D0
02:0000EB3C 13C000FF0302    	  2462:     MOVE.B  D0,ram_0302_ppu_buffer       ; PPU addr high = $3F
02:0000EB42 103C0000        	  2463:     MOVE.B  #$00,D0
02:0000EB46 13C000FF0303    	  2464:     MOVE.B  D0,ram_0302_ppu_buffer+1     ; PPU addr low = $00 → write to $3F00 (palette)
02:0000EB4C 103C0020        	  2465:     MOVE.B  #$20,D0
02:0000EB50 13C000FF0304    	  2466:     MOVE.B  D0,ram_0302_ppu_buffer+2     ; control: 32 bytes, literal, increment by 1
02:0000EB56 143C001F        	  2467:     MOVE.B  #$1F,D2                      ; loop counter: 31 down to 0
02:0000EB5A 103C00FF        	  2468:     MOVE.B  #$FF,D0
02:0000EB5E 41F900FF0306    	  2469:     LEA     (ram_0302_ppu_buffer+4).l,A0
02:0000EB64 11802000        	  2470:     MOVE.B  D0,(A0,D2.W)                ; set $FF terminator at buffer end
                            	  2471:     ; FIX v487: Set buffer index to non-zero so VDP_VBLANK_HANDLER doesn't
                            	  2472:     ; clear the buffer before the NMI handler can process it
02:0000EB68 13FC000100FF0301	  2473:     MOVE.B  #$01,ram_0301_buffer_index
                            	  2474: b02_bra_9BAE_loop:
02:0000EB70 10312000        	  2475:     MOVE.B  (A1,D2.W),D0                ; FIX v487: read palette from ROM directly
02:0000EB74 41F900FF0305    	  2476:     LEA     (ram_0302_ppu_buffer+3).l,A0
02:0000EB7A 11802000        	  2477:     MOVE.B  D0,(A0,D2.W)  ; orig: C - - - - - 0x009BC0 02:9BB0: 99 05 03  STA ram_0302_ppu_buf
02:0000EB7E 5302            	  2478:     SUBQ.B  #1,D2           ; DEY  ; orig: C - - - - - 0x009BC3 02:9BB3: 88        DEY
02:0000EB80 6AEE            	  2479:     BPL     b02_bra_9BAE_loop             ; BPL  ; orig: C - - - - - 0x009BC4 02:9BB4: 10 F8     BPL b02_bra_9BAE_loop
02:0000EB82 523900FF0437    	  2480:     ADDQ.B  #1,ram_0437_link  ; orig: C - - - - - 0x009BC6 02:9BB6: EE 37 04  INC ram_0437_link
