                            	   299: 
                            	   300: ; in
                            	   301: 
                            	   302: ; A0 = Genesis ROM source pointer resolved from the actual 68k labels
                            	   303: 
                            	   304: ; ram_0002_t06_copy_data_into
                            	   305: 
                            	   306: ; ram_0004_t08_max_addr_lo
                            	   307: 
                            	   308: ; ram_0005_t01_max_addr_hi
                            	   309: 
                            	   310: ; FIX v638: bank 06 data is no longer safe to address via NES $8000-based
                            	   311: ; offsets because translated alignment padding shifts the assembled labels.
                            	   312: ; The call sites resolve the real source label before entering this routine.
                            	   313: 
                            	   314:     ; Build dest address from ZP $02/$03
02:000231CA 7A00            	   315:     MOVEQ   #0,D5
02:000231CC 1A3900FF0003    	   316:     MOVE.B  $FF0003,D5               ; high byte of NES dest addr
02:000231D2 E14D            	   317:     LSL.W   #8,D5
02:000231D4 1A3900FF0002    	   318:     MOVE.B  $FF0002,D5               ; low byte → D5.W = NES addr (e.g., $687E)
02:000231DA 43F900FF0000    	   319:     LEA     $FF0000.l,A1
02:000231E0 D2C5            	   320:     ADDA.W  D5,A1                    ; A1 = Genesis RAM dest
                            	   321: 
                            	   322:     ; Build max address from ZP $04/$05
02:000231E2 7A00            	   323:     MOVEQ   #0,D5
02:000231E4 1A3900FF0005    	   324:     MOVE.B  ram_0005_t01_max_addr_hi,D5
02:000231EA E14D            	   325:     LSL.W   #8,D5
02:000231EC 1A3900FF0004    	   326:     MOVE.B  ram_0004_t08_max_addr_lo,D5
02:000231F2 47F900FF0000    	   327:     LEA     $FF0000.l,A3
02:000231F8 D6C5            	   328:     ADDA.W  D5,A3                    ; A3 = Genesis RAM max address
