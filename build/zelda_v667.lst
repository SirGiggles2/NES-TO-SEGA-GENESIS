                            	   452: ; ?.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.?
                            	   453: ; READ_JOYPAD - Read Genesis 3-button controller
                            	   454: ; Returns NES-format button byte in D0:
                            	   455: ;   bit 7=A(NES), 6=B, 5=Select, 4=Start, 3=Up, 2=Down, 1=Left, 0=Right
                            	   456: ;
                            	   457: ; Genesis 3-button pad hardware (active low):
                            	   458: ;   TH=1 (strobe high) reads into D1:
                            	   459: ;     bit 5 = C,  bit 4 = B,  bits 3-0 = Up/Down/Left/Right
                            	   460: ;   TH=0 (strobe low) reads into D2:
                            	   461: ;     bit 5 = Start,  bit 4 = A,  bits 3-2 = 0/0, bits 1-0 = Up/Down
                            	   462: ;
                            	   463: ; Mapping:
                            	   464: ;   Genesis A     -> NES A      (bit 7)
                            	   465: ;   Genesis B     -> NES B      (bit 6)
                            	   466: ;   Genesis C     -> NES Select (bit 5)
                            	   467: ;   Genesis Start -> NES Start  (bit 4)
                            	   468: ;   D-pad         -> D-pad      (direct)
                            	   469: ; ?.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.?
                            	   470: READ_JOYPAD:
02:0000058A 4A3900FFEE91    	   471:     tst.b   (JOYPAD_OVERRIDE_ENABLE).l
02:00000590 6710            	   472:     beq     .read_hardware
02:00000592 7000            	   473:     moveq   #0,D0
02:00000594 103900FFEE90    	   474:     move.b  (JOYPAD_OVERRIDE_P1).l,D0
02:0000059A 13C000FF00F0    	   475:     move.b  D0,($FF0000+$00F0)
02:000005A0 4E75            	   476:     rts
                            	   477: .read_hardware:
                            	   478:     ; Strobe high
02:000005A2 13FC004000A10003	   479:     move.b  #$40,($A10003)
02:000005AA 4E71            	   480:     nop
02:000005AC 4E71            	   481:     nop
                            	   482:     ; Read high nibble (Start, A, C, B + directions)
02:000005AE 123900A10003    	   483:     move.b  ($A10003),D1
                            	   484:     ; Strobe low
02:000005B4 13FC000000A10003	   485:     move.b  #$00,($A10003)
02:000005BC 4E71            	   486:     nop
02:000005BE 4E71            	   487:     nop
                            	   488:     ; Read low nibble (Start, A, C, B again + mode)
02:000005C0 143900A10003    	   489:     move.b  ($A10003),D2
                            	   490: 
                            	   491:     ; Build NES-format byte in D0
02:000005C6 4200            	   492:     clr.b   D0
                            	   493: 
                            	   494:     ; D-pad from D1 bits 0-3 (bit0=Up, bit1=Down, bit2=Left, bit3=Right)
02:000005C8 1601            	   495:     move.b  D1,D3
02:000005CA 0203000F        	   496:     andi.b  #$0F,D3                 ; mask direction bits
02:000005CE 0A03000F        	   497:     eori.b  #$0F,D3                 ; invert (Genesis is active low)
                            	   498: 
                            	   499:     ; Remap Genesis nibble U/D/L/R -> NES nibble R/L/D/U.
02:000005D2 08030000        	   500:     btst    #0,D3
02:000005D6 6704            	   501:     beq     .no_up
02:000005D8 08C00003        	   502:     bset    #3,D0
                            	   503: .no_up:
02:000005DC 08030001        	   504:     btst    #1,D3
02:000005E0 6704            	   505:     beq     .no_down
02:000005E2 08C00002        	   506:     bset    #2,D0
                            	   507: .no_down:
02:000005E6 08030002        	   508:     btst    #2,D3
02:000005EA 6704            	   509:     beq     .no_left
02:000005EC 08C00001        	   510:     bset    #1,D0
                            	   511: .no_left:
02:000005F0 08030003        	   512:     btst    #3,D3
02:000005F4 6704            	   513:     beq     .no_right
02:000005F6 08C00000        	   514:     bset    #0,D0
                            	   515: .no_right:
                            	   516: 
                            	   517:     ; Start button: Genesis D2 bit 5 (TH=0 read)
02:000005FA 08020005        	   518:     btst    #5,D2
02:000005FE 6604            	   519:     bne     .no_start               ; active low - not pressed if bit set
02:00000600 08C00004        	   520:     bset    #4,D0                   ; NES Start = bit 4
                            	   521: .no_start:
                            	   522: 
                            	   523:     ; A button: Genesis D2 bit 4 (TH=0 read) -> NES A = bit 7
02:00000604 08020004        	   524:     btst    #4,D2
02:00000608 6604            	   525:     bne     .no_a
02:0000060A 08C00007        	   526:     bset    #7,D0
                            	   527: .no_a:
                            	   528: 
                            	   529:     ; B button: Genesis D1 bit 4 (TH=1 read) -> NES B = bit 6
02:0000060E 08010004        	   530:     btst    #4,D1
02:00000612 6604            	   531:     bne     .no_b
02:00000614 08C00006        	   532:     bset    #6,D0
                            	   533: .no_b:
                            	   534: 
                            	   535:     ; C button: Genesis D1 bit 5 (TH=1 read) -> NES Select = bit 5
02:00000618 08010005        	   536:     btst    #5,D1
02:0000061C 6604            	   537:     bne     .no_select
02:0000061E 08C00005        	   538:     bset    #5,D0
                            	   539: .no_select:
                            	   540: 
                            	   541:     ; Store for NES input routines to read
                            	   542:     ; NES reads controller state from RAM - we mirror it there
02:00000622 13C000FF00F0    	   543:     move.b  D0,($FF0000+$00F0)      ; joypad 1 state in NES RAM mirror
02:00000628 4E75            	   544:     rts
                            	   545: 
                            	   546: ; ?.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.?
                            	   547: ; EXCEPTION_HANDLER - Catch all unexpected exceptions
                            	   548: ; Stores stack/register state in RAM and flashes red.
                            	   549: ; Generic 68000 exception frames place SR at (SP) and PC at 2(SP).
                            	   550: ; The raw frame bytes are also copied for deeper inspection.
                            	   551: ; ?.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.?
                            	   552: EXCEPTION_HANDLER:
02:0000062A 48F97FFF00FFEE40	   553:     movem.l D0-D7/A0-A6,(CRASH_REGS).l
02:00000632 23CF00FFEE04    	   554:     move.l  A7,(CRASH_SP).l         ; exception frame SP on entry
02:00000638 33FCBEEF00FFEE00	   555:     move.w  #$BEEF,(CRASH_MAGIC).l
02:00000640 4A7900FFEE02    	   556:     tst.w   (CRASH_VECTOR).l
02:00000646 6608            	   557:     bne     .vector_ready
02:00000648 33FCFFFF00FFEE02	   558:     move.w  #$FFFF,(CRASH_VECTOR).l
                            	   559: .vector_ready:
02:00000650 33D700FFEE08    	   560:     move.w  (A7),(CRASH_SR).l       ; generic SR
02:00000656 23EF000200FFEE0A	   561:     move.l  2(A7),(CRASH_PC).l      ; generic PC
02:0000065E 42B900FFEE80    	   562:     clr.l   (CRASH_AUX).l
02:00000664 427900FFEE84    	   563:     clr.w   (CRASH_AUX+$04).l
02:0000066A 0C79000200FFEE02	   564:     cmpi.w  #$0002,(CRASH_VECTOR).l
02:00000672 670A            	   565:     beq     .decode_bus_addr
02:00000674 0C79000300FFEE02	   566:     cmpi.w  #$0003,(CRASH_VECTOR).l
02:0000067C 6620            	   567:     bne     .copy_frame_data
                            	   568: .decode_bus_addr:
02:0000067E 23EF000200FFEE80	   569:     move.l  2(A7),(CRASH_AUX).l
02:00000686 33EF000600FFEE84	   570:     move.w  6(A7),(CRASH_AUX+$04).l
02:0000068E 33EF000800FFEE08	   571:     move.w  8(A7),(CRASH_SR).l
02:00000696 23EF000A00FFEE0A	   572:     move.l  10(A7),(CRASH_PC).l
                            	   573: 
                            	   574: .copy_frame_data:
02:0000069E 41F900FFEE10    	   575:     lea     CRASH_FRAME,A0
02:000006A4 224F            	   576:     movea.l A7,A1
02:000006A6 7E0F            	   577:     moveq   #15,D7                  ; copy first 16 words (32 bytes) of raw frame
                            	   578: .copy_frame_loop:
02:000006A8 30D9            	   579:     move.w  (A1)+,(A0)+
02:000006AA 51CFFFFC        	   580:     dbra    D7,.copy_frame_loop
                            	   581: 
                            	   582:     ; Write red to CRAM entry 0 (background color)
02:000006AE 23FCC000000000C0	   583:     move.l  #$C0000000,($C00004)    ; CRAM write addr 0
02:000006B6 0004
02:000006B8 33FC000E00C00000	   584:     move.w  #$000E,($C00000)        ; red in BGR555
                            	   585: .halt:
02:000006C0 60FE            	   586:     bra     .halt                   ; infinite loop - inspect diag/debugger
                            	   587: 
                            	   588: ; ?.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.?
                            	   589: ; CHR_VRAM_LOAD - Copy pre-converted 4bpp tile data into VDP VRAM
                            	   590: ; Called once at startup after VDP_INIT.
                            	   591: ; Loads 512 tiles (16KB) into VRAM $0000-$3FFF:
                            	   592: ;   Tiles   0-255  (VRAM $0000-$1FFF) = PT0 background tiles
                            	   593: ;   Tiles 256-511  (VRAM $2000-$3FFF) = PT1 sprite tiles
                            	   594: ; Source: zelda_tiles_4bpp.bin (generated by chr_convert.py)
                            	   595: ; ?.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.?
                            	   596: CHR_VRAM_LOAD:
                            	   597:     ; Set VRAM write address to $0000 (tile area base)
02:000006C2 23FC4000000000C0	   598:     move.l  #$40000000,($C00004)    ; VRAM write cmd for addr $0000
02:000006CA 0004
                            	   599:     ; Stream 16KB of 4bpp tile data from ROM to VRAM
                            	   600:     ; VDP auto-increment = 2, MOVE.L writes 4 bytes per iteration
02:000006CC 207C0002A9A4    	   601:     movea.l #ZELDA_TILES_4BPP,A0
02:000006D2 303C0FFF        	   602:     move.w  #(16384/4)-1,D0        ; 4095 = 4096 iterations
                            	   603: .chr_loop:
02:000006D6 23D800C00000    	   604:     move.l  (A0)+,($C00000)        ; 4 bytes ??' 2 VDP words ??' VRAM +4
02:000006DC 51C8FFF8        	   605:     dbra    D0,.chr_loop
02:000006E0 4E75            	   606:     rts
