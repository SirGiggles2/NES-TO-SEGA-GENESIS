                            	  6934: b06_bra_A0EA_not_palette:  ; orig: b06_bra_A0EA_not_palette:
                            	  6935:     ; Fix: advance 16-bit PPU buffer pointer by (Y+1) bytes
                            	  6936:     ; NES was: SEC; TYA; ADC ptr_lo; STA ptr_lo; LDA #0; ADC ptr_hi; STA ptr_hi
02:000253B2 123900FF0000    	  6937:     MOVE.B  ram_0000_t11_ppu_data,D1            ; start from current low byte
02:000253B8 1802            	  6938:     MOVE.B  D2,D4                               ; D4 = Y (bytes consumed this record)
02:000253BA 5204            	  6939:     ADDQ.B  #1,D4                               ; D4 = Y+1 (NES SEC effect)
02:000253BC D204            	  6940:     ADD.B   D4,D1                               ; D1 = lo_ptr + Y + 1, carry = high-byte bump
02:000253BE 13C100FF0000    	  6941:     MOVE.B  D1,ram_0000_t11_ppu_data            ; store new low byte without clobbering carry first
02:000253C4 6406            	  6942:     BCC     b06_bra_b06_ppu_ptr_nocarry             ; no carry into high byte
02:000253C6 523900FF0001    	  6943:     ADDQ.B  #1,ram_0000_t11_ppu_data+1         ; carry into high byte
                            	  6944: b06_bra_b06_ppu_ptr_nocarry:
                            	  6945:     ; Guard odd-byte buffers followed by EVEN padding. If we land on a 00
                            	  6946:     ; immediately after an FF terminator, rewind one byte so the next outer
                            	  6947:     ; read stops on the real terminator instead of drifting into the next blob.
02:000253CC 7A00            	  6948:     MOVEQ   #$00,D5
02:000253CE 1A3900FF0001    	  6949:     MOVE.B  ram_0000_t11_ppu_data+1,D5
02:000253D4 E14D            	  6950:     LSL.W   #8,D5
02:000253D6 1A3900FF0000    	  6951:     MOVE.B  ram_0000_t11_ppu_data,D5
02:000253DC 3045            	  6952:     MOVEA.W D5,A0
02:000253DE D1FC00FF0000    	  6953:     ADDA.L  #$FF0000,A0
02:000253E4 4A10            	  6954:     TST.B   (A0)
02:000253E6 6616            	  6955:     BNE     b06_bra_b06_ppu_ptr_trace
02:000253E8 0C2800FFFFFF    	  6956:     CMPI.B  #$FF,-1(A0)
02:000253EE 660E            	  6957:     BNE     b06_bra_b06_ppu_ptr_trace
02:000253F0 533900FF0000    	  6958:     SUBQ.B  #1,ram_0000_t11_ppu_data
02:000253F6 6406            	  6959:     BCC     b06_bra_b06_ppu_ptr_trace
02:000253F8 533900FF0001    	  6960:     SUBQ.B  #1,ram_0000_t11_ppu_data+1
