                            	   543: sub_0x01E618_clear_memory:  ; orig: sub_0x01E618_clear_memory:
                            	   544: 
                            	   545: ; in
                            	   546: ; D0.B = hi address page
                            	   547: ; D2.B = highest lo address for first page (Y)
                            	   548: ; Clears NES RAM from (D0<<8)+D2 down to $0300
                            	   549: ; REWRITE: NES STA (zp),Y uses little-endian pointer; 68K MOVEA.W is big-endian.
                            	   550: ; Original MOVEA.W read $00,$05 as $0005 instead of $0500, clearing zero page.
02:00001B62 13C001FE0001    	   551:     MOVE.B  D0,(ram_0000_t06_data+1+$FF0000).l  ; store hi page byte
02:00001B68 13FC000001FE0000	   552:     MOVE.B  #$00,(ram_0000_t06_data+$FF0000).l   ; store lo = 0
02:00001B70 024200FF        	   553:     ANDI.W  #$00FF,D2         ; clean D2.W high byte for indexed addressing
                            	   554: bFF_bra_E60E_loop:  ; orig: bFF_bra_E60E_loop:
                            	   555:     ; Read NES little-endian pointer: lo at +0, hi at +1
02:00001B74 7000            	   556:     MOVEQ   #0,D0
02:00001B76 103901FE0001    	   557:     MOVE.B  (ram_0000_t06_data+1+$FF0000).l,D0   ; hi byte
02:00001B7C E148            	   558:     LSL.W   #8,D0
02:00001B7E 103901FE0000    	   559:     MOVE.B  (ram_0000_t06_data+$FF0000).l,D0     ; lo byte
02:00001B84 43F900FF0000    	   560:     LEA     ($FF0000).l,A1
02:00001B8A D2C0            	   561:     ADDA.W  D0,A1             ; A1 = $FF0000 + (hi<<8|lo)
02:00001B8C 42312000        	   562:     CLR.B   (A1,D2.W)         ; orig: STA (ram_0000_t06_data),Y
02:00001B90 5302            	   563:     SUBQ.B  #1,D2           ; DEY
02:00001B92 0C0200FF        	   564:     CMPI.B  #$FF,D2          ; CPY #$FF
02:00001B96 66DC            	   565:     BNE     bFF_bra_E60E_loop
02:00001B98 533901FE0001    	   566:     SUBQ.B  #1,(ram_0000_t06_data+1+$FF0000).l  ; DEC hi page
02:00001B9E 103901FE0001    	   567:     MOVE.B  (ram_0000_t06_data+1+$FF0000).l,D0  ; LDA hi page
02:00001BA4 0C000003        	   568:     CMPI.B  #$03,D0
02:00001BA8 64CA            	   569:     BCC     bFF_bra_E60E_loop             ; BCS: loop while page >= 3
