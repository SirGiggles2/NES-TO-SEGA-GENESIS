                            	   293: GENESIS_RESET:
                            	   294:     ; Disable interrupts immediately
02:0000038C 46FC2700        	   295:     move    #$2700,SR
                            	   296: 
                            	   297:     ; ?"??"? Initialize the TMSS (trademark security system) ?"??"?
                            	   298:     ; Required on real hardware or it won't boot
02:00000390 103900A10001    	   299:     move.b  ($A10001),D0            ; read hardware version
02:00000396 0200000F        	   300:     andi.b  #$0F,D0                 ; mask version bits
02:0000039A 670A            	   301:     beq     .skip_tmss              ; version 0 = no TMSS
