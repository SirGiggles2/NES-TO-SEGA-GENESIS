                            	    29: ; NES CRT overscan offset: NES=240 lines, Genesis=224 lines
                            	    30: ; CRT TVs clip ~8px top + ~8px bottom, so intended visible = rows 8-231
                            	    31: ; Offset Genesis vscroll by 8 to center the NES content
                            	    32: NES_VSCROLL_OFFSET EQU 8
