                            	    22: 
                            	    23: 
                            	    24: ; that's because of MMC1 stuff, read here about this
                            	    25: 
                            	    26: ; https://wiki.nesdev.com/w/index.php/MMC1#Control_.28internal.2C_.248000-.249FFF.29
