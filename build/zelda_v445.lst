                            	   559: ; ResetHandler_NES - Entry point into translated Zelda code
                            	   560: ; This bridges the Genesis init to the NES reset handler
                            	   561: ; The actual NES reset handler is in bank_FF_gen68k_vdp.asm
                            	   562: ; ?.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.?
                            	   563: ResetHandler_NES:
                            	   564:     ; NES reset is in bank_FF (the fixed bank)
                            	   565:     ; After our Genesis init above, skip the NES hardware init
                            	   566:     ; (SEI, CLD, stack setup) since we've done it Genesis-style
                            	   567:     ; Jump straight to the game init proper
02:0000066C 4EF8489C        	   568:     JMP     MainInit                ; defined in bank_FF_gen68k_vdp.asm
