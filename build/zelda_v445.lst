02:00000618 7E0F            	   517:     moveq   #15,D7                  ; copy first 16 words (32 bytes) of raw frame
                            	   518: .copy_frame_loop:
02:0000061A 30D9            	   519:     move.w  (A1)+,(A0)+
02:0000061C 51CFFFFC        	   520:     dbra    D7,.copy_frame_loop
