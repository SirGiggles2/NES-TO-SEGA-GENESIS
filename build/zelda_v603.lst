                            	   583: 
                            	   584: 
                            	   585: ; BRIDGE: NES serial controller read replaced with Genesis parallel read.
                            	   586: ; NES reads $4016 serially (1 bit per read, active-high). Genesis data port
                            	   587: ; is parallel (all bits at once, active-low). The serial protocol cannot work.
                            	   588: ; READ_JOYPAD in main.asm already reads the Genesis controller, converts to
                            	   589: ; NES button format, and stores at $FF00F0. We just use that directly.
                            	   590: sub_E62D_read_joysticks:  ; orig: sub_E62D_read_joysticks:
02:00001BA6 6100E9E2        	   591:     BSR     READ_JOYPAD                          ; read Genesis pad → D0 + $FF00F0
02:00001BAA 7200            	   592:     MOVEQ   #0,D1                                ; Player 1 (X=0)
02:00001BAC 6102            	   593:     BSR.S   sub_E640_read_player_input
02:00001BAE 5201            	   594:     ADDQ.B  #1,D1                                ; Player 2 (X=1)
                            	   595: sub_E640_read_player_input:
                            	   596:     ; Get button state: P1 from $FF00F0 (set by READ_JOYPAD), P2 = 0
02:00001BB0 4A01            	   597:     TST.B   D1
02:00001BB2 6608            	   598:     BNE.S   .joy_p2_zero
02:00001BB4 103900FF00F0    	   599:     MOVE.B  ($FF00F0).l,D0                       ; P1: NES-format from READ_JOYPAD
02:00001BBA 6002            	   600:     BRA.S   .joy_got_buttons
                            	   601: .joy_p2_zero:
02:00001BBC 7000            	   602:     MOVEQ   #0,D0                                ; P2: no controller
                            	   603: .joy_got_buttons:
                            	   604:     ; Press detection: press = (new XOR old) AND new
02:00001BBE 1600            	   605:     MOVE.B  D0,D3                                ; D3 = full button state (hold)
                            	   606:     ; Load previous hold into D2 (avoid indexed EOR that fix_syntax mangles)
02:00001BC0 207C00FF00FA    	   607:     MOVEA.L #ram_btn_hold,A0
02:00001BC6 14301800        	   608:     MOVE.B  (A0,D1.L),D2                         ; D2 = previous hold
02:00001BCA B500            	   609:     EOR.B   D2,D0                                ; D0 = changed buttons
02:00001BCC C003            	   610:     AND.B   D3,D0                                ; D0 = newly pressed only
02:00001BCE 207C00FF00F8    	   611:     MOVEA.L #ram_btn_press,A0
02:00001BD4 11801800        	   612:     MOVE.B  D0,(A0,D1.L)                         ; store new presses
02:00001BD8 207C00FF00FA    	   613:     MOVEA.L #ram_btn_hold,A0
02:00001BDE 11831800        	   614:     MOVE.B  D3,(A0,D1.L)                         ; update hold state
02:00001BE2 4E75            	   615:     RTS                     ; RTS  ; orig: C - - - - - 0x01E688 07:E678: 60        RTS
