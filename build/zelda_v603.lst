                            	  1216: tbl_94AD_demo_manual_text:  ; orig: tbl_94AD_demo_manual_text:
                            	  1217: ; FIX v482: NES pointer table → Genesis label addresses (little-endian byte pairs)
                            	  1218: ; NES stored 16-bit ROM pointers; after translation those addresses are wrong.
                            	  1219: ; The code reads low byte then high byte, stores to zero-page, MOVE.W + ROL.W #8
                            	  1220: ; to reconstruct. So we emit (label & $FF), ((label >> 8) & $FF) for each entry.
