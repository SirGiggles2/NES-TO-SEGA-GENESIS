Source: "vdp_layer.asm"
                            	     1: ; ???????????????????????????????????????????????????????????????
                            	     2: ; vdp_layer.asm - FULL FILE (v68 ready)
                            	     3: ; Sega Genesis VDP ? NES PPU translation layer
                            	     4: ; FIXED: VBlank now uses jmp (no stack corruption) + forced NMI every frame
                            	     5: ; ???????????????????????????????????????????????????????????????
                            	     6: 
                            	     7: VDP_DATA        EQU $C00000
                            	     8: VDP_CTRL        EQU $C00004
                            	     9: VDP_HVCOUNTER   EQU $C00008
                            	    10: 
                            	    11: VDP_REG_MODE1   EQU $80
                            	    12: VDP_REG_MODE2   EQU $81
                            	    13: VDP_REG_PLANE_A EQU $82
                            	    14: VDP_REG_WINDOW  EQU $83
