                            	  2395: ofs_007_9B79_01:  ; orig: ofs_007_9B79_01:
02:0000EAAC 103900FF0438    	  2396:     MOVE.B  ($00FF0438).l,D0  ; orig: C - - J - - 0x009B89 02:9B79: AD 38 04  LDA ram_0437_enemy +
02:0000EAB2 66000096        	  2397:     BNE     b02_bra_9BD0             ; BNE  ; orig: C - - - - - 0x009B8C 02:9B7C: D0 52     BNE b02_bra_9BD0
                            	  2398:     ; FIX v487: Direct ROM table access for palette fade data
                            	  2399:     ; Original code had two bugs:
                            	  2400:     ;   1. NES ADC translated as ADD.B by Fix G (drops carry, wrong pointer for steps >= 5)
                            	  2401:     ;   2. MOVEA.W sign-extends ROM pointers >= $8000 (reads from $FE9969 instead of ROM $9969)
                            	  2402:     ; Fix: compute table offset directly and read from correct ROM address
02:0000EAB6 7A00            	  2403:     MOVEQ   #0,D5
02:0000EAB8 1A3900FF0437    	  2404:     MOVE.B  ram_0437_link,D5             ; D5 = fade step (0-13)
02:0000EABE EB4D            	  2405:     LSL.W   #5,D5                        ; D5 = step * 32 (each fade entry is 32 bytes)
02:0000EAC0 227C0000E89C    	  2406:     MOVEA.L #tbl_9969_logo_blackout_palette,A1
02:0000EAC6 D2C5            	  2407:     ADDA.W  D5,A1                        ; A1 = &tbl_9969[step * 32]
02:0000EAC8 103C003F        	  2408:     MOVE.B  #$3F,D0
02:0000EACC 13C000FF0302    	  2409:     MOVE.B  D0,ram_0302_ppu_buffer       ; PPU addr high = $3F
02:0000EAD2 103C0000        	  2410:     MOVE.B  #$00,D0
02:0000EAD6 13C000FF0303    	  2411:     MOVE.B  D0,ram_0302_ppu_buffer+1     ; PPU addr low = $00 → write to $3F00 (palette)
02:0000EADC 103C0020        	  2412:     MOVE.B  #$20,D0
02:0000EAE0 13C000FF0304    	  2413:     MOVE.B  D0,ram_0302_ppu_buffer+2     ; control: 32 bytes, literal, increment by 1
02:0000EAE6 143C001F        	  2414:     MOVE.B  #$1F,D2                      ; loop counter: 31 down to 0
02:0000EAEA 103C00FF        	  2415:     MOVE.B  #$FF,D0
02:0000EAEE 41F900FF0306    	  2416:     LEA     (ram_0302_ppu_buffer+4).l,A0
02:0000EAF4 11802000        	  2417:     MOVE.B  D0,(A0,D2.W)                ; set $FF terminator at buffer end
                            	  2418:     ; FIX v487: Set buffer index to non-zero so VDP_VBLANK_HANDLER doesn't
                            	  2419:     ; clear the buffer before the NMI handler can process it
02:0000EAF8 13FC000100FF0301	  2420:     MOVE.B  #$01,ram_0301_buffer_index
                            	  2421: b02_bra_9BAE_loop:
02:0000EB00 10312000        	  2422:     MOVE.B  (A1,D2.W),D0                ; FIX v487: read palette from ROM directly
02:0000EB04 41F900FF0305    	  2423:     LEA     (ram_0302_ppu_buffer+3).l,A0
02:0000EB0A 11802000        	  2424:     MOVE.B  D0,(A0,D2.W)  ; orig: C - - - - - 0x009BC0 02:9BB0: 99 05 03  STA ram_0302_ppu_buf
02:0000EB0E 5302            	  2425:     SUBQ.B  #1,D2           ; DEY  ; orig: C - - - - - 0x009BC3 02:9BB3: 88        DEY
02:0000EB10 6AEE            	  2426:     BPL     b02_bra_9BAE_loop             ; BPL  ; orig: C - - - - - 0x009BC4 02:9BB4: 10 F8     BPL b02_bra_9BAE_loop
02:0000EB12 523900FF0437    	  2427:     ADDQ.B  #1,ram_0437_link  ; orig: C - - - - - 0x009BC6 02:9BB6: EE 37 04  INC ram_0437_link
02:0000EB18 143900FF0437    	  2428:     MOVE.B  ram_0437_link,D2  ; orig: C - - - - - 0x009BC9 02:9BB9: AC 37 04  LDY ram_0437_link
02:0000EB1E 207C0000EA9B    	  2429:     MOVEA.L #tbl_9B69-1,A0
02:0000EB24 10302800        	  2430:     MOVE.B  (A0,D2.L),D0  ; orig: C - - - - - 0x009BCC 02:9BBC: B9 68 9B  LDA tbl_9B69 - $01,Y
02:0000EB28 13C000FF0438    	  2431:     MOVE.B  D0,($00FF0438).l  ; orig: C - - - - - 0x009BCF 02:9BBF: 8D 38 04  STA ram_0437_enemy +
02:0000EB2E 0C02000E        	  2432:     CMPI.B  #$0E,D2  ; orig: C - - - - - 0x009BD2 02:9BC2: C0 0E     CPY #$0E
02:0000EB32 6516            	  2433:     BCS     b02_bra_9BD0             ; BCC  ; orig: C - - - - - 0x009BD4 02:9BC4: 90 0A     BCC b02_bra_9BD0
02:0000EB34 523900FF042C    	  2434:     ADDQ.B  #1,ram_042B_enemy  ; orig: C - - - - - 0x009BD6 02:9BC6: EE 2C 04  INC ram_042B_enemy
