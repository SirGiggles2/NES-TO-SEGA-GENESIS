                            	    19: VDP_REG_AUTOINC EQU $8F
                            	    20: VDP_REG_SCROLL  EQU $90
                            	    21: VDP_REG_WINHPOS EQU $91
                            	    22: VDP_REG_WINVPOS EQU $92
