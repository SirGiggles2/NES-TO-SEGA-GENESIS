                            	   494: sub_0x01E5F2_jump_to_pointers_after_JSR:  ; orig: sub_0x01E5F2_jump_to_pointers_after_JSR:
                            	   495:     ; bzk rewrite: NES JSR dispatch → 68K BSR dispatch with DC.L jump table
                            	   496:     ; NES: JSR pushed 2-byte return addr; PLA/PLA recovered it; table was .WORD (16-bit)
                            	   497:     ; 68K: BSR pushes 4-byte return addr pointing right at DC.L table entries
                            	   498:     ; D0 = script index (0-based, byte)
02:00001AD4 33C000FFF084    	   499:     MOVE.W  D0,(TRACE_SCRIPT_RAW).l
02:00001ADA 23CF00FFF090    	   500:     MOVE.L  A7,(TRACE_DISP_STACK).l
02:00001AE0 024000FF        	   501:     ANDI.W  #$00FF,D0
02:00001AE4 E540            	   502:     ASL.W   #2,D0           ; D0 = index * 4 (DC.L entry = 4 bytes each)
02:00001AE6 33C000FFF086    	   503:     MOVE.W  D0,(TRACE_DISP_INDEX).l
02:00001AEC 225F            	   504:     MOVEA.L (A7)+,A1        ; pop BSR's 4-byte return address → A1 = DC.L table base
02:00001AEE 20710000        	   505:     MOVEA.L (A1,D0.W),A0   ; read 32-bit target address from table[index]
02:00001AF2 23C900FFF088    	   506:     MOVE.L  A1,(TRACE_DISP_BASE).l
02:00001AF8 23C800FFF08C    	   507:     MOVE.L  A0,(TRACE_DISP_TARGET).l
02:00001AFE 3F00            	   508:     MOVE.W  D0,-(A7)
02:00001B00 303C0317        	   509:     MOVE.W  #$0317,D0
02:00001B04 6100E948        	   510:     BSR     TRACE_MARK
02:00001B08 303C0318        	   511:     MOVE.W  #$0318,D0
02:00001B0C 6100E940        	   512:     BSR     TRACE_MARK
02:00001B10 301F            	   513:     MOVE.W  (A7)+,D0
02:00001B12 4ED0            	   514:     JMP     (A0)            ; jump to target (does not return through BSR)
