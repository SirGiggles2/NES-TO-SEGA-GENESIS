                            	   238: sub_80D7_copy_bat_table_to_bat:  ; orig: sub_80D7_copy_bat_table_to_bat:
                            	   239: 
                            	   240: ; in
                            	   241: 
                            	   242: ; ram_0000_t09_copy_data_from
                            	   243: 
                            	   244: ; ram_0002_t06_copy_data_into
                            	   245: 
                            	   246: ; ram_0004_t08_max_addr_lo
                            	   247: 
                            	   248: ; ram_0005_t01_max_addr_hi
                            	   249: 
                            	   250: ; FIX v590: Rewrite battery table copy.
                            	   251: ; Original NES used indirect pointers (LDA (zp),Y / STA (zp),Y) to copy data
                            	   252: ; from ROM bank 06 addresses ($8000+) into NES RAM ($6000-$7FFF).
                            	   253: ; On Genesis, ROM is at assembled label addresses, not at $FF8000+.
                            	   254: ; This rewrite correctly reads from ROM using tbl_8000_1st_quest as bank 06 base.
                            	   255: 
                            	   256:     ; Build source address from ZP $00/$01 (little-endian NES pointer)
02:00022FDC 7A00            	   257:     MOVEQ   #0,D5
02:00022FDE 1A3900FF0001    	   258:     MOVE.B  $FF0001,D5               ; high byte of NES source addr
02:00022FE4 E14D            	   259:     LSL.W   #8,D5
02:00022FE6 1A3900FF0000    	   260:     MOVE.B  $FF0000,D5               ; low byte → D5.W = NES addr (e.g., $8400)
02:00022FEC 04458000        	   261:     SUBI.W  #$8000,D5                ; offset within bank 06
02:00022FF0 41FAFE54        	   262:     LEA     tbl_8000_1st_quest,A0
02:00022FF4 D0C5            	   263:     ADDA.W  D5,A0                    ; A0 = Genesis ROM source
                            	   264: 
                            	   265:     ; Build dest address from ZP $02/$03
02:00022FF6 7A00            	   266:     MOVEQ   #0,D5
02:00022FF8 1A3900FF0003    	   267:     MOVE.B  $FF0003,D5               ; high byte of NES dest addr
02:00022FFE E14D            	   268:     LSL.W   #8,D5
02:00023000 1A3900FF0002    	   269:     MOVE.B  $FF0002,D5               ; low byte → D5.W = NES addr (e.g., $687E)
02:00023006 43F900FF0000    	   270:     LEA     $FF0000.l,A1
02:0002300C D2C5            	   271:     ADDA.W  D5,A1                    ; A1 = Genesis RAM dest
                            	   272: 
                            	   273:     ; Build max address from ZP $04/$05
02:0002300E 7A00            	   274:     MOVEQ   #0,D5
02:00023010 1A3900FF0005    	   275:     MOVE.B  ram_0005_t01_max_addr_hi,D5
02:00023016 E14D            	   276:     LSL.W   #8,D5
02:00023018 1A3900FF0004    	   277:     MOVE.B  ram_0004_t08_max_addr_lo,D5
02:0002301E 47F900FF0000    	   278:     LEA     $FF0000.l,A3
02:00023024 D6C5            	   279:     ADDA.W  D5,A3                    ; A3 = Genesis RAM max address
                            	   280: 
