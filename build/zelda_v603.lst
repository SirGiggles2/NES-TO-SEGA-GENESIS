                            	   452: ; ?.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.?
                            	   453: ; READ_JOYPAD - Read Genesis 3-button controller
                            	   454: ; Returns NES-format button byte in D0:
                            	   455: ;   bit 7=A(NES), 6=B, 5=Select, 4=Start, 3=Up, 2=Down, 1=Left, 0=Right
                            	   456: ;
                            	   457: ; Genesis 3-button pad hardware (active low):
                            	   458: ;   TH=1 (strobe high) reads into D1:
                            	   459: ;     bit 5 = C,  bit 4 = B,  bits 3-0 = Up/Down/Left/Right
                            	   460: ;     bit 6 = A (active low)
                            	   461: ;   TH=0 (strobe low) reads into D2:
                            	   462: ;     bit 5 = Start,  bit 4 = A,  bits 3-2 = 0/0, bits 1-0 = Up/Down
                            	   463: ;
                            	   464: ; Mapping:
                            	   465: ;   Genesis A     -> NES A      (bit 7)
                            	   466: ;   Genesis B     -> NES B      (bit 6)
                            	   467: ;   Genesis C     -> NES Select (bit 5)
                            	   468: ;   Genesis Start -> NES Start  (bit 4)
                            	   469: ;   D-pad         -> D-pad      (direct)
                            	   470: ; ?.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.?
                            	   471: READ_JOYPAD:
02:0000058A 4A3900FFEE91    	   472:     tst.b   (JOYPAD_OVERRIDE_ENABLE).l
02:00000590 6710            	   473:     beq     .read_hardware
02:00000592 7000            	   474:     moveq   #0,D0
02:00000594 103900FFEE90    	   475:     move.b  (JOYPAD_OVERRIDE_P1).l,D0
02:0000059A 13C000FF00F0    	   476:     move.b  D0,($FF0000+$00F0)
02:000005A0 4E75            	   477:     rts
                            	   478: .read_hardware:
                            	   479:     ; Strobe high
02:000005A2 13FC004000A10003	   480:     move.b  #$40,($A10003)
02:000005AA 4E71            	   481:     nop
02:000005AC 4E71            	   482:     nop
                            	   483:     ; Read high nibble (Start, A, C, B + directions)
02:000005AE 123900A10003    	   484:     move.b  ($A10003),D1
                            	   485:     ; Strobe low
02:000005B4 13FC000000A10003	   486:     move.b  #$00,($A10003)
02:000005BC 4E71            	   487:     nop
02:000005BE 4E71            	   488:     nop
                            	   489:     ; Read low nibble (Start, A, C, B again + mode)
02:000005C0 143900A10003    	   490:     move.b  ($A10003),D2
                            	   491: 
                            	   492:     ; Build NES-format byte in D0
02:000005C6 4200            	   493:     clr.b   D0
                            	   494: 
                            	   495:     ; D-pad from D1 bits 0-3 (Up=3, Down=2, Left=1, Right=0)
02:000005C8 1601            	   496:     move.b  D1,D3
02:000005CA 0203000F        	   497:     andi.b  #$0F,D3                 ; mask direction bits
                            	   498:     ; NES: bit3=Up, bit2=Down, bit1=Left, bit0=Right (active low on Genesis)
02:000005CE 0A03000F        	   499:     eori.b  #$0F,D3                 ; invert (Genesis is active low)
02:000005D2 8003            	   500:     or.b    D3,D0
                            	   501: 
                            	   502:     ; Start button: Genesis D2 bit 5 (TH=0 read)
02:000005D4 08020005        	   503:     btst    #5,D2
02:000005D8 6604            	   504:     bne     .no_start               ; active low - not pressed if bit set
02:000005DA 08C00004        	   505:     bset    #4,D0                   ; NES Start = bit 4
                            	   506: .no_start:
                            	   507: 
                            	   508:     ; A button: Genesis D1 bit 6 (TH=1 read) -> NES A = bit 7
02:000005DE 08010006        	   509:     btst    #6,D1
02:000005E2 6604            	   510:     bne     .no_a
02:000005E4 08C00007        	   511:     bset    #7,D0
                            	   512: .no_a:
                            	   513: 
                            	   514:     ; B button: Genesis D1 bit 4 (TH=1 read) -> NES B = bit 6
02:000005E8 08010004        	   515:     btst    #4,D1
02:000005EC 6604            	   516:     bne     .no_b
02:000005EE 08C00006        	   517:     bset    #6,D0
                            	   518: .no_b:
                            	   519: 
                            	   520:     ; C button: Genesis D1 bit 5 (TH=1 read) -> NES Select = bit 5
02:000005F2 08010005        	   521:     btst    #5,D1
02:000005F6 6604            	   522:     bne     .no_select
02:000005F8 08C00005        	   523:     bset    #5,D0
                            	   524: .no_select:
                            	   525: 
                            	   526:     ; Store for NES input routines to read
                            	   527:     ; NES reads controller state from RAM - we mirror it there
02:000005FC 13C000FF00F0    	   528:     move.b  D0,($FF0000+$00F0)      ; joypad 1 state in NES RAM mirror
02:00000602 4E75            	   529:     rts
                            	   530: 
                            	   531: ; ?.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.?
                            	   532: ; EXCEPTION_HANDLER - Catch all unexpected exceptions
                            	   533: ; Stores stack/register state in RAM and flashes red.
                            	   534: ; Generic 68000 exception frames place SR at (SP) and PC at 2(SP).
                            	   535: ; The raw frame bytes are also copied for deeper inspection.
                            	   536: ; ?.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.?
                            	   537: EXCEPTION_HANDLER:
02:00000604 48F97FFF00FFEE40	   538:     movem.l D0-D7/A0-A6,(CRASH_REGS).l
02:0000060C 23CF00FFEE04    	   539:     move.l  A7,(CRASH_SP).l         ; exception frame SP on entry
02:00000612 33FCBEEF00FFEE00	   540:     move.w  #$BEEF,(CRASH_MAGIC).l
02:0000061A 4A7900FFEE02    	   541:     tst.w   (CRASH_VECTOR).l
02:00000620 6608            	   542:     bne     .vector_ready
02:00000622 33FCFFFF00FFEE02	   543:     move.w  #$FFFF,(CRASH_VECTOR).l
                            	   544: .vector_ready:
02:0000062A 33D700FFEE08    	   545:     move.w  (A7),(CRASH_SR).l       ; generic SR
02:00000630 23EF000200FFEE0A	   546:     move.l  2(A7),(CRASH_PC).l      ; generic PC
02:00000638 42B900FFEE80    	   547:     clr.l   (CRASH_AUX).l
02:0000063E 427900FFEE84    	   548:     clr.w   (CRASH_AUX+$04).l
02:00000644 0C79000200FFEE02	   549:     cmpi.w  #$0002,(CRASH_VECTOR).l
02:0000064C 670A            	   550:     beq     .decode_bus_addr
02:0000064E 0C79000300FFEE02	   551:     cmpi.w  #$0003,(CRASH_VECTOR).l
02:00000656 6620            	   552:     bne     .copy_frame_data
                            	   553: .decode_bus_addr:
02:00000658 23EF000200FFEE80	   554:     move.l  2(A7),(CRASH_AUX).l
02:00000660 33EF000600FFEE84	   555:     move.w  6(A7),(CRASH_AUX+$04).l
02:00000668 33EF000800FFEE08	   556:     move.w  8(A7),(CRASH_SR).l
02:00000670 23EF000A00FFEE0A	   557:     move.l  10(A7),(CRASH_PC).l
                            	   558: 
                            	   559: .copy_frame_data:
02:00000678 41F900FFEE10    	   560:     lea     CRASH_FRAME,A0
02:0000067E 224F            	   561:     movea.l A7,A1
02:00000680 7E0F            	   562:     moveq   #15,D7                  ; copy first 16 words (32 bytes) of raw frame
                            	   563: .copy_frame_loop:
02:00000682 30D9            	   564:     move.w  (A1)+,(A0)+
02:00000684 51CFFFFC        	   565:     dbra    D7,.copy_frame_loop
                            	   566: 
                            	   567:     ; Write red to CRAM entry 0 (background color)
02:00000688 23FCC000000000C0	   568:     move.l  #$C0000000,($C00004)    ; CRAM write addr 0
02:00000690 0004
02:00000692 33FC000E00C00000	   569:     move.w  #$000E,($C00000)        ; red in BGR555
                            	   570: .halt:
02:0000069A 60FE            	   571:     bra     .halt                   ; infinite loop - inspect diag/debugger
                            	   572: 
                            	   573: ; ?.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.?
                            	   574: ; CHR_VRAM_LOAD - Copy pre-converted 4bpp tile data into VDP VRAM
                            	   575: ; Called once at startup after VDP_INIT.
                            	   576: ; Loads 512 tiles (16KB) into VRAM $0000-$3FFF:
                            	   577: ;   Tiles   0-255  (VRAM $0000-$1FFF) = PT0 background tiles
                            	   578: ;   Tiles 256-511  (VRAM $2000-$3FFF) = PT1 sprite tiles
                            	   579: ; Source: zelda_tiles_4bpp.bin (generated by chr_convert.py)
                            	   580: ; ?.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.?
                            	   581: CHR_VRAM_LOAD:
                            	   582:     ; Set VRAM write address to $0000 (tile area base)
02:0000069C 23FC4000000000C0	   583:     move.l  #$40000000,($C00004)    ; VRAM write cmd for addr $0000
02:000006A4 0004
                            	   584:     ; Stream 16KB of 4bpp tile data from ROM to VRAM
                            	   585:     ; VDP auto-increment = 2, MOVE.L writes 4 bytes per iteration
02:000006A6 207C0002A74C    	   586:     movea.l #ZELDA_TILES_4BPP,A0
02:000006AC 303C0FFF        	   587:     move.w  #(16384/4)-1,D0        ; 4095 = 4096 iterations
                            	   588: .chr_loop:
02:000006B0 23D800C00000    	   589:     move.l  (A0)+,($C00000)        ; 4 bytes ??' 2 VDP words ??' VRAM +4
02:000006B6 51C8FFF8        	   590:     dbra    D0,.chr_loop
02:000006BA 4E75            	   591:     rts
                            	   592: 
                            	   593: CHR_SHADOW_LOAD:
                            	   594:     ; Keep emulated PPU pattern reads in sync with the startup VRAM upload.
