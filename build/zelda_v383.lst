                            	   413: ; READ_JOYPAD - Read Genesis 3-button controller
                            	   414: ; Returns NES-format button byte in D0:
                            	   415: ;   bit 7=A(NES), 6=B, 5=Select, 4=Start, 3=Up, 2=Down, 1=Left, 0=Right
                            	   416: ;
                            	   417: ; Genesis button mapping to NES:
                            	   418: ;   Genesis START ??' NES START
                            	   419: ;   Genesis A     ??' NES A
                            	   420: ;   Genesis B     ??' NES B
                            	   421: ;   Genesis C     ??' NES A (second button)
                            	   422: ;   D-pad         ??' D-pad (direct)
                            	   423: ; ?.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.?
                            	   424: READ_JOYPAD:
                            	   425:     ; Strobe high
02:00000522 13FC004000A10003	   426:     move.b  #$40,($A10003)
02:0000052A 4E71            	   427:     nop
02:0000052C 4E71            	   428:     nop
                            	   429:     ; Read high nibble (Start, A, C, B + directions)
02:0000052E 123900A10003    	   430:     move.b  ($A10003),D1
                            	   431:     ; Strobe low
02:00000534 13FC000000A10003	   432:     move.b  #$00,($A10003)
02:0000053C 4E71            	   433:     nop
02:0000053E 4E71            	   434:     nop
                            	   435:     ; Read low nibble (Start, A, C, B again + mode)
02:00000540 143900A10003    	   436:     move.b  ($A10003),D2
                            	   437: 
                            	   438:     ; Build NES-format byte in D0
02:00000546 4200            	   439:     clr.b   D0
                            	   440: 
                            	   441:     ; D-pad from D1 bits 0-3 (Up=3, Down=2, Left=1, Right=0)
02:00000548 1601            	   442:     move.b  D1,D3
02:0000054A 0203000F        	   443:     andi.b  #$0F,D3                 ; mask direction bits
                            	   444:     ; NES: bit3=Up, bit2=Down, bit1=Left, bit0=Right (active low on Genesis)
02:0000054E 0A03000F        	   445:     eori.b  #$0F,D3                 ; invert (Genesis is active low)
02:00000552 8003            	   446:     or.b    D3,D0
                            	   447: 
                            	   448:     ; Start button: Genesis D1 bit 5
02:00000554 08010005        	   449:     btst    #5,D1
02:00000558 6604            	   450:     bne     .no_start               ; active low - not pressed if bit set
02:0000055A 08C00004        	   451:     bset    #4,D0                   ; NES Start = bit 4
                            	   452: .no_start:
                            	   453: 
                            	   454:     ; A button: Genesis D1 bit 6 ??' NES A = bit 7
02:0000055E 08010006        	   455:     btst    #6,D1
02:00000562 6604            	   456:     bne     .no_a
02:00000564 08C00007        	   457:     bset    #7,D0
                            	   458: .no_a:
                            	   459: 
                            	   460:     ; B button: Genesis D2 bit 4 ??' NES B = bit 6
02:00000568 08020004        	   461:     btst    #4,D2
02:0000056C 6604            	   462:     bne     .no_b
02:0000056E 08C00006        	   463:     bset    #6,D0
                            	   464: .no_b:
                            	   465: 
                            	   466:     ; Select: Genesis has no Select - map to C button (D1 bit 4)
02:00000572 08010004        	   467:     btst    #4,D1
02:00000576 6604            	   468:     bne     .no_select
02:00000578 08C00005        	   469:     bset    #5,D0
                            	   470: .no_select:
                            	   471: 
                            	   472:     ; Store for NES input routines to read
                            	   473:     ; NES reads controller state from RAM - we mirror it there
02:0000057C 13C000FF00F0    	   474:     move.b  D0,($FF0000+$00F0)      ; joypad 1 state in NES RAM mirror
02:00000582 4E75            	   475:     rts
