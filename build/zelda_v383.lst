                            	     5: 
                            	     6: ; Source: bank___BF50_BFF9.asm
                            	     7: ; !! This is a FIRST PASS - hardware I/O needs manual work !!
                            	     8: ; Register mapping:
                            	     9: ;   A (accumulator) → D0
                            	    10: ;   X (index)       → D1
                            	    11: ;   Y (index)       → D2
                            	    12: ;   Temp            → D3, D4, D5
                            	    13: ;   NES RAM base    → A0 = $FF0000
                            	    14: ; ═══════════════════════════════════════
                            	    15: 
                            	    16: 
                            	    17: ; content was copied from bank_00.asm
                            	    18: 
                            	    19: ; it's a common identical include file for banks 00-06
                            	    20: 
                            	    21: ; should be placed at the same address in all files (currently BF50)
                            	    22: 
                            	    23: 
                            	    24: ; that's because of MMC1 stuff, read here about this
                            	    25: 
                            	    26: ; https://wiki.nesdev.com/w/index.php/MMC1#Control_.28internal.2C_.248000-.249FFF.29
