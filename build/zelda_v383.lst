                            	   310:     ; ?"??"? Clear Genesis RAM ($FF0000-$FFFFFF) ?"??"?
                            	   311:     ; This replaces the NES ClearRAM routine
                            	   312:     ; NOTE: Must happen BEFORE VDP_INIT so shadow registers are not wiped
02:000003C0 207C00FF0000    	   313:     movea.l #$FF0000,A0
02:000003C6 303C3BFF        	   314:     move.w  #$3BFF,D0               ; 15360 longs = 60KB (stops before VDP shadow regs at $FFEF00)
                            	   315: .clear_ram:
02:000003CA 4298            	   316:     clr.l   (A0)+
02:000003CC 51C8FFFC        	   317:     dbra    D0,.clear_ram
