                            	   478: ; EXCEPTION_HANDLER - Catch all unexpected exceptions
                            	   479: ; Stores stack/register state in RAM and flashes red.
                            	   480: ; Generic 68000 exception frames place SR at (SP) and PC at 2(SP).
                            	   481: ; The raw frame bytes are also copied for deeper inspection.
                            	   482: ; ?.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.??.?
                            	   483: EXCEPTION_HANDLER:
02:00000584 48F97FFF00FFEE40	   484:     movem.l D0-D7/A0-A6,(CRASH_REGS).l
02:0000058C 23CF00FFEE04    	   485:     move.l  A7,(CRASH_SP).l         ; exception frame SP on entry
02:00000592 33FCBEEF00FFEE00	   486:     move.w  #$BEEF,(CRASH_MAGIC).l
02:0000059A 4A7900FFEE02    	   487:     tst.w   (CRASH_VECTOR).l
02:000005A0 6608            	   488:     bne     .vector_ready
02:000005A2 33FCFFFF00FFEE02	   489:     move.w  #$FFFF,(CRASH_VECTOR).l
                            	   490: .vector_ready:
02:000005AA 33D700FFEE08    	   491:     move.w  (A7),(CRASH_SR).l       ; generic SR
02:000005B0 23EF000200FFEE0A	   492:     move.l  2(A7),(CRASH_PC).l      ; generic PC
02:000005B8 42B900FFEE80    	   493:     clr.l   (CRASH_AUX).l
02:000005BE 427900FFEE84    	   494:     clr.w   (CRASH_AUX+$04).l
02:000005C4 0C79000200FFEE02	   495:     cmpi.w  #$0002,(CRASH_VECTOR).l
02:000005CC 670A            	   496:     beq     .decode_bus_addr
02:000005CE 0C79000300FFEE02	   497:     cmpi.w  #$0003,(CRASH_VECTOR).l
02:000005D6 6620            	   498:     bne     .copy_frame_data
                            	   499: .decode_bus_addr:
02:000005D8 23EF000200FFEE80	   500:     move.l  2(A7),(CRASH_AUX).l
02:000005E0 33EF000600FFEE84	   501:     move.w  6(A7),(CRASH_AUX+$04).l
02:000005E8 33EF000800FFEE08	   502:     move.w  8(A7),(CRASH_SR).l
02:000005F0 23EF000A00FFEE0A	   503:     move.l  10(A7),(CRASH_PC).l
