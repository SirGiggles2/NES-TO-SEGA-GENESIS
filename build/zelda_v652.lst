                            	  6931:     ; Fix: advance 16-bit PPU buffer pointer by (Y+1) bytes
                            	  6932:     ; NES was: SEC; TYA; ADC ptr_lo; STA ptr_lo; LDA #0; ADC ptr_hi; STA ptr_hi
02:00025414 123900FF0000    	  6933:     MOVE.B  ram_0000_t11_ppu_data,D1            ; start from current low byte
02:0002541A 1802            	  6934:     MOVE.B  D2,D4                               ; D4 = Y (bytes consumed this record)
02:0002541C 5204            	  6935:     ADDQ.B  #1,D4                               ; D4 = Y+1 (NES SEC effect)
02:0002541E D204            	  6936:     ADD.B   D4,D1                               ; D1 = lo_ptr + Y + 1, carry = high-byte bump
02:00025420 13C100FF0000    	  6937:     MOVE.B  D1,ram_0000_t11_ppu_data            ; store new low byte without clobbering carry first
02:00025426 6406            	  6938:     BCC     b06_bra_b06_ppu_ptr_nocarry             ; no carry into high byte
02:00025428 523900FF0001    	  6939:     ADDQ.B  #1,ram_0000_t11_ppu_data+1         ; carry into high byte
