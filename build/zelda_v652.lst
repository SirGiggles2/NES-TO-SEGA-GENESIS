                            	   307: 
                            	   308: ; ram_0005_t01_max_addr_hi
                            	   309: 
                            	   310: ; FIX v638: bank 06 data is no longer safe to address via NES $8000-based
                            	   311: ; offsets because translated alignment padding shifts the assembled labels.
                            	   312: ; The call sites resolve the real source label before entering this routine.
