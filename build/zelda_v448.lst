                            	   503: sub_0x01E5F2_jump_to_pointers_after_JSR:  ; orig: sub_0x01E5F2_jump_to_pointers_after_JSR:
                            	   504:     ; bzk rewrite: NES JSR dispatch → 68K BSR dispatch with DC.L jump table
                            	   505:     ; NES: JSR pushed 2-byte return addr; PLA/PLA recovered it; table was .WORD (16-bit)
                            	   506:     ; 68K: BSR pushes 4-byte return addr pointing right at DC.L table entries
                            	   507:     ; D0 = script index (0-based, byte)
02:000014BE 33C000FFF084    	   508:     MOVE.W  D0,(TRACE_SCRIPT_RAW).l
02:000014C4 23CF00FFF090    	   509:     MOVE.L  A7,(TRACE_DISP_STACK).l
02:000014CA 024000FF        	   510:     ANDI.W  #$00FF,D0
02:000014CE E540            	   511:     ASL.W   #2,D0           ; D0 = index * 4 (DC.L entry = 4 bytes each)
02:000014D0 33C000FFF086    	   512:     MOVE.W  D0,(TRACE_DISP_INDEX).l
02:000014D6 225F            	   513:     MOVEA.L (A7)+,A1        ; pop BSR's 4-byte return address → A1 = DC.L table base
02:000014D8 20710000        	   514:     MOVEA.L (A1,D0.W),A0   ; read 32-bit target address from table[index]
02:000014DC 23C900FFF088    	   515:     MOVE.L  A1,(TRACE_DISP_BASE).l
02:000014E2 23C800FFF08C    	   516:     MOVE.L  A0,(TRACE_DISP_TARGET).l
02:000014E8 3F00            	   517:     MOVE.W  D0,-(A7)
02:000014EA 303C0317        	   518:     MOVE.W  #$0317,D0
02:000014EE 6100EF4C        	   519:     BSR     TRACE_MARK
02:000014F2 303C0318        	   520:     MOVE.W  #$0318,D0
02:000014F6 6100EF44        	   521:     BSR     TRACE_MARK
02:000014FA 301F            	   522:     MOVE.W  (A7)+,D0
02:000014FC 4ED0            	   523:     JMP     (A0)            ; jump to target (does not return through BSR)
