                            	  6881:     ; Fix: advance 16-bit PPU buffer pointer by (Y+1) bytes
                            	  6882:     ; NES was: SEC; TYA; ADC ptr_lo; STA ptr_lo; LDA #0; ADC ptr_hi; STA ptr_hi
02:000199EA 123900FF0000    	  6883:     MOVE.B  ram_0000_t11_ppu_data,D1            ; start from current low byte
