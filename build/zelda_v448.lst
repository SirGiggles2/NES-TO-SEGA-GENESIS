02:000199F2 5204            	  6885:     ADDQ.B  #1,D4                               ; D4 = Y+1 (NES SEC effect)
02:000199F4 D204            	  6886:     ADD.B   D4,D1                               ; D1 = lo_ptr + Y + 1, carry = high-byte bump
02:000199F6 13C100FF0000    	  6887:     MOVE.B  D1,ram_0000_t11_ppu_data            ; store new low byte without clobbering carry first
