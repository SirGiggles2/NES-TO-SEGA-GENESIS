02:000014BA E540            	   501:     ASL.W   #2,D0           ; D0 = index * 4 (DC.L entry = 4 bytes each)
02:000014BC 33C000FFF086    	   502:     MOVE.W  D0,(TRACE_DISP_INDEX).l
02:000014C2 225F            	   503:     MOVEA.L (A7)+,A1        ; pop BSR's 4-byte return address → A1 = DC.L table base
02:000014C4 20710000        	   504:     MOVEA.L (A1,D0.W),A0   ; read 32-bit target address from table[index]
02:000014C8 23C900FFF088    	   505:     MOVE.L  A1,(TRACE_DISP_BASE).l
02:000014CE 23C800FFF08C    	   506:     MOVE.L  A0,(TRACE_DISP_TARGET).l
02:000014D4 3F00            	   507:     MOVE.W  D0,-(A7)
