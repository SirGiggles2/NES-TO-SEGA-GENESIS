    4481/    3C38 : 6608                	bne.s	+
    4482/    3C3A : 0840 0002           	bchg	#2,d0	; Alternate between X positions of 0 and 4.
    4483/    3C3E : 3340 0002           	move.w	d0,2(a1)
    4484/    3C42 : 5049                +	addq.w	#8,a1
