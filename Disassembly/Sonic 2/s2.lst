(1)  721/     1A8 :                     .lownybble:
(1)  722/     1A8 : FD 86 00            	add	a,(iy+0)		; 19	; Get byte from zDACDecodeTbl (self-modified to proper index)
(1)  723/     1AB : 32 01 40            	ld	(zYM2612_D0),a		; 13	; Write this byte to the DAC
(1)  724/     1AE : 08                  	ex	af,af'			; 4	; back to regular registers
(1)  725/     1AF : FB                  	ei				; 4	; enable interrupts (done updating DAC, busy waiting for next update)
(1)  726/     1B0 : C3 74 01            	jp	zWaitLoop		; 10	; Back to the wait loop; if there's more DAC to write, we come back down again!
(1)  727/     1B3 :                     					; 295
(1)  728/     1B3 :                     	; 295 cycles for two samples. dpcmLoopCounter should use 295 divided by 2.
