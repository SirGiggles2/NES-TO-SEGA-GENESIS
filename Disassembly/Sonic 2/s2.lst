   12934/    97C5 :                     ; byte_97C5
   12935/    97C5 :                     super_sonic_cheat:
   12936/    97C5 :                     	; Book of Genesis, 41:26, which makes frequent reference to the
   12937/    97C5 :                     	; number 7. 7 happens to be the number of Chaos Emeralds.
   12938/    97C5 :                     	; The Mega Drive is known as the Genesis in the US.
   12939/    97C5 : 0401 0206 00        	dc.b   4,   1,   2,   6,   0
