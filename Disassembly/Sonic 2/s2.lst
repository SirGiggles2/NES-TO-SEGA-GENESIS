    5830/    4948 :                     ; ---------------------------------------------------------------------------
    5831/    4948 :                     ; off_4948:
    5832/    4948 : (MACRO)              DemoScriptPointers: zoneOrderedTable 4,1
    5832/    4948 : =$4948               DemoScriptPointers label *
    5832/    4948 :                     ; set some global variables
    5832/    4948 : ="DemoScriptPoin..   .zone_table_name := "DemoScriptPointers"
    5832/    4948 : =$4948               .zone_table_addr := *
    5832/    4948 : =$4                  .zone_entry_len := 4
    5832/    4948 : =$1                  .zone_entries := 1
    5832/    4948 : =$0                  .zone_entries_left := 0
    5832/    4948 : =$0                  .cur_zone_id := 0
    5832/    4948 : ="0"                 .cur_zone_str := "0"
    5833/    4948 : (MACRO)              	zoneTableEntry.l Demo_EHZ	; EHZ
    5833/    4948 :                                     !org .zone_table_addr+zone_id_{.cur_zone_str}*.zone_entry_len*.zone_entries
    5833/    4948 : 0000 4CA8                           dc.l Demo_EHZ
    5833/    494C : =$0                  .zone_entries_left := .zone_entries-1
    5833/    494C : =$1                  .cur_zone_id := .cur_zone_id+1
    5833/    494C : ="1"                 .cur_zone_str := "\{.cur_zone_id}"
    5833/    494C :                                 shift
    5833/    494C :  (MACRO-2)                       zoneTableEntry.l 
