   17736/    D55A : 4841                	swap	d1
   17737/    D55C : D280                	add.l	d0,d1
   17739/    D55E :                     	; Set row 11's speed
   17740/    D55E : 4841                	swap	d1
   17741/    D560 : 36C1                	move.w	d1,(a3)+
   17742/    D562 :                     
   17743/    D562 :                     	; These instructions reveal that ARZ had slightly different scrolling,
   17744/    D562 :                     	; at one point:
   17745/    D562 :                     	; Above the background's mountains is a row of leaves, which is actually
   17746/    D562 :                     	; composed of three separately-scrolling rows. According to this code,
   17747/    D562 :                     	; the first and third rows were meant to scroll at a different speed to the
   17748/    D562 :                     	; second. Possibly due to how bad it looks, the speed values are overwritten
   17749/    D562 :                     	; a few instructions later, so all three move at the same speed.
   17750/    D562 :                     	; This code seems to pre-date the Simon Wai build, which uses the same
   17751/    D562 :                     	; scrolling as the final game.
   17752/    D562 : 3481                	move.w	d1,(a2)		; Set row 1's speed
   17753/    D564 : 3541 0004           	move.w	d1,4(a2)	; Set row 3's speed
   17754/    D568 :                     
   17755/    D568 : 3038 EE08           	move.w	(Camera_BG_X_pos).w,d0
   17756/    D56C : 3540 0002           	move.w	d0,2(a2)	; Set row 2's speed
   17757/    D570 : 3540 0016           	move.w	d0,$16(a2)	; Set row 12's speed
   17758/    D574 : (MACRO)              	_move.w	d0,0(a2)	; Overwrite row 1's speed (now same as row 2's)
   17758/    D574 :  (MACRO-2)                           insn2op move.w, d0,0(a2)
   17758/    D574 : 3540 0001                                   !move.w   d0,1+0(a2)
   17758/    D577 :                                             !org    *-1
   17758/    D577 : 00                                          !dc.b   0
   17759/    D578 : 3540 0004           	move.w	d0,4(a2)	; Overwrite row 3's speed (now same as row 2's)
   17760/    D57C : 3540 0018           	move.w	d0,12*2(a2)	; Set row 13's speed
   17761/    D580 : 3540 001A           	move.w	d0,13*2(a2)	; Set row 14's speed
   17762/    D584 : 3540 001C           	move.w	d0,14*2(a2)	; Set row 15's speed
   17763/    D588 : 3540 001E           	move.w	d0,15*2(a2)	; Set row 16's speed
   17764/    D58C :                     
   17765/    D58C :                     	; Use the list of row scroll values and a list of row heights to fill
   17766/    D58C :                     	; 'Horiz_Scroll_Buf'.
