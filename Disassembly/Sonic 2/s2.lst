   19107/    DE54 :                     
   19108/    DE54 :                     .doLeftOrRight:
   19109/    DE54 : 78F0                	moveq	#-block_height,d4 ; Y offset
   19110/    DE56 :                     
   19111/    DE56 :                     	; Load left column.
   19112/    DE56 : 7AF0                	moveq	#-block_width,d5 ; X offset
   19113/    DE58 : 1012                	move.b	(a2),d0
   19114/    DE5A : 0200 00A8           	andi.b	#(1<<scroll_flag_advanced_bg1_right)|(1<<scroll_flag_advanced_bg2_right)|(1<<scroll_flag_advanced_bg3_right),d0
   19115/    DE5E : 6708                	beq.s	+
   19116/    DE60 : E208                	lsr.b	#1,d0	; Make the left and right flags share the same bits, to simplify a calculation later.
   19117/    DE62 : 1480                	move.b	d0,(a2)
   19118/    DE64 :                     	; Load right column.
   19119/    DE64 : 3A3C 0140           	move.w	#screen_width,d5 ; X offset
   19120/    DE68 :                     +
   19121/    DE68 :                     	; Select the correct starting background section, and then begin
   19122/    DE68 :                     	; drawing the column.
   19123/    DE68 : (MACRO)              	lea_	CPZ_CameraSections,a0
   19123/    DE68 : 41FA FF66                           !lea CPZ_CameraSections(pc),a0
   19124/    DE6C : 3038 EE0C           	move.w	(Camera_BG_Y_pos).w,d0
