   43202/   1E9B0 :                     
   43203/   1E9B0 :                     ; Scans horizontally for up to 2 16x16 blocks to find solid walls.
   43204/   1E9B0 :                     ; d2 = y_pos
   43205/   1E9B0 :                     ; d3 = x_pos
