   18055/    D71A : E509                	lsl.b	#2,d1		; multiply by 4, the size of a position buffer entry
   18056/    D71C : 5801                	addq.b	#4,d1
   18058/    D71E : 302D 0002           	move.w	Sonic_Pos_Record_Index-Camera_Delay(a5),d0	; get current position buffer index
   18059/    D722 : 9001                	sub.b	d1,d0
   18060/    D724 : 3036 0000           	move.w	(a6,d0.w),d0	; get Sonic's position a certain number of frames ago
   18061/    D728 : 0240 3FFF           	andi.w	#$3FFF,d0
