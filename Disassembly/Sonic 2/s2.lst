   25978/   12C52 :                     ; This macro is used to make the table neater and perform some validation.
   25979/   12C52 :                     TeleportTableEntry macro addressA, addressB
   25980/   12C52 :                     .sizeA := addressA_End-addressA
   25981/   12C52 :                     .sizeB := addressB_End-addressB
   25982/   12C52 :                     	if (.sizeA<>.sizeB)
   25983/   12C52 :                     		fatal "The space between 'addressA' and 'addressA_End' (\{.sizeA} bytes), and 'addressB' and 'addressB_End' (\{.sizeB} bytes) need to be the same size."
   25984/   12C52 :                     	endif
   25985/   12C52 :                     	dc.w	addressA, addressB, bytesToWcnt(.sizeA)
   25986/   12C52 :                     	endm
   25987/   12C52 :                     
