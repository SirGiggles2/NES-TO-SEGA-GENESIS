   42950/   1E7D0 :                     
   42951/   1E7D0 :                     ; Scans vertically for up to 2 16x16 blocks to find solid ground or ceiling.
   42952/   1E7D0 :                     ; d2 = y_pos
   42953/   1E7D0 :                     ; d3 = x_pos
   42954/   1E7D0 :                     ; d5 = ($c,$d) or ($e,$f) - solidity type bit (L/R/B or top)
   42955/   1E7D0 :                     ; d6 = $0000 for no flip, $0800 for vertical flip
   42956/   1E7D0 :                     ; a3 = delta-y for next location to check if current one is empty
   42957/   1E7D0 :                     ; a4 = pointer to angle buffer
   42958/   1E7D0 :                     ; returns relevant block ID in (a1)
   42959/   1E7D0 :                     ; returns distance in d1
   42960/   1E7D0 :                     ; returns angle in (a4)
   42961/   1E7D0 :                     
