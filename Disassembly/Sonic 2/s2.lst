   84042/   3E944 :                     ; 	a3	Location of output tiles for right pixels
   84043/   3E944 :                     ; Output:
   84044/   3E944 :                     ; 	a1	Pixel source after processed tiles
   84045/   3E944 :                     ; 	a2	Location of output tiles for left pixels after scaled tiles
   84046/   3E944 :                     ; 	a3	Location of output tiles for right pixels after scaled tiles
   84047/   3E944 :                     ;loc_3E944
