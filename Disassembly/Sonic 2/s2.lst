   83938/   3E89E :                     
   83939/   3E89E :                     ; ---------------------------------------------------------------------------
   83940/   3E89E :                     ; Subroutine to upscale graphics by a factor of 2x, based on given mappings
   83941/   3E89E :                     ; data for correct positioning of tiles.
   83942/   3E89E :                     ;
   83943/   3E89E :                     ; This code is awfully structured and planned: whenever a 3-column sprite piece
   83944/   3E89E :                     ; is scaled, it scales the next tiles that were copied to RAM as if the piece
   83945/   3E89E :                     ; had 4 columns; this will then be promptly overwritten by the next piece. If
   83946/   3E89E :                     ; this happens near the end of the buffer, you will get a buffer overrun.
   83947/   3E89E :                     ; Moreover, when the number of rows in the sprite piece is also 3 or 4, the code
   83948/   3E89E :                     ; will make an incorrect computation for the output of the next subpiece, which
   83949/   3E89E :                     ; causes the output to overwrite art from the previous subpiece. Thus, this code
   83950/   3E89E :                     ; fails if there is a 3x3 or a 3x4 sprite piece in the source mappings. Sadly,
   83951/   3E89E :                     ; this issue is basically unfixable without rewriting the code entirely.
   83952/   3E89E :                     ;
   83953/   3E89E :                     ; Input:
   83954/   3E89E :                     ; 	a1	Location of tiles to be enlarged
   83955/   3E89E :                     ; 	a2	Destination buffer for enlarged tiles
   83956/   3E89E :                     ; 	d0	Width-1 of sprite piece
   83957/   3E89E :                     ; 	d1	Height-1 of sprite piece
   83958/   3E89E :                     ; ---------------------------------------------------------------------------
   83959/   3E89E :                     
   83960/   3E89E :                     ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
   83961/   3E89E :                     
   83962/   3E89E :                     ;loc_3E89E
   83963/   3E89E :                     Scale_2x:
   83964/   3E89E : 3401                	move.w	d1,d2					; Copy piece height-1
   83965/   3E8A0 : 0242 0001           	andi.w	#1,d2					; Want only low bit -- this is 1 for Wx2 or Wx4 pieces, 0 otherwise
   83966/   3E8A4 : 5242                	addq.w	#1,d2					; Make it into 2 for Wx2 or Wx4 pieces, 1 otherwise
   83967/   3E8A6 : ED4A                	lsl.w	#6,d2					; This is now $80 (4 tiles) for Wx2 or Wx4 pieces, $40 (2 tiles) otherwise
   83968/   3E8A8 : 4842                	swap	d2						; Save it to high word
   83969/   3E8AA : 3601                	move.w	d1,d3					; Copy piece height-1 again
   83970/   3E8AC : E24B                	lsr.w	#1,d3					; This time, want high bit (1 for Wx3 or Wx4, 0 for Wx2 or Wx1)
   83971/   3E8AE : 5243                	addq.w	#1,d3					; Make it into 2 for Wx3 or Wx4 pieces, 1 otherwise
   83972/   3E8B0 : ED4B                	lsl.w	#6,d3					; This is now $80 (4 tiles) for Wx3 or Wx4 pieces, $40 (2 tiles) otherwise
   83973/   3E8B2 : 4843                	swap	d3						; Save it to high word
   83974/   3E8B4 : 6100 0014           	bsr.w	.upscale_part1				; Scale the first line???; sets a3 = ???, a5 = ???
   83975/   3E8B8 : 0800 0001           	btst	#1,d0					; Is this a 1xH or a 2xH piece?
   83976/   3E8BC : 6700 918A           	beq.w	return_37A48				; Return if yes
   83977/   3E8C0 : 0801 0001           	btst	#1,d1					; Is this a Wx3 or a Wx4 piece?
   83978/   3E8C4 : 6602                	bne.s	.set_dest				; Branch if yes
   83979/   3E8C6 : 2A4B                	movea.l	a3,a5					; Advance to next column instead
   83980/   3E8C8 :                     
   83981/   3E8C8 :                     .set_dest:
   83982/   3E8C8 : 244D                	movea.l	a5,a2					; Set new output location
   83983/   3E8CA :                     
   83984/   3E8CA :                     .upscale_part1:
   83985/   3E8CA : 284A                	movea.l	a2,a4					; Copy destination to a4
   83986/   3E8CC : 4842                	swap	d2					; Get height offset
   83987/   3E8CE : 47F2 2000           	lea	(a2,d2.w),a3				; Output location for next tile
   83988/   3E8D2 : 4842                	swap	d2					; Save height offset again
   83989/   3E8D4 : 3A01                	move.w	d1,d5					; Copy height-1
   83990/   3E8D6 : 0245 0001           	andi.w	#1,d5					; How many tiles we want to do-1 -- this is 1 for Wx2 or Wx4 pieces, 0 otherwise
   83991/   3E8DA : 6100 0068           	bsr.w	Scale2x_SingleTile
   83992/   3E8DE : 0801 0001           	btst	#1,d1					; Are we upscaling a Wx3 or Wx4 piece?
   83993/   3E8E2 : 6722                	beq.s	.done_cols				; Branch if not
   83994/   3E8E4 : 4842                	swap	d2					; Get height offset
   83995/   3E8E6 : 3802                	move.w	d2,d4					; Copy it to d4
   83996/   3E8E8 : 4842                	swap	d2					; Save height offset again
   83997/   3E8EA : D844                	add.w	d4,d4					; This is now $100 (8 tiles) for Wx4 pieces, $80 (4 tiles) for Wx3 pieces
   83998/   3E8EC : 3600                	move.w	d0,d3					; Copy piece width-1
   83999/   3E8EE : 0243 0001           	andi.w	#1,d3					; Want only low bit -- this is 1 for 2xH or 4xH pieces, 0 otherwise
   84000/   3E8F2 : E76C                	lsl.w	d3,d4					; This is now: $200 (16 tiles) for 2x4 or 4x4 pieces; $100 (8 tiles) for 2x3, 4x3, 1x4 or 3x4 pieces; $80 (4 tiles) for 1x3 or 3x3 pieces
   84001/   3E8F4 : D8C4                	adda.w	d4,a4					; Advance to this location
   84002/   3E8F6 : 3A01                	move.w	d1,d5					; Copy height-1
   84003/   3E8F8 : E24D                	lsr.w	#1,d5					; How many tiles we want to do-1 -- this is 1 for Wx4 pieces, 0 for Wx3 pieces
   84004/   3E8FA : 4843                	swap	d3					; Get height offset
   84005/   3E8FC : 4BF4 3000           	lea	(a4,d3.w),a5				; Output location for next tile
   84006/   3E900 : 4843                	swap	d3					; Save height offset again
   84007/   3E902 : 6100 0058           	bsr.w	Scale2x_SingleTile2
   84008/   3E906 :                     
   84009/   3E906 :                     .done_cols:
   84010/   3E906 : 0800 0000           	btst	#0,d0					; Is this a 1xH or 3xH piece?
   84011/   3E90A : 6606                	bne.s	.keep_upscaling				; Branch if not
   84012/   3E90C : 0800 0001           	btst	#1,d0					; Was this a single column piece?
   84013/   3E910 : 6730                	beq.s	.done					; Return if so
   84014/   3E912 :                     
   84015/   3E912 :                     .keep_upscaling:
   84016/   3E912 : 4842                	swap	d2					; Get height offset
   84017/   3E914 : 45F2 2000           	lea	(a2,d2.w),a2				; Output location for next tile
   84018/   3E918 : 47F2 2000           	lea	(a2,d2.w),a3				; Output location for next tile
   84019/   3E91C : 4842                	swap	d2					; Save height offset again
   84020/   3E91E : 3A01                	move.w	d1,d5					; Copy height-1
   84021/   3E920 : 0245 0001           	andi.w	#1,d5					; How many tiles we want to do -- this is 1 for Wx2 or Wx4 pieces, 0 otherwise
   84022/   3E924 : 6100 001E           	bsr.w	Scale2x_SingleTile
   84023/   3E928 : 0801 0001           	btst	#1,d1					; Are we upscaling a Wx3 or Wx4 piece?
   84024/   3E92C : 6714                	beq.s	.done					; Branch if not
   84025/   3E92E : 3A01                	move.w	d1,d5					; Copy height-1
   84026/   3E930 : E24D                	lsr.w	#1,d5					; How many tiles we want to do-1 -- this is 1 for Wx4 or Wx3 pieces, 0 otherwise
   84027/   3E932 : 4843                	swap	d3					; Get height offset
   84028/   3E934 : 49F4 3000           	lea	(a4,d3.w),a4				; Output location for next tile
   84029/   3E938 : 4BF4 3000           	lea	(a4,d3.w),a5				; Output location for next tile
   84030/   3E93C : 4843                	swap	d3					; Save height offset again
   84031/   3E93E : 6100 001C           	bsr.w	Scale2x_SingleTile2
   84032/   3E942 :                     
