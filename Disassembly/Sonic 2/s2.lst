   14484/    B55C :                     
   14485/    B55C :                      ; temporarily remap characters to credit text format
   14486/    B55C :                      ; let's encode 2-wide characters like Aa, Bb, Cc, etc. and hide it with a macro
   14487/    B55C :                      charset '@',"\x3B\2\4\6\8\xA\xC\xE\x10\x12\x13\x15\x17\x19\x1B\x1D\x1F\x21\x23\x25\x27\x29\x2B\x2D\x2F\x31\x33"
   14488/    B55C :                      charset 'a',"\3\5\7\9\xB\xD\xF\x11\x12\x14\x16\x18\x1A\x1C\x1E\x20\x22\x24\x26\x28\x2A\x2C\x2E\x30\x32\x34"
   14489/    B55C :                      charset '!',"\x3D\x39\x3F\x36"
   14490/    B55C :                      charset '\H',"\x39\x37\x38"
   14491/    B55C :                      charset '9',"\x3E\x40\x41"
   14492/    B55C :                      charset '1',"\x3C\x35"
   14493/    B55C :                      charset '.',"\x3A"
   14494/    B55C :                      charset ' ',0
   14495/    B55C :                     
   14496/    B55C :                      ; macro for defining credit text in conjunction with the remapped character set
   14497/    B55C : =$1                  vram_src := ArtTile_ArtNem_CreditText_CredScr
   14498/    B55C :                     creditText macro pal,ss
   14499/    B55C :                     	if ((vram_src & $FF) <> $0) && ((vram_src & $FF) <> $1)
   14500/    B55C :                     		fatal "The low byte of vram_src was $\{vram_src & $FF}, but it must be $00 or $01."
   14501/    B55C :                     	endif
   14502/    B55C :                     	dc.b (make_art_tile(vram_src,pal,0) & $FF00) >> 8
   14503/    B55C :                     	irpc char,ss
   14504/    B55C :                     	dc.b "char"
   14505/    B55C :                     	switch "char"
   14506/    B55C :                     	case "I"
   14507/    B55C :                     	case "1"
   14508/    B55C :                     		dc.b "!"
   14509/    B55C :                     	case "2"
   14510/    B55C :                     		dc.b "$"
   14511/    B55C :                     	case "9"
   14512/    B55C :                     		dc.b "#"
   14513/    B55C :                     	elsecase
   14514/    B55C :                     l := lowstring("char")
   14515/    B55C :                     		if l<>"char"
   14516/    B55C :                     			dc.b l
   14517/    B55C :                     		endif
   14518/    B55C :                     	endcase
   14519/    B55C :                     	endm
   14520/    B55C :                     	dc.b -1
   14521/    B55C :                     	rev02even
   14522/    B55C :                         endm
   14523/    B55C :                     
   14524/    B55C :                     ; credits text data (palette index followed by a string)
   14525/    B55C : =$1                  vram_src := ArtTile_ArtNem_CreditText_CredScr
