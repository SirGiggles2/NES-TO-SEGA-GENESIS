   35253/   19AB6 : 6124                	bsr.s	Solid_NotPushing
   35254/   19AB8 : 3806                	move.w	d6,d4
   35255/   19ABA : 0604 000D           	addi.b	#($10-p1_standing_bit+p1_touch_side_bit),d4
   35256/   19ABE : 09C6                	bset	d4,d6	; This sets bits 0 (Sonic) or 1 (Tails) of high word of d6
   35257/   19AC0 : 7801                	moveq	#1,d4	; return side collision
