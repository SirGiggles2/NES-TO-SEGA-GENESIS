   29624/   15FCC :                     
   29625/   15FCC :                     ; -------------------------------------------------------------------------------
   29626/   15FCC :                     ; This is THE place where each individual object's code gets called from
   29627/   15FCC :                     ; -------------------------------------------------------------------------------
   29628/   15FCC :                     
   29629/   15FCC :                     ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
   29630/   15FCC :                     
   29631/   15FCC :                     ; sub_15FCC:
   29632/   15FCC :                     RunObject:
   29633/   15FCC : 1010                	move.b	id(a0),d0	; get the object's ID
   29634/   15FCE : 670C                	beq.s	RunNextObject ; if it's obj00, skip it
   29635/   15FD0 :                     
   29636/   15FD0 : D040                	add.w	d0,d0
   29637/   15FD2 : D040                	add.w	d0,d0	; d0 = object ID * 4
   29638/   15FD4 : 227B 0032           	movea.l	Obj_Index-4(pc,d0.w),a1	; load the address of the object's code
   29639/   15FD8 : 4E91                	jsr	(a1)	; dynamic call! to one of the the entries in Obj_Index
   29640/   15FDA : 7000                	moveq	#0,d0
   29641/   15FDC :                     
   29642/   15FDC :                     ; loc_15FDC:
   29643/   15FDC :                     RunNextObject:
   29644/   15FDC : 41E8 0040           	lea	next_object(a0),a0 ; load 0bj address
   29645/   15FE0 : 51CF FFEA           	dbf	d7,RunObject
   29646/   15FE4 :                     ; return_15FE4:
   29647/   15FE4 :                     RunObjects_End:
   29648/   15FE4 : 4E75                	rts
