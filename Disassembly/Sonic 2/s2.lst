   72575/   3687A : 6710                	beq.s	AnimChk_Run		; if not, branch
   72576/   3687C : 1140 001D           	move.b	d0,prev_anim(a0)	; set previous animation to current animation
   72577/   36880 : 117C 0000 001B      	move.b	#0,anim_frame(a0)	; reset animation
   72578/   36886 : 117C 0000 001E      	move.b	#0,anim_frame_duration(a0)	; reset frame duration
