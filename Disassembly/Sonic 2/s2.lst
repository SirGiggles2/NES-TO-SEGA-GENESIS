   69397/   345FA :                     ; ----------------------------------------------------------------------------
   69398/   345FA :                     ; custom dynamic pattern loading cues for special stage Sonic, Tails and
   69399/   345FA :                     ; Tails' tails
   69400/   345FA :                     ; The first $12 frames are for Sonic, and the next $12 frames are for Tails.
   69401/   345FA :                     ; The last $15 frames are for Tails' tails.
   69402/   345FA :                     ; The first $24 frames are almost normal dplcs -- the only difference being
   69403/   345FA :                     ; that the art tile to load is pre-shifted left by 4 bits.
   69404/   345FA :                     ; The same applies to the last $15 frames, but they have yet another difference:
   69405/   345FA :                     ; a small space optimization. These frames only have one dplc per frame ever,
   69406/   345FA :                     ; hence the two-byte dplc count is removed from each frame.
   69407/   345FA :                     ; ----------------------------------------------------------------------------
   69408/   345FA :                     	pushv ,SonicDplcVer	; Backup previous value of SonicDplcVer
   69409/   345FA : =$4                  SonicDplcVer := 4		; Switch to custom DPLC format
   69410/   345FA :                     
   69411/   345FA : (MACRO)              Obj09_MapRUnc_345FA:	mappingsTable
   69411/   345FA : =$345FA              Obj09_MapRUnc_345FA label *
   69411/   345FA : =$345FA              .current_mappings_table := Obj09_MapRUnc_345FA
