   27154/   13CD4 :                     ; This macro declares data for an object. The data includes:
   27155/   13CD4 :                     ; - the initial routine counter (byte)
   27156/   13CD4 :                     ; - the initial mapping frame (byte)
   27157/   13CD4 :                     ; - the width of the object (byte)
   27158/   13CD4 :                     ; - the number of frames before it appears on screen (byte)
   27159/   13CD4 :                     ; - the X position where it starts and where it will go back (word)
   27160/   13CD4 :                     ; - the X position to reach (word)
   27161/   13CD4 :                     ; - the Y position (word)
   27162/   13CD4 :                     titlecardobjdata macro routine,frame,width,duration,xstart,xstop,y
   27163/   13CD4 :                     	dc.b routine,frame,width,duration
   27164/   13CD4 :                     	dc.w xstart,xstop,y
   27165/   13CD4 :                         endm
