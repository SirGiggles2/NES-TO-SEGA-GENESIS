(1) 1060/     359 :                     ; This the note -> frequency setting lookup
(1) 1061/     359 :                     ; the same array is found at $729CE in Sonic 1, and at $C9C44 in Ristar
(1) 1062/     359 :                     ; zword_359:
(1) 1063/     359 : (MACRO)              	ensure1byteoffset 8Ch
(1) 1064/     359 :                     zPSGFrequencies:
(1) 1065/     359 :                     	; 6 octaves, each one begins with C and ends with B, with
(1) 1066/     359 :                     	; the exception of the final octave, which ends at A-flat.
(1) 1067/     359 :                     	; The last octave's final note is set to the PSG's maximum
(1) 1068/     359 :                     	; frequency. This is typically used by the noise channel to
(1) 1069/     359 :                     	; create a sound that is similar to a hi-hat.
(1) 1070/     359 : (MACRO)              	zMakePSGFrequencies  130.98,    138.78,    146.99,    155.79,    165.22,    174.78,    185.19,    196.24,    207.91,    220.63,    233.52,    247.47
(1) 1070/     359 :                                     irp op,130.98,138.78,146.99,155.79,165.22,174.78,185.19,196.24,207.91,220.63,233.52,247.47
(1) 1070/     359 :                                             dw zMakePSGFrequency(op)
