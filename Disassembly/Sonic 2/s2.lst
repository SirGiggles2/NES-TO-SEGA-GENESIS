   88213/   41D2E :                     ; macro for a debug object list header
   88214/   41D2E :                     ; must be on the same line as a label that has a corresponding _End label later
   88215/   41D2E :                     dbglistheader macro {INTLABEL}
   88216/   41D2E :                     __LABEL__ label *
   88217/   41D2E :                     	dc.w ((__LABEL___End - __LABEL__ - 2) / 8)
   88218/   41D2E :                         endm
   88219/   41D2E :                     
   88220/   41D2E :                     ; macro to define debug list object data
   88221/   41D2E :                     dbglistobj macro   obj, mapaddr, subtype, frame, vram
   88222/   41D2E :                     	dc.l obj<<24|mapaddr
   88223/   41D2E :                     	dc.b subtype,frame
   88224/   41D2E :                     	dc.w vram
   88225/   41D2E :                         endm
   88226/   41D2E :                     
   88227/   41D2E : (MACRO)              DbgObjList_Def: dbglistheader
   88227/   41D2E : =$41D2E              DbgObjList_Def label *
   88227/   41D2E : 0002                        dc.w ((DbgObjList_Def_End - DbgObjList_Def - 2) / 8)
