   77803/   3A24E : 3200                	move.w	d0,d1
   77804/   3A250 :                     	; Depending on the exact location (and size) of the art being used,
   77805/   3A250 :                     	; you may encounter an overflow in the original code which garbles
   77806/   3A250 :                     	; the enlarged Sonic. The following code fixes this:
   77812/   3A250 : 0240 0FFF           	andi.w	#$FFF,d0
   77813/   3A254 : EB48                	lsl.w	#5,d0
   77814/   3A256 : 49F3 0000           	lea	(a3,d0.w),a4 ; source ROM address of tiles to copy
   77816/   3A25A : 0241 F000           	andi.w	#$F000,d1 ; abcd000000000000
   77817/   3A25E : E959                	rol.w	#4,d1	  ; (this calculation can be done smaller and faster
   77818/   3A260 : 5241                	addq.w	#1,d1	  ; by doing rol.w #7,d1 addq.w #7,d1
   77819/   3A262 : E749                	lsl.w	#3,d1	  ; instead of these 4 lines)
   77820/   3A264 : 5341                	subq.w	#1,d1	  ; 000000000abcd111 ; number of dwords to copy minus 1
   77821/   3A266 : 2ADC                -	move.l	(a4)+,(a5)+
   77822/   3A268 : 51C9 FFFC           	dbf	d1,- ; copy all of the pixels in this piece into the temp buffer
   77823/   3A26C : 51CE FFDE           	dbf	d6,-- ; loop per piece in the frame
   77824/   3A270 : 51CD FFD4           	dbf	d5,--- ; loop per mapping frame
   77825/   3A274 :                     
   77826/   3A274 :                     	; this scales up the tiles by 2
   77827/   3A274 :                     ;ScaleUpSpriteTiles:
   77828/   3A274 : 3F07                	move.w	d7,-(sp)
   77829/   3A276 : 7000                	moveq	#0,d0
   77830/   3A278 : 7200                	moveq	#0,d1
   77831/   3A27A : 4DFA 0028           	lea	SonicRunningSpriteScaleData(pc),a6
   77832/   3A27E : 7E07                	moveq	#4*2-1,d7 ; there are 4 sprite mapping frames with 2 pieces each
   77833/   3A280 : 225E                -	movea.l	(a6)+,a1 ; source in RAM of tile graphics to enlarge
   77834/   3A282 : 245E                	movea.l	(a6)+,a2 ; destination in RAM of enlarged graphics
   77835/   3A284 : 101E                	move.b	(a6)+,d0 ; width of the sprite piece to enlarge (minus 1)
   77836/   3A286 : 121E                	move.b	(a6)+,d1 ; height of the sprite piece to enlarge (minus 1)
