    1636/    140E :                     ; Subroutine to transfer a plane map to VRAM
    1637/    140E :                     ; ---------------------------------------------------------------------------
    1638/    140E :                     
    1639/    140E :                     ; control register:
    1640/    140E :                     ;    CD1 CD0 A13 A12 A11 A10 A09 A08     (D31-D24)
    1641/    140E :                     ;    A07 A06 A05 A04 A03 A02 A01 A00     (D23-D16)
    1642/    140E :                     ;     ?   ?   ?   ?   ?   ?   ?   ?      (D15-D8)
    1643/    140E :                     ;    CD5 CD4 CD3 CD2  ?   ?  A15 A14     (D7-D0)
    1644/    140E :                     ;
    1645/    140E :                     ;	A00-A15 - address
    1646/    140E :                     ;	CD0-CD3 - code
    1647/    140E :                     ;	CD4 - 1 if VRAM copy DMA mode. 0 otherwise.
    1648/    140E :                     ;	CD5 - DMA operation
    1649/    140E :                     ;
    1650/    140E :                     ;	Bits CD3-CD0:
    1651/    140E :                     ;	0000 - VRAM read
    1652/    140E :                     ;	0001 - VRAM write
    1653/    140E :                     ;	0011 - CRAM write
    1654/    140E :                     ;	0100 - VSRAM read
    1655/    140E :                     ;	0101 - VSRAM write
    1656/    140E :                     ;	1000 - CRAM read
    1657/    140E :                     ;
    1658/    140E :                     ; d0 = control register
    1659/    140E :                     ; d1 = width
    1660/    140E :                     ; d2 = heigth
    1661/    140E :                     ; a1 = source address
    1662/    140E :                     
    1663/    140E :                     ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
