   69412/   345FA : 0072                        dc.w .sonic_0-.current_mappings_table
   69413/   345FC : (MACRO)              	mappingsTableEntry.w	.sonic_1
   69413/   345FC : 007A                        dc.w .sonic_1-.current_mappings_table
   69414/   345FE : (MACRO)              	mappingsTableEntry.w	.sonic_2
   69414/   345FE : 0082                        dc.w .sonic_2-.current_mappings_table
   69415/   34600 : (MACRO)              	mappingsTableEntry.w	.sonic_3
   69415/   34600 : 008A                        dc.w .sonic_3-.current_mappings_table
   69416/   34602 : (MACRO)              	mappingsTableEntry.w	.sonic_4
