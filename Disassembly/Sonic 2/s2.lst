   18963/    DDA8 : 7C02                	moveq	#3-1,d6
   18964/    DDAA : 6100 015A           	bsr.w	DrawBlockColumn.CustomHeight
   18965/    DDAE :                     +
   18966/    DDAE : 0892 0001           	bclr	#scroll_flag_bg3_right,(a2)
   18967/    DDB2 : 671A                	beq.s	+
   18968/    DDB4 : 383C 0040           	move.w	#block_height*4,d4	; Y offset (relative to camera)
   18969/    DDB8 : 3A3C 0140           	move.w	#screen_width,d5	; X offset (relative to camera)
   18970/    DDBC : 6100 04C8           	bsr.w	CalculateVRAMAddressOfBlockForPlayer1
   18971/    DDC0 : 383C 0040           	move.w	#block_height*4,d4	; Y offset (relative to camera)
   18972/    DDC4 : 3A3C 0140           	move.w	#screen_width,d5	; X offset (relative to camera)
   18973/    DDC8 : 7C02                	moveq	#3-1,d6
   18974/    DDCA : 6100 013A           	bsr.w	DrawBlockColumn.CustomHeight
