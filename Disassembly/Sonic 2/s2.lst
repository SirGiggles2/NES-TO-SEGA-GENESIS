   35135/   199E8 :                     ; loc_199E8: SolidObject_cont:
   35136/   199E8 :                     SolidObject_OnScreenTest:
   35137/   199E8 :                     	; If the object is not on-screen, then don't try to collide with it.
   35138/   199E8 :                     	; This is presumably an optimisation, but this means that if Sonic
   35139/   199E8 :                     	; outruns the screen then he can phase through solid objects.
   35140/   199E8 : (MACRO)              	_btst	#render_flags.on_screen,render_flags(a0)
   35140/   199E8 : =$1                  last_btst_converted := ~~chkop("#render_flags.on_screen","#render_flags.on_screen") || ~~chkop("#render_flags.on_screen","#status.npc.no_balancing") || ~~chkop("#render_flags.on_screen","#status_secondary.sliding")
   35140/   199E8 :                     
   35140/   199E8 : 4A28 0001                           tst.b   render_flags(a0)
   35141/   199EC : (MACRO)              	_beq.w	SolidObject_TestClearPush
   35141/   199EC : 6A00 00D6                           bpl.w   SolidObject_TestClearPush
   35142/   199F0 :                     ;loc_199F0:
   35143/   199F0 :                     SolidObject_cont:
   35144/   199F0 :                     	; We now perform the X portion of a bounding box check. To do this, we assume a
   35145/   199F0 :                     	; coordinate system where the X origin is at the object's left edge.
   35146/   199F0 : 3029 0008           	move.w	x_pos(a1),d0			; load Sonic's X position...
   35147/   199F4 : 9068 0008           	sub.w	x_pos(a0),d0			; ...and calculate his x position relative to the object.
   35148/   199F8 : D041                	add.w	d1,d0				; Put object's left edge at (0,0).  This is also Sonic's distance to the object's left edge.
   35149/   199FA : 6B00 00C8           	bmi.w	SolidObject_TestClearPush	; Branch if Sonic is outside the object's left edge.
   35150/   199FE : 3601                	move.w	d1,d3
   35151/   19A00 : D643                	add.w	d3,d3				; Calculate object's width.
   35152/   19A02 : B043                	cmp.w	d3,d0
   35153/   19A04 : 6200 00BE           	bhi.w	SolidObject_TestClearPush	; Branch if Sonic is outside the object's right edge.
   35154/   19A08 :                     	; We now perform the y portion of a bounding box check. To do this, we assume a
   35155/   19A08 :                     	; coordinate system where the y origin is at the highest y position relative to the object
   35156/   19A08 :                     	; at which Sonic would still collide with it.  This point is
   35157/   19A08 :                     	;   y_pos(object) - width(object)/2 - y_radius(Sonic) - 4,
   35158/   19A08 :                     	; where object is stored in (a0), Sonic in (a1), and height(object)/2 in d2.  This way
   35159/   19A08 :                     	; of doing it causes the object's hitbox to be vertically off-center by -4 pixels.
   35160/   19A08 : 1629 0016           	move.b	y_radius(a1),d3			; load Sonic's Y radius.
   35161/   19A0C : 4883                	ext.w	d3
   35162/   19A0E : D443                	add.w	d3,d2				; Calculate maximum distance for a top collision.
   35163/   19A10 : 3629 000C           	move.w	y_pos(a1),d3			; load Sonic's y position...
   35164/   19A14 : 9668 000C           	sub.w	y_pos(a0),d3			; ...and calculate his y position relative to the object.
   35165/   19A18 : 5843                	addq.w	#4,d3				; Assume a slightly lower position for Sonic.
   35166/   19A1A : D642                	add.w	d2,d3				; Make the highest position where Sonic would still be colliding with the object (0,0).
   35167/   19A1C : 6B00 00A6           	bmi.w	SolidObject_TestClearPush	; Branch if Sonic is above this point.
   35168/   19A20 : 0243 07FF           	andi.w	#$7FF,d3
   35169/   19A24 : 3802                	move.w	d2,d4
   35170/   19A26 : D844                	add.w	d4,d4				; Calculate minimum distance for a bottom collision.
   35171/   19A28 : B644                	cmp.w	d4,d3
   35172/   19A2A : 6400 0098           	bhs.w	SolidObject_TestClearPush	; Branch if Sonic is below this point.
   35173/   19A2E :                     ;loc_19A2E:
   35174/   19A2E :                     SolidObject_ChkBounds:
   35175/   19A2E : 4A29 002A           	tst.b	obj_control(a1)
   35176/   19A32 : 6B00 0090           	bmi.w	SolidObject_TestClearPush	; Branch if object collisions are disabled for Sonic.
   35177/   19A36 : 0C29 0006 0024      	cmpi.b	#6,routine(a1)			; Is Sonic dead?
   35178/   19A3C : 6400 00AC           	bhs.w	SolidObject_NoCollision		; If yes, branch.
   35179/   19A40 : 4A78 FE08           	tst.w	(Debug_placement_mode).w
   35180/   19A44 : 6600 00A4           	bne.w	SolidObject_NoCollision		; Branch if in Debug Mode.
   35181/   19A48 :                     
   35182/   19A48 : 3A00                	move.w	d0,d5
   35183/   19A4A : B240                	cmp.w	d0,d1
   35184/   19A4C : 6408                	bhs.s	.isToTheLeft		; Branch if Sonic is to the object's left.
   35185/   19A4E :                     
   35186/   19A4E :                     ;.isToTheRight:
   35187/   19A4E : D241                	add.w	d1,d1
   35188/   19A50 : 9041                	sub.w	d1,d0
   35189/   19A52 : 3A00                	move.w	d0,d5			; Calculate Sonic's distance to the object's right edge...
   35190/   19A54 : 4445                	neg.w	d5			; ...and calculate the absolute value.
   35191/   19A56 :                     
   35192/   19A56 :                     .isToTheLeft:
   35193/   19A56 : 3203                	move.w	d3,d1
   35194/   19A58 : B443                	cmp.w	d3,d2
   35195/   19A5A : 6408                	bhs.s	.isAbove
   35196/   19A5C :                     
   35197/   19A5C :                     ;.isBelow:
   35198/   19A5C : 5943                	subq.w	#4,d3
   35199/   19A5E : 9644                	sub.w	d4,d3
   35200/   19A60 : 3203                	move.w	d3,d1
   35201/   19A62 : 4441                	neg.w	d1
   35202/   19A64 :                     
   35203/   19A64 :                     .isAbove:
   35204/   19A64 :                     	; Now...
   35205/   19A64 :                     	; 'd0' contains Sonic's distance to the nearest object horizontal edge.
   35206/   19A64 :                     	; 'd5' contains the absolute version of 'd0'.
   35207/   19A64 :                     	; 'd3' contains Sonic's distance to the nearest object vertical edge.
   35208/   19A64 :                     	; 'd1' contains the absolute version of 'd3'.
   35209/   19A64 : BA41                	cmp.w	d1,d5
   35210/   19A66 : 6200 0086           	bhi.w	SolidObject_TopBottom		; Branch, if horizontal distance is greater than vertical distance.
   35211/   19A6A :                     ; loc_19A6A:
   35212/   19A6A :                     SolidObject_LeftRight:
   35213/   19A6A :                     	; If Sonic is extremely close to the top or bottom, then branch.
   35214/   19A6A :                     	; I guess the point of this is to let Sonic walk over objects that
   35215/   19A6A :                     	; are barely poking out of the ground?
   35216/   19A6A : 0C41 0004           	cmpi.w	#4,d1
   35217/   19A6E : 6346                	bls.s	SolidObject_SideAir
   35218/   19A70 :                     
   35219/   19A70 : 4A40                	tst.w	d0			; Where is Sonic?
   35220/   19A72 : 671C                	beq.s	SolidObject_AtEdge	; If at the object's edge, branch
   35221/   19A74 : 6B08                	bmi.s	SolidObject_InsideRight	; If in the right side of the object, branch
   35222/   19A76 :                     
