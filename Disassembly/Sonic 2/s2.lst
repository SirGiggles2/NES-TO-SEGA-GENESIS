   12871/    9746 :                     ; loc_9746:
   12872/    9746 :                     CheckCheats:	; This is called from 2 places: the options screen and the level select screen
   12873/    9746 : 3038 FFD4           	move.w	(Correct_cheat_entries).w,d0	; Get the number of correct sound IDs entered so far
   12874/    974A : D0C0                	adda.w	d0,a0				; Skip to the next entry
