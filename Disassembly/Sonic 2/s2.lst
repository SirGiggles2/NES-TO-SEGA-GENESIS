    8692/    643E :                     
    8693/    643E :                     ; ===========================================================================
    8694/    643E :                     ; pointers to the mappings for each frame of the special stage track
    8695/    643E :                     ; indexed into by the numbers used in the above animations
    8696/    643E :                     ;
    8697/    643E :                     ; Format of each mappings file:
    8698/    643E :                     ;	File is divided in 3 segments, with the same structure:
    8699/    643E :                     ;	Segment structure:
    8700/    643E :                     ;		4-byte unsigned length of segment (not counting the 4 bytes used for length);
    8701/    643E :                     ;		the first 2 bytes of each length is ignored, and only the last 2 bytes are
    8702/    643E :                     ;		actually used.
    8703/    643E :                     ;		Rest of the segment is mappings data, as follows:
    8704/    643E :                     ;	1st segment:
    8705/    643E :                     ;		Mappings data is a bitstream indicating whether to draw a single tile at
    8706/    643E :                     ;		a time using the uncompressed mappings (see 2nd segment) or a sequence of
    8707/    643E :                     ;		tiles using the RLE mappings (see 3rd segment).
    8708/    643E :                     ;	2nd segment:
    8709/    643E :                     ;		Mappings data is a bitstream: the first bit in each cycle determines how
    8710/    643E :                     ;		many bits from the stream are to be used as an index to the uncompressed
    8711/    643E :                     ;		pattern name list SSPNT_UncLUT: if the first bit is set, 10 bits form an
    8712/    643E :                     ;		index into SSPNT_UncLUT_Part2, otherwise 6 bits are used as an index into
    8713/    643E :                     ;		SSPNT_UncLUT.
    8714/    643E :                     ;		These tiles are drawn in palette line 3.
    8715/    643E :                     ;	3nd segment:
    8716/    643E :                     ;		Mappings data is a bitstream: the first bit in each cycle determines how
    8717/    643E :                     ;		many bits from the stream are to be used as an index to the RLE-compressed
    8718/    643E :                     ;		pattern name list SSPNT_RLELUT: if the first bit is set, 7 bits form an
    8719/    643E :                     ;		index into SSPNT_RLELUT_Part2, otherwise 6 bits are used as an index into
    8720/    643E :                     ;		SSPNT_RLELUT.
    8721/    643E :                     ;		These tiles are drawn in palette line 3, with the high priority bit set.
    8722/    643E :                     ; off_643E:
    8723/    643E :                     Map_SpecialStageTrack:
    8724/    643E : 000C A904           	dc.l MapSpec_Rise1		;   0
    8725/    6442 : 000C ADA8           	dc.l MapSpec_Rise2		;   1
    8726/    6446 : 000C B376           	dc.l MapSpec_Rise3		;   2
    8727/    644A : 000C B92E           	dc.l MapSpec_Rise4		;   3
    8728/    644E : 000C BF92           	dc.l MapSpec_Rise5		;   4
    8729/    6452 : 000C C5BE           	dc.l MapSpec_Rise6		;   5
    8730/    6456 : 000C CC7A           	dc.l MapSpec_Rise7		;   6
    8731/    645A : 000C D282           	dc.l MapSpec_Rise8		;   7
    8732/    645E : 000C D7C0           	dc.l MapSpec_Rise9		;   8
    8733/    6462 : 000C DD44           	dc.l MapSpec_Rise10		;   9
    8734/    6466 : 000C E2BE           	dc.l MapSpec_Rise11		;  $A
    8735/    646A : 000C E7DE           	dc.l MapSpec_Rise12		;  $B
    8736/    646E : 000C EC52           	dc.l MapSpec_Rise13		;  $C
    8737/    6472 : 000C F0BC           	dc.l MapSpec_Rise14		;  $D	; This may flip the special stage's horizontal orientation
    8738/    6476 : 000C F580           	dc.l MapSpec_Rise15		;  $E
