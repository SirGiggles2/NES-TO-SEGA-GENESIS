   90319/   A4204 :                     ArtKos_OOZ:	BINCLUDE	"art/kosinski/OOZ.kos"
   90320/   A6834 :                     BM128_OOZ:	BINCLUDE	"mappings/128x128/OOZ.kos"
   90321/   A8D04 :                     
