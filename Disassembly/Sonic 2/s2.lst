   84054/   3E94C : 6100 0050           	bsr.w	Scale_2x_RightPixels			; Upscale pixels 4-7 of current row
   84055/   3E950 : 584B                	addq.w	#4,a3					; Advance write destination by one row (8 pixels)
   84056/   3E952 : 51CE FFF2           	dbf	d6,.loop
