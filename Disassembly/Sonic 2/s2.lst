   29072/   15832 :                     
   29073/   15832 :                      ; temporarily remap characters to title card letter format
   29074/   15832 :                      ; Characters are encoded as Aa, Bb, Cc, etc. through a macro
   29075/   15832 :                      charset 'A',0	; can't have an embedded 0 in a string
   29076/   15832 :                      charset 'B',"\4\8\xC\4\x10\x14\x18\x1C\x1E\x22\x26\x2A\4\4\x30\x34\x38\x3C\x40\x44\x48\x4C\x52\x56\4"
   29077/   15832 :                      charset 'a',"\4\4\4\4\4\4\4\4\2\4\4\4\6\4\4\4\4\4\4\4\4\4\6\4\4"
   29078/   15832 :                      charset '.',"\x5A"
   29079/   15832 :                     
   29080/   15832 :                     ; Defines which letters load for the continue screen
   29081/   15832 :                     ; Each letter occurs only once, and the letters ENOZ (i.e. ZONE) aren't loaded here
   29082/   15832 :                     ; However, this is hidden by the titleLetters macro, and normal titles can be used
   29083/   15832 :                     ; (the macro is defined near SpecialStage_ResultsLetters, which uses it before here)
   29084/   15832 :                     ; The actual mappings for zone title cards are found at MapUnc_TitleCards
   29085/   15832 :                     
   29086/   15832 :                     ; word_15832:
   29087/   15832 :                     TitleCardLetters:
   29088/   15832 :                     
   29089/   15832 :                     TitleCardLetters_EHZ:
   29090/   15832 : (MACRO)              	titleLetters	"EMERALD HILL"
   29090/   15832 :                          ;  ". ZYXWVUTSRQPONMLKJIHGFEDCBA"
   29090/   15832 : =$6006010            used := %0110000000000110000000010000   ; set to initial state
   29090/   15832 :                         irpc char,"EMERALD HILL"
   29090/   15832 :                             if ~~(used&1<<strstr(llookup,"char"))   ; has the letter been used already?
   29090/   15832 :                     used := used|1<<strstr(llookup,"char")  ; if not, mark it as used
   29090/   15832 :                             dc.b "char"                     ; output letter code
   29090/   15832 :                             if "char"=="."
   29090/   15832 :                             dc.b 2                  ; output character size
   29090/   15832 :                             else
   29090/   15832 :                             dc.b lowstring("char")  ; output letter size
   29090/   15832 :                             endif
   29090/   15832 :                             endif
   29090/   15832 :                         endm
   29090/   15832 : =$6007010            used := used|1<<strstr(llookup,"M")  ; if not, mark it as used
   29090/   15832 : 2A                          dc.b "M"                     ; output letter code
   29090/   15833 : 06                          dc.b lowstring("M")  ; output letter size
   29090/   15834 : =$6027010            used := used|1<<strstr(llookup,"R")  ; if not, mark it as used
   29090/   15834 : 38                          dc.b "R"                     ; output letter code
   29090/   15835 : 04                          dc.b lowstring("R")  ; output letter size
   29090/   15836 : =$6027011            used := used|1<<strstr(llookup,"A")  ; if not, mark it as used
   29090/   15836 : 00                          dc.b "A"                     ; output letter code
   29090/   15837 : 04                          dc.b lowstring("A")  ; output letter size
   29090/   15838 : =$6027811            used := used|1<<strstr(llookup,"L")  ; if not, mark it as used
   29090/   15838 : 26                          dc.b "L"                     ; output letter code
   29090/   15839 : 04                          dc.b lowstring("L")  ; output letter size
   29090/   1583A : =$6027819            used := used|1<<strstr(llookup,"D")  ; if not, mark it as used
   29090/   1583A : 0C                          dc.b "D"                     ; output letter code
   29090/   1583B : 04                          dc.b lowstring("D")  ; output letter size
   29090/   1583C : =$6027899            used := used|1<<strstr(llookup,"H")  ; if not, mark it as used
   29090/   1583C : 18                          dc.b "H"                     ; output letter code
   29090/   1583D : 04                          dc.b lowstring("H")  ; output letter size
   29090/   1583E : =$6027999            used := used|1<<strstr(llookup,"I")  ; if not, mark it as used
   29090/   1583E : 1C                          dc.b "I"                     ; output letter code
   29090/   1583F : 02                          dc.b lowstring("I")  ; output letter size
   29090/   15840 : FFFF                        dc.w $FFFF      ; output string terminator
