(1) 4047/    12E8 :                     
(1) 4048/    12E8 :                     
(1) 4049/    12E8 :                     ; This is an ugly countdown to zero implemented in repeatedly modifying code!!
(1) 4050/    12E8 :                     ; But basically, it starts at the full length of the song +1 (so it can decrement)
(1) 4051/    12E8 :                     ; and waits until 'hl' decrements to zero
(1) 4052/    12E8 :                     ; zsub_12E8
(1) 4053/    12E8 :                     zDecEndOrGetByte:
(1) 4054/    12E8 : 21 00 00            	ld	hl,0			; Self-modified code: starts at full length of song +1, waits until it gets to 1...
(1) 4060/    12EB : 2B                  	dec	hl			; ...where this will be zero
(1) 4061/    12EC : 22 E9 12            	ld	(zDecEndOrGetByte+1),hl	; Self-modified code: update the count in case it's not zero
(1) 4063/    12EF : 7C                  	ld	a,h
(1) 4064/    12F0 : B5                  	or	l
(1) 4065/    12F1 : 28 09               	jr	z,zDecEnd		; If 'h' and 'l' both equal zero, we quit!!
(1) 4067/    12F3 :                     
(1) 4068/    12F3 :                     ; zloc_12F3
(1) 4069/    12F3 :                     zGetNextByte:
(1) 4070/    12F3 : 21 00 00            	ld	hl,0			; Self-modified code: get address of next compressed byte
(1) 4071/    12F6 : 7E                  	ld	a,(hl)			; put it into -> 'a'
(1) 4072/    12F7 : 23                  	inc	hl			; next byte...
(1) 4073/    12F8 : 22 F4 12            	ld	(zGetNextByte+1),hl	; change inst @ zGetNextByte so it loads next compressed byte
(1) 4074/    12FB : C9                  	ret				; still going...
(1) 4075/    12FC :                     
(1) 4076/    12FC :                     ; zloc_12FC
(1) 4077/    12FC :                     zDecEnd:
(1) 4078/    12FC : E1                  	pop	hl			; throws away return address to this function call so that next 'ret' exits decompressor (we're done!)
(1) 4079/    12FD : C9                  	ret				; Exit decompressor
(1) 4080/    12FE :                     ; End of function zDecEndOrGetByte
