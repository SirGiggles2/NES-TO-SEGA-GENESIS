   85738/   3FF94 :                     ; ZONE ANIMATION SCRIPTS
   85739/   3FF94 :                     ;
   85740/   3FF94 :                     ; The Dynamic_Normal subroutine uses these scripts to reload certain tiles,
   85741/   3FF94 :                     ; thus animating them. All the relevant art must be uncompressed, because
   85742/   3FF94 :                     ; otherwise the subroutine would spend so much time waiting for the art to be
   85743/   3FF94 :                     ; decompressed that the VBLANK window would close before all the animating was done.
   85744/   3FF94 :                     
   85745/   3FF94 :                     ;    zoneanimdecl -1, ArtUnc_Flowers1, ArtTile_ArtUnc_Flowers1, 6, 2
   85746/   3FF94 :                     ;	-1			Global frame duration. If -1, then each frame will use its own duration, instead
   85747/   3FF94 :                     ;	ArtUnc_Flowers1		Source address
   85748/   3FF94 :                     ;	ArtTile_ArtUnc_Flowers1	Destination VRAM address
   85749/   3FF94 :                     ;	6			Number of frames
   85750/   3FF94 :                     ;	2			Number of tiles to load into VRAM for each frame
   85751/   3FF94 :                     
   85752/   3FF94 :                     ;    dc.b   0,$7F		; Start of the script proper
   85753/   3FF94 :                     ;	0			Tile ID of first tile in ArtUnc_Flowers1 to transfer
   85754/   3FF94 :                     ;	$7F			Frame duration. Only here if global duration is -1
