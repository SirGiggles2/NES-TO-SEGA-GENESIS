   29982/   163AC :                     ; Subroutine translating object speed to update object position
   29983/   163AC :                     ; This moves the object horizontally and vertically
   29984/   163AC :                     ; but does not apply gravity to it
   29985/   163AC :                     ; ---------------------------------------------------------------------------
   29986/   163AC :                     
