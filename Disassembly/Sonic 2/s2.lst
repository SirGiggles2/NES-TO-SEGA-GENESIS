    3963/    3390 :                     ; Subroutine to generate a pseudo-random number in d0
    3964/    3390 :                     ; d0 = (RNG & $FFFF0000) | ((RNG*41 & $FFFF) + ((RNG*41 & $FFFF0000) >> 16))
    3965/    3390 :                     ; RNG = ((RNG*41 + ((RNG*41 & $FFFF) << 16)) & $FFFF0000) | (RNG*41 & $FFFF)
    3966/    3390 :                     ; ---------------------------------------------------------------------------
    3967/    3390 :                     
    3968/    3390 :                     ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
    3969/    3390 :                     
    3970/    3390 :                     ; sub_3390:
    3971/    3390 :                     RandomNumber:
    3972/    3390 : 2238 F636           	move.l	(RNG_seed).w,d1
    3973/    3394 : 6606                	bne.s	.afterSanity0ResetCheck
    3974/    3396 : 223C 2A6D 365A      	move.l	#$2A6D365A,d1 ; if the RNG is 0, reset it to this crazy number
    3975/    339C :                     
    3976/    339C :                     	; set the high word of d0 to be the high word of the RNG
    3977/    339C :                     	; and multiply the RNG by 41
    3978/    339C :                     .afterSanity0ResetCheck:
    3979/    339C : 2001                	move.l	d1,d0
    3980/    339E : E581                	asl.l	#2,d1
    3981/    33A0 : D280                	add.l	d0,d1
    3982/    33A2 : E781                	asl.l	#3,d1
    3983/    33A4 : D280                	add.l	d0,d1
    3984/    33A6 :                     
    3985/    33A6 :                     	; add the low word of the RNG to the high word of the RNG
    3986/    33A6 :                     	; and set the low word of d0 to be the result
    3987/    33A6 : 3001                	move.w	d1,d0
    3988/    33A8 : 4841                	swap	d1
    3989/    33AA : D041                	add.w	d1,d0
    3990/    33AC : 3200                	move.w	d0,d1
    3991/    33AE : 4841                	swap	d1
    3992/    33B0 :                     
    3993/    33B0 : 21C1 F636           	move.l	d1,(RNG_seed).w
    3994/    33B4 : 4E75                	rts
    3995/    33B6 :                     ; End of function RandomNumber
    3996/    33B6 :                     
    3997/    33B6 :                     
    3998/    33B6 :                     ; ---------------------------------------------------------------------------
    3999/    33B6 :                     ; Subroutine to calculate sine and cosine of an angle
    4000/    33B6 :                     ; d0 = input byte = angle (360 degrees == 256)
    4001/    33B6 :                     ; d0 = output word = 255 * sine(angle)
    4002/    33B6 :                     ; d1 = output word = 255 * cosine(angle)
    4003/    33B6 :                     ; ---------------------------------------------------------------------------
    4004/    33B6 :                     
    4005/    33B6 :                     ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
    4006/    33B6 :                     
    4007/    33B6 :                     ; sub_33B6:
    4008/    33B6 :                     CalcSine:
    4009/    33B6 : 0240 00FF           	andi.w	#$FF,d0
    4010/    33BA : D040                	add.w	d0,d0
    4011/    33BC : 0640 0080           	addi.w	#$80,d0	; $40 = 90 degrees, sin(x+90) = cos(x)
    4012/    33C0 : 323B 000C           	move.w	Sine_Data(pc,d0.w),d1 ; cos
    4013/    33C4 : 0440 0080           	subi.w	#$80,d0
    4014/    33C8 : 303B 0004           	move.w	Sine_Data(pc,d0.w),d0 ; sin
    4015/    33CC : 4E75                	rts
    4016/    33CE :                     ; End of function CalcSine
    4017/    33CE :                     
    4018/    33CE :                     ; ===========================================================================
    4019/    33CE :                     ; word_33CE:
    4020/    33CE :                     Sine_Data:	BINCLUDE	"misc/sinewave.bin"
    4021/    364E :                     
    4022/    364E :                     
    4023/    364E :                     ; ---------------------------------------------------------------------------
    4024/    364E :                     ; Subroutine to calculate arctangent of y/x
    4025/    364E :                     ; d1 = input x
    4026/    364E :                     ; d2 = input y
    4027/    364E :                     ; d0 = output angle (360 degrees == 256)
    4028/    364E :                     ; ---------------------------------------------------------------------------
    4029/    364E :                     
    4030/    364E :                     ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
    4031/    364E :                     
    4032/    364E :                     ; sub_364E:
    4033/    364E :                     CalcAngle:
    4034/    364E : 48E7 1800           	movem.l	d3-d4,-(sp)
    4035/    3652 : 7600                	moveq	#0,d3
    4036/    3654 : 7800                	moveq	#0,d4
    4037/    3656 : 3601                	move.w	d1,d3
    4038/    3658 : 3802                	move.w	d2,d4
    4039/    365A : 8843                	or.w	d3,d4
    4040/    365C : 674C                	beq.s	CalcAngle_Zero ; special case return if x and y are both 0
    4041/    365E : 3802                	move.w	d2,d4
    4042/    3660 :                     
    4043/    3660 : (MACRO)              	absw.w	d3	; calculate absolute value of x
    4043/    3660 : 4A43                        tst.w   d3
    4043/    3662 : 6A00 0004                   bpl.w   .skip
