   42904/   1E596 :                     ; ---------------------------------------------------------------------------
   42905/   1E596 :                     ; Subroutine to find which tile is in the specified location
   42906/   1E596 :                     ; d2 = y_pos
   42907/   1E596 :                     ; d3 = x_pos
   42908/   1E596 :                     ; returns relevant block ID in (a1)
   42909/   1E596 :                     ; a1 is pointer to block in chunk table
   42910/   1E596 :                     ; ---------------------------------------------------------------------------
   42911/   1E596 :                     
   42912/   1E596 :                     ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
