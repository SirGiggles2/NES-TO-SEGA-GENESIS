   43208/   1E9B0 :                     ; a3 = delta-x for next location to check if current one is empty
   43209/   1E9B0 :                     ; a4 = pointer to angle buffer
   43210/   1E9B0 :                     ; returns relevant block ID in (a1)
   43211/   1E9B0 :                     ; returns distance to left/right in d1
   43212/   1E9B0 :                     ; returns angle in (a4)
