    5834/    4950 : =$0                  .zone_entries_left := .zone_entries-1
    5834/    4950 : =$2                  .cur_zone_id := .cur_zone_id+1
    5834/    4950 : ="2"                 .cur_zone_str := "\{.cur_zone_id}"
    5834/    4950 :                                 shift
