     317/     2CA :                     Z80StartupCodeBegin: ; loc_2CA:
     318/     2CA :                         save
     319/     2CA :                         CPU Z80 ; start assembling Z80 code
     320/       0 :                         phase 0 ; pretend we're at address 0
     321/       0 : AF                  	xor	a	; clear a to 0
     322/       1 : 01 D9 1F            	ld	bc,((Z80_RAM_End-Z80_RAM)-zStartupCodeEndLoc)-1 ; prepare to loop this many times
     323/       4 : 11 27 00            	ld	de,zStartupCodeEndLoc+1	; initial destination address
     324/       7 : 21 26 00            	ld	hl,zStartupCodeEndLoc	; initial source address
     325/       A : F9                  	ld	sp,hl	; set the address the stack starts at
     326/       B : 77                  	ld	(hl),a	; set first byte of the stack to 0
     327/       C : ED B0               	ldir		; loop to fill the stack (entire remaining available Z80 RAM) with 0
     328/       E : DD E1               	pop	ix	; clear ix
     329/      10 : FD E1               	pop	iy	; clear iy
     330/      12 : ED 47               	ld	i,a	; clear i
     331/      14 : ED 4F               	ld	r,a	; clear r
     332/      16 : D1                  	pop	de	; clear de
     333/      17 : E1                  	pop	hl	; clear hl
     334/      18 : F1                  	pop	af	; clear af
     335/      19 : 08                  	ex	af,af'	; swap af with af'
     336/      1A : D9                  	exx		; swap bc/de/hl with their shadow registers too
     337/      1B : C1                  	pop	bc	; clear bc
     338/      1C : D1                  	pop	de	; clear de
     339/      1D : E1                  	pop	hl	; clear hl
     340/      1E : F1                  	pop	af	; clear af
     341/      1F : F9                  	ld	sp,hl	; clear sp
