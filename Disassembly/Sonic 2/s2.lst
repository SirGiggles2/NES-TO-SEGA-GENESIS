   71549/   35C62 :                      charset 'H',"\xB\4\x11\x11\9\xF\5\8\xC\x11\3\6\2\xA\x11\x10\x11\xE\x11"
   71550/   35C62 :                      charset '!',"\x11"
   71551/   35C62 :                      charset '.',"\x12"
