   43369/   1EAF0 :                     
   43370/   1EAF0 :                     ; ---------------------------------------------------------------------------
   43371/   1EAF0 :                     ; This subroutine takes 'raw' bitmap-like collision block data as input and
   43372/   1EAF0 :                     ; converts it into the proper collision arrays (ColArrayVertical and
   43373/   1EAF0 :                     ; ColArrayHorizontal).
   43374/   1EAF0 :                     ; Pointers to said raw data are dummied out.
   43375/   1EAF0 :                     ; Curiously, an example of the original 'raw' data that this was intended
   43376/   1EAF0 :                     ; to process can be found in the J2ME version of Sonic 1, in a file called
   43377/   1EAF0 :                     ; 'blkcol.bct'.
   43378/   1EAF0 :                     ; This subroutine exists in Sonic 1 as well, but was oddly changed in
   43379/   1EAF0 :                     ; the S2 Nick Arcade prototype to just handle loading GHZ's collision
   43380/   1EAF0 :                     ; instead (though it too is dummied out, hence collision being broken).
   43381/   1EAF0 :                     ; ---------------------------------------------------------------------------
   43382/   1EAF0 :                     
   43383/   1EAF0 : =$42E50              RawColBlocks		= ColArrayVertical
   43384/   1EAF0 : =$42E50              ConvRowColBlocks	= ColArrayVertical
   43385/   1EAF0 :                     
   43386/   1EAF0 :                     ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
   43387/   1EAF0 :                     
   43388/   1EAF0 :                     ; return_1EAF0: FloorLog_Unk:
   43389/   1EAF0 :                     ConvertCollisionArray:
   43390/   1EAF0 : 4E75                	rts
   43391/   1EAF2 :                     ; ---------------------------------------------------------------------------
   43392/   1EAF2 :                     	; The raw format stores the collision data column by column for the normal collision array.
   43393/   1EAF2 :                     	; This makes a copy of the data, but stored row by row, for the rotated collision array.
   43394/   1EAF2 : 43F9 0004 2E50      	lea	(RawColBlocks).l,a1	; Source location of raw collision block data
   43395/   1EAF8 : 45F9 0004 2E50      	lea	(ConvRowColBlocks).l,a2	; Destinatation location for row-converted collision block data
   43396/   1EAFE :                     
   43397/   1EAFE : 363C 00FF           	move.w	#$100-1,d3	; Number of blocks in collision data
   43398/   1EB02 :                     .blockLoop:
   43399/   1EB02 : 7A10                	moveq	#16,d5		; Start on the 16th bit (the leftmost pixel)
   43400/   1EB04 :                     
   43401/   1EB04 : 343C 000F           	move.w	#16-1,d2	; Width of a block in pixels
   43402/   1EB08 :                     .columnLoop:
   43403/   1EB08 : 7800                	moveq	#0,d4
   43404/   1EB0A :                     
   43405/   1EB0A : 323C 000F           	move.w	#16-1,d1	; Height of a block in pixels
   43406/   1EB0E :                     .rowLoop:
   43407/   1EB0E : 3019                	move.w	(a1)+,d0	; Get row of collision bits
   43408/   1EB10 : EAA8                	lsr.l	d5,d0		; Push the selected bit of this row into the 'eXtend' flag
   43409/   1EB12 : D944                	addx.w	d4,d4		; Shift d4 to the left, and insert the selected bit into bit 0
   43410/   1EB14 : 51C9 FFF8           	dbf	d1,.rowLoop	; Loop for each row of pixels in a block
   43411/   1EB18 :                     
   43412/   1EB18 : 34C4                	move.w	d4,(a2)+	; Store column of collision bits
