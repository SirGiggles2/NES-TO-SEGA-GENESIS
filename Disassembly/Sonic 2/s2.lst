   27096/   13C48 :                     ; Object 34 - level title card (screen with red, yellow, and blue)
   27097/   13C48 :                     ; ----------------------------------------------------------------------------
   27098/   13C48 : =$30                 titlecard_x_target     = objoff_30	; the X position the object will reach
   27099/   13C48 : =$32                 titlecard_x_source     = objoff_32	; the X position the object starts from and will end at
   27100/   13C48 : =$34                 titlecard_location     = objoff_34	; point up to which titlecard is drawn
   27101/   13C48 : =$36                 titlecard_vram_dest    = objoff_36	; target of VRAM write
   27102/   13C48 : =$38                 titlecard_vram_dest_2P = objoff_38	; target of VRAM write
   27103/   13C48 : =$3A                 titlecard_split_point  = objoff_3A	; point to split drawing for yellow and red portions
   27104/   13C48 : =$3E                 titlecard_leaveflag    = objoff_3E	; whether or not titlecard is leaving screen
   27105/   13C48 :                     ; Sprite_13C48:
   27106/   13C48 :                     Obj34: ; (note: screen-space obj)
