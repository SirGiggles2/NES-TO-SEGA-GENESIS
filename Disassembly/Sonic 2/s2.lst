   89650/   45A86 :  (MACRO-2)                   zoneTableEntry.w Level_Invalid-.current_offset_table
   89650/   45A86 : 0044                                dc.w Level_Invalid-.current_offset_table
   89650/   45A88 : =$0                  .zone_entries_left := .zone_entries_left-1
