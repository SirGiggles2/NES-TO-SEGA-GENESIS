   18810/    DCD6 :                     ; ===========================================================================
   18811/    DCD6 :                     ; Scrap Brain Zone 1 block positioning array -- S1 left-over
   18812/    DCD6 :                     ; Each entry is an index into BGCameraLookup; used to decide the camera to use
   18813/    DCD6 :                     ; for given block for reloading BG. A entry of 0 means assume X = 0 for section,
   18814/    DCD6 :                     ; but otherwise loads camera Y for selected camera.
   18815/    DCD6 :                     ; Note that this list is 32 blocks long, which is enough to span the entire
   18816/    DCD6 :                     ; two-chunk-tall background.
   18817/    DCD6 :                     ;byte_DCD6
   18818/    DCD6 :                     SBZ_CameraSections:
   18819/    DCD6 :                     	; BG1 (draw whole row)
   18820/    DCD6 : 00                  	dc.b 0	; 0
   18821/    DCD7 : 00                  	dc.b 0	; 1
   18822/    DCD8 : 00                  	dc.b 0	; 2
   18823/    DCD9 : 00                  	dc.b 0	; 3
   18824/    DCDA : 00                  	dc.b 0	; 4
   18825/    DCDB :                     	; BG3
   18826/    DCDB : 06                  	dc.b 6	; 5
   18827/    DCDC : 06                  	dc.b 6	; 6
   18828/    DCDD : 06                  	dc.b 6	; 7
   18829/    DCDE : 06                  	dc.b 6	; 8
   18830/    DCDF : 06                  	dc.b 6	; 9
   18831/    DCE0 : 06                  	dc.b 6	; 10
   18832/    DCE1 : 06                  	dc.b 6	; 11
   18833/    DCE2 : 06                  	dc.b 6	; 12
   18834/    DCE3 : 06                  	dc.b 6	; 13
   18835/    DCE4 : 06                  	dc.b 6	; 14
   18836/    DCE5 :                     	; BG2
   18837/    DCE5 : 04                  	dc.b 4	; 15
   18838/    DCE6 : 04                  	dc.b 4	; 16
   18839/    DCE7 : 04                  	dc.b 4	; 17
   18840/    DCE8 : 04                  	dc.b 4	; 18
   18841/    DCE9 : 04                  	dc.b 4	; 19
   18842/    DCEA : 04                  	dc.b 4	; 20
   18843/    DCEB : 04                  	dc.b 4	; 21
   18844/    DCEC :                     	; BG1
   18845/    DCEC : 02                  	dc.b 2	; 22
   18846/    DCED : 02                  	dc.b 2	; 23
   18847/    DCEE : 02                  	dc.b 2	; 24
   18848/    DCEF : 02                  	dc.b 2	; 25
   18849/    DCF0 : 02                  	dc.b 2	; 26
   18850/    DCF1 : 02                  	dc.b 2	; 27
   18851/    DCF2 : 02                  	dc.b 2	; 28
   18852/    DCF3 : 02                  	dc.b 2	; 29
   18853/    DCF4 : 02                  	dc.b 2	; 30
   18854/    DCF5 : 02                  	dc.b 2	; 31
   18855/    DCF6 : 02                  	dc.b 2	; 32
   18856/    DCF7 :                     
   18857/    DCF7 :                     	; Total height: 2 256x256 chunks.
   18858/    DCF7 :                     	; This matches the height of the background.
   18859/    DCF7 :                     
   18860/    DCF7 : (MACRO)              	even
   18860/    DCF7 : =$E                  paddingSoFar            set paddingSoFar+1
   18860/    DCF7 : 00                                          dc.b 0 ;ds.b 1 
   18861/    DCF8 :                     
   18862/    DCF8 :                     ; ===========================================================================
   18863/    DCF8 :                     	; Scrap Brain Zone 1 drawing code -- Sonic 1 left-over.
   18864/    DCF8 :                     
   18865/    DCF8 :                     ;Draw_BG2_SBZ:
   18866/    DCF8 :                     	; Chemical Plant Zone uses a lighty-modified version this code.
   18867/    DCF8 :                     	; This is an advanced form of the usual background-drawing code that
   18868/    DCF8 :                     	; allows each row of blocks to update and scroll independently...
   18869/    DCF8 :                     	; kind of. There are only three possible 'cameras' that each row can
   18870/    DCF8 :                     	; align itself with. Still, each row is free to decide which camera
   18871/    DCF8 :                     	; it aligns with.
   18872/    DCF8 :                     	; This could have really benefitted Oil Ocean Zone's background,
   18873/    DCF8 :                     	; which has a section that goes unseen because the regular background
   18874/    DCF8 :                     	; drawer is too primitive to display it without making the sun and
   18875/    DCF8 :                     	; clouds disappear. Using this would have avoided that.
   18876/    DCF8 :                     
   18877/    DCF8 :                     	; Handle loading the rows as the camera moves up and down.
   18878/    DCF8 : 78F0                	moveq	#-block_height,d4	; Y offset (relative to camera)
   18879/    DCFA : 0892 0000           	bclr	#scroll_flag_advanced_bg_up,(a2)
   18880/    DCFE : 660A                	bne.s	.doUpOrDown
   18881/    DD00 : 0892 0001           	bclr	#scroll_flag_advanced_bg_down,(a2)
   18882/    DD04 : 674C                	beq.s	.checkIfShouldDoLeftOrRight
   18883/    DD06 : 383C 00E0           	move.w	#screen_height,d4	; Y offset (relative to camera)
   18884/    DD0A :                     
   18885/    DD0A :                     .doUpOrDown:
   18886/    DD0A : (MACRO)              	lea_	SBZ_CameraSections+1,a0
   18886/    DD0A : 41FA FFCB                           !lea SBZ_CameraSections+1(pc),a0
   18887/    DD0E : 3038 EE0C           	move.w	(Camera_BG_Y_pos).w,d0
   18888/    DD12 : D044                	add.w	d4,d0
   18889/    DD14 : 0240 01F0           	andi.w	#$1F0,d0	; After right-shifting, the is a mask of $1F. Since SBZ_CameraSections is $20 items long, this is correct.
   18890/    DD18 : E848                	lsr.w	#4,d0
   18891/    DD1A : 1030 0000           	move.b	(a0,d0.w),d0
   18892/    DD1E : 47F9 0000 DE7E      	lea	(BGCameraLookup).l,a3
   18893/    DD24 : 3673 0000           	movea.w	(a3,d0.w),a3	; Camera, either BG, BG2 or BG3 depending on Y
   18894/    DD28 : 6714                	beq.s	.doWholeRow
   18895/    DD2A : 7AF0                	moveq	#-block_width,d5	; X offset (relative to camera)
   18896/    DD2C : 48E7 0C00           	movem.l	d4-d5,-(sp)
   18897/    DD30 : 6100 0554           	bsr.w	CalculateVRAMAddressOfBlockForPlayer1
   18898/    DD34 : 4CDF 0030           	movem.l	(sp)+,d4-d5
   18899/    DD38 : 6100 0258           	bsr.w	DrawBlockRow
   18900/    DD3C : 6014                	bra.s	.checkIfShouldDoLeftOrRight
   18901/    DD3E :                     ; ===========================================================================
   18902/    DD3E :                     
   18903/    DD3E :                     .doWholeRow:
   18904/    DD3E : 7A00                	moveq	#0,d5	; X (absolute)
   18905/    DD40 : 48E7 0C00           	movem.l	d4-d5,-(sp)
   18906/    DD44 : 6100 0542           	bsr.w	CalculateVRAMAddressOfBlockForPlayer1.AbsoluteX
   18907/    DD48 : 4CDF 0030           	movem.l	(sp)+,d4-d5
   18908/    DD4C : 7C1F                	moveq	#gameplay_plane_width/block_width-1,d6	; The entire width of the plane in blocks minus 1.
   18909/    DD4E : 6100 0246           	bsr.w	DrawBlockRow.AbsoluteXCustomWidth
   18910/    DD52 :                     
   18911/    DD52 :                     .checkIfShouldDoLeftOrRight:
   18912/    DD52 :                     	; If there are other scroll flags set, then go do them.
   18913/    DD52 : 4A12                	tst.b	(a2)
   18914/    DD54 : 6602                	bne.s	.doLeftOrRight
   18915/    DD56 : 4E75                	rts
   18916/    DD58 :                     ; ===========================================================================
   18917/    DD58 :                     
   18918/    DD58 :                     .doLeftOrRight:
   18919/    DD58 : 78F0                	moveq	#-block_height,d4 ; Y offset
   18920/    DD5A :                     
   18921/    DD5A :                     	; Load left column.
   18922/    DD5A : 7AF0                	moveq	#-block_width,d5 ; X offset
   18923/    DD5C : 1012                	move.b	(a2),d0
   18924/    DD5E : 0200 00A8           	andi.b	#(1<<scroll_flag_advanced_bg1_right)|(1<<scroll_flag_advanced_bg2_right)|(1<<scroll_flag_advanced_bg3_right),d0
   18925/    DD62 : 6708                	beq.s	+
   18926/    DD64 : E208                	lsr.b	#1,d0	; Make the left and right flags share the same bits, to simplify a calculation later.
   18927/    DD66 : 1480                	move.b	d0,(a2)
   18928/    DD68 :                     	; Load right column.
   18929/    DD68 : 3A3C 0140           	move.w	#screen_width,d5 ; X offset
   18930/    DD6C :                     +
   18931/    DD6C :                     	; Select the correct starting background section, and then begin
   18932/    DD6C :                     	; drawing the column.
   18933/    DD6C : (MACRO)              	lea_	SBZ_CameraSections,a0
   18933/    DD6C : 41FA FF68                           !lea SBZ_CameraSections(pc),a0
   18934/    DD70 : 3038 EE0C           	move.w	(Camera_BG_Y_pos).w,d0
   18935/    DD74 : 0240 01F0           	andi.w	#$1F0,d0	; After right-shifting, the is a mask of $1F. Since SBZ_CameraSections is $20 items long, this is correct.
   18936/    DD78 : E848                	lsr.w	#4,d0
   18937/    DD7A : 41F0 0000           	lea	(a0,d0.w),a0
   18938/    DD7E : 6000 0106           	bra.w	DrawBlockColumn_Advanced
   18939/    DD82 :                     ; end unused routine
