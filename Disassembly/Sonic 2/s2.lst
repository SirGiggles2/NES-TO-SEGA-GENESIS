   34796/   19718 :                     ; Solid object subroutines (includes spikes, blocks, rocks etc)
   34797/   19718 :                     ; These check collision of Sonic/Tails with objects on the screen
   34798/   19718 :                     ;
   34799/   19718 :                     ; input variables:
   34800/   19718 :                     ; d1 = object width / 2
   34801/   19718 :                     ; d2 = object height / 2 (when jumping)
   34802/   19718 :                     ; d3 = object height / 2 (when walking)
   34803/   19718 :                     ; d4 = object x-axis position
   34804/   19718 :                     ;
   34805/   19718 :                     ; address registers:
   34806/   19718 :                     ; a0 = the object to check collision with
   34807/   19718 :                     ; a1 = Sonic or Tails (set inside these subroutines)
   34808/   19718 :                     ; ---------------------------------------------------------------------------
   34809/   19718 :                     
