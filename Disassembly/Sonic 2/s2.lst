             76A0 : 0006             
   10107/    76A2 : 000E 0010 0012      	dc.b   0,  $E,     0, $10,     0, $12,     0, $12	; $0C
             76A8 : 0012             
   10108/    76AA : 0912                	dc.b   9, $12                                    	; $10; upward curve
   10109/    76AC : 0000 0000 0000      	dc.b   0,   0,     0,   0,     0,   0,     0,   0	; $11; straight
             76B2 : 0000             
   10110/    76B4 : 1300 1300 1300      	dc.b $13,   0,   $13,   0,   $13,   0,   $13,   0	; $15
             76BA : 1300             
   10111/    76BC : 0B0C 000C 0012      	dc.b  $B,  $C,     0,  $C,     0, $12,     0,  $A	; $19
             76C2 : 000A             
