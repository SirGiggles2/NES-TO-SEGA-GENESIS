   17777/    D5A0 :                     	; Find which row of background is visible at the top of the screen
   17778/    D5A0 :                     .findTopRowLoop:
   17779/    D5A0 : 101B                	move.b	(a3)+,d0	; Get row height
   17780/    D5A2 : 544A                	addq.w	#2,a2		; Next row speed (note: is off by 2. This is fixed below)
   17781/    D5A4 : 9240                	sub.w	d0,d1
   17782/    D5A6 : 64F8                	bcc.s	.findTopRowLoop	; If current row is above the screen, loop and do next row
   17783/    D5A8 :                     
   17784/    D5A8 : 4441                	neg.w	d1		; d1 now contains how many pixels of the row is currently on-screen
   17785/    D5AA : 554A                	subq.w	#2,a2		; Get correct row speed
   17786/    D5AC :                     
   17787/    D5AC : 343C 00DF           	move.w	#screen_height-1,d2 	; Height of screen
   17788/    D5B0 : 3038 EE00           	move.w	(Camera_X_pos).w,d0
   17789/    D5B4 : 4440                	neg.w	d0
   17790/    D5B6 : 4840                	swap	d0		; Store FG X-pos in upper 16-bits...
   17791/    D5B8 : 301A                	move.w	(a2)+,d0	; ...and BG X-pos in lower 16 bits, as Horiz_Scroll_Buf expects it
   17792/    D5BA : 4440                	neg.w	d0
   17793/    D5BC :                     
   17794/    D5BC : 22C0                -	move.l	d0,(a1)+	; Write 1 FG Horizontal Scroll value, and 1 BG Horizontal Scroll value
   17795/    D5BE : 5341                	subq.w	#1,d1		; Loop until row at top of screen is done
   17796/    D5C0 : 6606                	bne.s	+
   17797/    D5C2 : 121B                	move.b	(a3)+,d1	; Once that row is done, go to next row...
   17798/    D5C4 : 301A                	move.w	(a2)+,d0	; ...and use next speed
   17799/    D5C6 : 4440                	neg.w	d0
