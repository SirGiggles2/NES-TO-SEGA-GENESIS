   15779/    C964 :                     ; This array is missing data for the last $80 lines compared to the transition array.
   15780/    C964 :                     ; This causes the lower clouds to read data from the start of SwScrl_HTZ.
   15781/    C964 :                     ; These are the missing entries:
   15787/    C964 :                     ; ===========================================================================
   15788/    C964 :                     ; loc_C964:
   15789/    C964 :                     SwScrl_HTZ:
   15790/    C964 :                     	; Use different background scrolling code for two player mode...
   15791/    C964 :                     	; despite the fact that Hill Top Zone is not normally playable in
   15792/    C964 :                     	; two-player mode.
   15793/    C964 : 4A78 FFD8           	tst.w	(Two_player_mode).w
   15794/    C968 : 6600 01A6           	bne.w	SwScrl_HTZ_2P
   15795/    C96C :                     
   15796/    C96C : 4A38 EEBC           	tst.b	(Screen_Shaking_Flag_HTZ).w
   15797/    C970 : 6600 0120           	bne.w	HTZ_Screen_Shake
   15798/    C974 :                     
   15799/    C974 :                     	; Update the background's vertical scrolling.
   15800/    C974 : 31F8 EE0C F618      	move.w	(Camera_BG_Y_pos).w,(Vscroll_Factor_BG).w
   15801/    C97A :                     
   15802/    C97A :                     	; Update the background's (and foreground's) horizontal scrolling.
   15803/    C97A :                     	; This creates an elaborate parallax effect.
   15804/    C97A : 43F8 E000           	lea	(Horiz_Scroll_Buf).w,a1
   15805/    C97E : 3038 EE00           	move.w	(Camera_X_pos).w,d0
   15806/    C982 : 4440                	neg.w	d0
   15807/    C984 : 3400                	move.w	d0,d2
   15808/    C986 : 4840                	swap	d0
   15809/    C988 : 3002                	move.w	d2,d0
   15810/    C98A : E640                	asr.w	#3,d0
   15811/    C98C :                     
   15812/    C98C :                     	; Do 128 lines that move together with the camera.
   15813/    C98C : 323C 007F           	move.w	#128-1,d1
   15814/    C990 : 22C0                -	move.l	d0,(a1)+
   15815/    C992 : 51C9 FFFC           	dbf	d1,-
   15816/    C996 :                     
   15817/    C996 :                     	; The remaining lines of code in this function compose the animating clouds.
   15818/    C996 : 2800                	move.l	d0,d4
   15819/    C998 : 3038 A822           	move.w	(TempArray_LayerDef+$22).w,d0
   15820/    C99C : 5878 A822           	addq.w	#4,(TempArray_LayerDef+$22).w
   15821/    C9A0 :                     
   15822/    C9A0 :                     	; Get delta between camera X and the cloud scroll value.
   15823/    C9A0 : 9440                	sub.w	d0,d2
   15824/    C9A2 :                     
   15825/    C9A2 :                     	; This big block of code divides and then multiplies the delta by roughly 2.28,
   15826/    C9A2 :                     	; effectively subtracting 'delta modulo 2.28' from the delta.
   15827/    C9A2 :                     	; I have no idea why this is necessary.
   15828/    C9A2 :                     
   15829/    C9A2 :                     	; Start by reducing to 44% (100% divided by 2.28)...
   15830/    C9A2 : 3002                	move.w	d2,d0
   15835/    C9A4 : 3200                	move.w	d0,d1
   15836/    C9A6 : E240                	asr.w	#1,d0 ; Divide d0 by 2
   15843/    C9A8 : E841                	asr.w	#4,d1 ; Divide d1 by 16, discarding the remainder
   15845/    C9AA : 9041                	sub.w	d1,d0 ; 100 / 2 - 100 / 16 = 44
   15846/    C9AC : 48C0                	ext.l	d0
   15847/    C9AE :                     	; ...then increase the result to 228%, effectively undoing the reduction to 44% from earlier (0.44 x 2.28 = 1).
   15848/    C9AE : E180                	asl.l	#8,d0 ; Multiply by 256
   15849/    C9B0 : 81FC 0070           	divs.w	#256*44/100,d0 ; Divide by 112, which is 44% of 256
   15850/    C9B4 : 48C0                	ext.l	d0
   15851/    C9B6 :                     
   15852/    C9B6 :                     	; We are done subtracting 'delta modulo 2.28' from the delta.
   15853/    C9B6 :                     
   15854/    C9B6 :                     	; Multiply the delta by 256.
   15855/    C9B6 : E180                	asl.l	#8,d0
   15856/    C9B8 :                     
   15857/    C9B8 : 45F8 A800           	lea	(TempArray_LayerDef).w,a2	; See 'Dynamic_HTZ.doCloudArt'.
   15858/    C9BC :                     
   15862/    C9BC :                     	; d3 is used as a fixed-point accumulator here, with the upper 16 bits
   15863/    C9BC :                     	; holding the integer part, and the lower 16 bits holding the decimal
   15864/    C9BC :                     	; part. This accumulator is initialised to the value of the delta
   15865/    C9BC :                     	; divided by 16, however, the decimal part of this division was not
   15866/    C9BC :                     	; preserved. This loss of precision causes the clouds to scroll with a
   15867/    C9BC :                     	; visible jerkiness.
   15868/    C9BC : 7600                	moveq	#0,d3
   15869/    C9BE : 3601                	move.w	d1,d3 ; d1 holds the original, pre-modulo delta divided by 16.
   15871/    C9C0 :                     
   15872/    C9C0 :                         rept 3
   15873/    C9C0 :                     	swap	d3
   15874/    C9C0 :                     	add.l	d0,d3
   15875/    C9C0 :                     	swap	d3
   15876/    C9C0 :                     	move.w	d3,(a2)+
   15877/    C9C0 :                         endm
   15873/    C9C0 : 4843                	swap	d3
   15874/    C9C2 : D680                	add.l	d0,d3
   15875/    C9C4 : 4843                	swap	d3
   15876/    C9C6 : 34C3                	move.w	d3,(a2)+
   15873/    C9C8 : 4843                	swap	d3
   15874/    C9CA : D680                	add.l	d0,d3
   15875/    C9CC : 4843                	swap	d3
   15876/    C9CE : 34C3                	move.w	d3,(a2)+
   15873/    C9D0 : 4843                	swap	d3
   15874/    C9D2 : D680                	add.l	d0,d3
   15875/    C9D4 : 4843                	swap	d3
   15876/    C9D6 : 34C3                	move.w	d3,(a2)+
   15878/    C9D8 : 34C3                	move.w	d3,(a2)+
   15879/    C9DA : 4843                	swap	d3
   15880/    C9DC : D680                	add.l	d0,d3
   15881/    C9DE : D680                	add.l	d0,d3
   15882/    C9E0 : 4843                	swap	d3
   15883/    C9E2 :                     
   15884/    C9E2 : 7203                	moveq	#4-1,d1
   15885/    C9E4 : 34C3                -	move.w	d3,(a2)+
   15886/    C9E6 : 34C3                	move.w	d3,(a2)+
   15887/    C9E8 : 34C3                	move.w	d3,(a2)+
   15888/    C9EA : 4843                	swap	d3
   15889/    C9EC : D680                	add.l	d0,d3
   15890/    C9EE : D680                	add.l	d0,d3
   15891/    C9F0 : D680                	add.l	d0,d3
   15892/    C9F2 : 4843                	swap	d3
   15893/    C9F4 : 51C9 FFEE           	dbf	d1,-
   15894/    C9F8 :                     
   15895/    C9F8 :                     	; Do 8 lines.
   15896/    C9F8 : D080                	add.l	d0,d0
   15897/    C9FA : D080                	add.l	d0,d0
   15898/    C9FC : 3803                	move.w	d3,d4
   15899/    C9FE : 22C4                	move.l	d4,(a1)+
   15900/    CA00 : 22C4                	move.l	d4,(a1)+
   15901/    CA02 : 22C4                	move.l	d4,(a1)+
   15902/    CA04 : 4843                	swap	d3
   15903/    CA06 : D680                	add.l	d0,d3
   15904/    CA08 : 4843                	swap	d3
   15905/    CA0A : 3803                	move.w	d3,d4
   15906/    CA0C : 22C4                	move.l	d4,(a1)+
   15907/    CA0E : 22C4                	move.l	d4,(a1)+
   15908/    CA10 : 22C4                	move.l	d4,(a1)+
   15909/    CA12 : 22C4                	move.l	d4,(a1)+
   15910/    CA14 : 22C4                	move.l	d4,(a1)+
   15911/    CA16 :                     
   15912/    CA16 :                     	; Do 7 lines.
   15913/    CA16 : 4843                	swap	d3
   15914/    CA18 : D680                	add.l	d0,d3
   15915/    CA1A : 4843                	swap	d3
   15916/    CA1C : 3803                	move.w	d3,d4
   15917/    CA1E :                     
   15918/    CA1E : 323C 0006           	move.w	#7-1,d1
   15919/    CA22 : 22C4                -	move.l	d4,(a1)+
   15920/    CA24 : 51C9 FFFC           	dbf	d1,-
   15921/    CA28 :                     
   15922/    CA28 :                     	; Do 8 lines.
   15923/    CA28 : 4843                	swap	d3
   15924/    CA2A : D680                	add.l	d0,d3
   15925/    CA2C : D680                	add.l	d0,d3
   15926/    CA2E : 4843                	swap	d3
   15927/    CA30 : 3803                	move.w	d3,d4
   15928/    CA32 :                     
   15929/    CA32 : 323C 0007           	move.w	#8-1,d1
   15930/    CA36 : 22C4                -	move.l	d4,(a1)+
   15931/    CA38 : 51C9 FFFC           	dbf	d1,-
   15932/    CA3C :                     
   15933/    CA3C :                     	; Do 10 lines.
   15934/    CA3C : 4843                	swap	d3
