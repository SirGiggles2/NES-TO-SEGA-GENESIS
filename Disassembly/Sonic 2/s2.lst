   29650/   15FE6 :                     ; ---------------------------------------------------------------------------
   29651/   15FE6 :                     ; this skips certain objects to make enemies and things pause when Sonic dies
   29652/   15FE6 :                     ; loc_15FE6:
   29653/   15FE6 :                     RunObjectsWhenPlayerIsDead:
   29654/   15FE6 : 7E0F                	moveq	#(Reserved_Object_RAM_End-Reserved_Object_RAM)/object_size-1,d7
   29655/   15FE8 : 61E2                	bsr.s	RunObject	; run the first $10 objects normally
   29656/   15FEA : 7E6F                	moveq	#(Dynamic_Object_RAM_End-Dynamic_Object_RAM)/object_size-1,d7
   29657/   15FEC : 6104                	bsr.s	RunObjectDisplayOnly ; all objects in this range are paused
   29658/   15FEE : 7E0F                	moveq	#(LevelOnly_Object_RAM_End-LevelOnly_Object_RAM)/object_size-1,d7
   29659/   15FF0 : 60DA                	bra.s	RunObject	; run the last $10 objects normally
   29660/   15FF2 :                     
   29661/   15FF2 :                     ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
   29662/   15FF2 :                     
   29663/   15FF2 :                     ; sub_15FF2:
   29664/   15FF2 :                     RunObjectDisplayOnly:
   29665/   15FF2 : 7000                	moveq	#0,d0
   29666/   15FF4 :                     	; This check prevent objects that don't exist from being displayed.
   29667/   15FF4 : 1010                	move.b	id(a0),d0	; get the object's ID
   29668/   15FF6 : 670A                	beq.s	+	; if it's obj00, skip it
   29669/   15FF8 :                     	; This check prevents objects that do exist, but haven't been initialised yet, from being displayed.
   29670/   15FF8 : (MACRO)              	_btst	#render_flags.on_screen,render_flags(a0)	; was the object displayed on the previous frame?
   29670/   15FF8 : =$1                  last_btst_converted := ~~chkop("#render_flags.on_screen","#render_flags.on_screen") || ~~chkop("#render_flags.on_screen","#status.npc.no_balancing") || ~~chkop("#render_flags.on_screen","#status_secondary.sliding")
   29670/   15FF8 :                     
   29670/   15FF8 : 4A28 0001                           tst.b   render_flags(a0)
   29671/   15FFC : (MACRO)              	_beq.s	+						; if not, skip it
   29671/   15FFC : 6A04                                bpl.s   +
   29693/   15FFE : 6100 04F4           	bsr.w	DisplaySprite
   29695/   16002 :                     +
   29696/   16002 : 41E8 0040           	lea	next_object(a0),a0 ; load 0bj address
   29697/   16006 : 51CF FFEA           	dbf	d7,RunObjectDisplayOnly
   29698/   1600A : 4E75                	rts
   29699/   1600C :                     ; End of function RunObjectDisplayOnly
