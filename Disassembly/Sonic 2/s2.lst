    4466/    3C2E :                     	; Find the masking sprite, and move it to the proper location. The
    4467/    3C2E :                     	; sprite is normally at X 128+128, but in order to perform masking,
    4468/    3C2E :                     	; it must be at X 0.
    4469/    3C2E :                     	; The masking sprite is used to stop Sonic and Tails from overlapping
    4470/    3C2E :                     	; the emblem.
    4471/    3C2E :                     	; You might be wondering why it alternates between 0 and 4 for the X
    4472/    3C2E :                     	; position. That's because masking sprites only work if another
    4473/    3C2E :                     	; sprite rendered before them (or if the previous scanline reached
    4474/    3C2E :                     	; its pixel limit). Because of this, a sprite is placed at X 4 before
    4475/    3C2E :                     	; a second one is placed at X 0.
    4476/    3C2E : 43F8 F804           	lea	(Sprite_Table+4).w,a1
    4477/    3C32 : 7000                	moveq	#0,d0
    4478/    3C34 :                     
