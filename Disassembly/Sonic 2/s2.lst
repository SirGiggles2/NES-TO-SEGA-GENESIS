(1) 3302/     E24 :                     ; zloc_E24
(1) 3303/     E24 :                     zSetVoice:
(1) 3304/     E24 :                     	; This does the actual setting of the FM registers for the specific voice
(1) 3305/     E24 :                     	; 'a' is the voice index to set
(1) 3306/     E24 :                     	; 'hl' is set to the address of the voice table pointer (can be substituted, probably mainly for SFX)
(1) 3307/     E24 :                     
(1) 3321/     E24 : E5                  	push	hl	; push 'hl' for the end of the following block...
(1) 3322/     E25 :                     
(1) 3323/     E25 :                     	; The following is a crazy block designed to 'multiply' our target voice value by 25...
(1) 3324/     E25 :                     	; Where a single voice is 25 bytes long
(1) 3325/     E25 : 4F                  	ld	c,a	; a -> c
(1) 3326/     E26 : 06 00               	ld	b,0	; b = 0 (so only low byte of 'bc' is set, basically voice to set)
(1) 3327/     E28 : 87                  	add	a,a	; a *= 2 (indexing something...)
(1) 3328/     E29 : 6F                  	ld	l,a	; low byte of 'hl' set to 'a'
(1) 3329/     E2A : 60                  	ld	h,b	; high byte = 0
(1) 3330/     E2B : 29                  	add	hl,hl	; hl *= 2
(1) 3331/     E2C : 29                  	add	hl,hl	; hl *= 2 (total hl * 4!!)
(1) 3332/     E2D : 5D                  	ld	e,l
(1) 3333/     E2E : 54                  	ld	d,h	; de = hl
(1) 3334/     E2F : 29                  	add	hl,hl	; hl *= 2
(1) 3335/     E30 : 19                  	add	hl,de	; hl += de
(1) 3336/     E31 : 09                  	add	hl,bc	; hl += bc (waaah!)
(1) 3337/     E32 : D1                  	pop	de	; old 'hl' value -> 'de'
(1) 3338/     E33 : 19                  	add	hl,de	; hl += de (Adds address from the very beginning)
(1) 3339/     E34 :                     	; End crazy multiply-by-25 block
(1) 3341/     E34 :                     
(1) 3342/     E34 :                     	; Sets up a value for future total level setting...
(1) 3343/     E34 : 7E                  	ld	a,(hl)				; Get feedback/algorithm -> a
(1) 3344/     E35 : 23                  	inc	hl				; Next byte of voice...
(1) 3345/     E36 : 32 66 0E            	ld	(.a_backup+1),a			; Self-modified code: basically enables 'a' restored to its current value later
(1) 3346/     E39 : 4F                  	ld	c,a				; a -> c (will be data to YM2612)
(1) 3347/     E3A : DD 7E 01            	ld	a,(ix+zTrack.VoiceControl)	; Get "voice control" byte
(1) 3348/     E3D : E6 03               	and	3				; Only keep bits 0-2 (bit 2 specifies which chip to write to)
(1) 3349/     E3F : C6 B0               	add	a,0B0h				; Add to get appropriate feedback/algorithm register
(1) 3350/     E41 : D7                  	rst	zWriteFMIorII			; Write new value to appropriate part
(1) 3351/     E42 :                     
(1) 3352/     E42 :                     	; detune/coarse freq, all channels
(1) 3353/     E42 : D6 80               	sub	80h		; Subtract 80h from 'a' (Detune/coarse frequency of operator 1 register)
(1) 3354/     E44 : 06 04               	ld	b,4		; Do next 4 bytes (operator 1, 2, 3, and 4)
(1) 3355/     E46 :                     
(1) 3356/     E46 :                     .detuneloop:
(1) 3357/     E46 : 4E                  	ld	c,(hl)		; Get next detune/coarse freq
(1) 3358/     E47 : 23                  	inc	hl		; Next voice byte
(1) 3359/     E48 : D7                  	rst	zWriteFMIorII	; Write this detune/coarse freq
(1) 3360/     E49 : C6 04               	add	a,4		; Next detune/coarse freq register
(1) 3361/     E4B : 10 F9               	djnz	.detuneloop
(1) 3362/     E4D :                     
(1) 3363/     E4D : F5                  	push	af		; Saving 'a' for much later... will be restored when time to "Total Level"
(1) 3364/     E4E :                     
(1) 3365/     E4E :                     	; other regs up to just before "total level", all channels
