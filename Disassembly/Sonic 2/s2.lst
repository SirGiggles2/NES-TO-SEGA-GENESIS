   72583/   36892 : D040                	add.w	d0,d0
   72584/   36894 : D2F1 0000           	adda.w	(a1,d0.w),a1	; calculate address of appropriate animation script
   72585/   36898 : 1151 001E           	move.b	(a1),anim_frame_duration(a0)	; load frame duration
   72586/   3689C : 7200                	moveq	#0,d1
   72587/   3689E : 1228 001B           	move.b	anim_frame(a0),d1	; load current frame number
   72588/   368A2 : 1031 1001           	move.b	1(a1,d1.w),d0		; read sprite number from script
   72589/   368A6 : 6B0C                	bmi.s	AnimChk_End_FF		; if animation is complete, branch
