   32704/   17AA4 :                     ; ---------------------------------------------------------------------------
   32705/   17AA4 :                     ; Objects Manager
   32706/   17AA4 :                     ; Subroutine that keeps track of any objects that need to remember
   32707/   17AA4 :                     ; their state, such as monitors or enemies.
   32708/   17AA4 :                     ;
   32709/   17AA4 :                     ; input variables:
   32710/   17AA4 :                     ;  -none-
   32711/   17AA4 :                     ;
   32712/   17AA4 :                     ; writes:
   32713/   17AA4 :                     ;  d0, d1
   32714/   17AA4 :                     ;  d2 = respawn index of object to load
   32715/   17AA4 :                     ;  d6 = camera position
   32716/   17AA4 :                     ;
   32717/   17AA4 :                     ;  a0 = address in object placement list
   32718/   17AA4 :                     ;  a2 = respawn table
   32719/   17AA4 :                     ; ---------------------------------------------------------------------------
   32720/   17AA4 :                     
   32721/   17AA4 :                     ; loc_17AA4
   32722/   17AA4 :                     ObjectsManager:
   32723/   17AA4 : 7000                	moveq	#0,d0
   32724/   17AA6 : 1038 F76C           	move.b	(Obj_placement_routine).w,d0
   32725/   17AAA : 303B 0006           	move.w	ObjectsManager_States(pc,d0.w),d0
   32726/   17AAE : 4EFB 0002           	jmp	ObjectsManager_States(pc,d0.w)
   32727/   17AB2 :                     ; ===========================================================================
   32728/   17AB2 : (MACRO)              ObjectsManager_States: offsetTable
   32728/   17AB2 : =$17AB2              current_offset_table := ObjectsManager_States
   32728/   17AB2 : =$17AB2              ObjectsManager_States label *
   32729/   17AB2 : (MACRO)              	offsetTableEntry.w ObjectsManager_Init		; 0
   32729/   17AB2 : 0006                        dc.w ObjectsManager_Init-current_offset_table
   32730/   17AB4 : (MACRO)              	offsetTableEntry.w ObjectsManager_Main		; 2
   32730/   17AB4 : 00D2                        dc.w ObjectsManager_Main-current_offset_table
   32731/   17AB6 : (MACRO)              	offsetTableEntry.w ObjectsManager_2P_Main	; 4
   32731/   17AB6 : 021A                        dc.w ObjectsManager_2P_Main-current_offset_table
   32732/   17AB8 :                     ; ===========================================================================
   32733/   17AB8 :                     ; loc_17AB8
   32734/   17AB8 :                     ObjectsManager_Init:
   32735/   17AB8 : 5438 F76C           	addq.b	#2,(Obj_placement_routine).w
   32736/   17ABC : 3038 FE10           	move.w	(Current_ZoneAndAct).w,d0 ; If level == $0F01 (ARZ 2)...
   32737/   17AC0 : E218                	ror.b	#1,d0			; then this yields $0F80...
   32738/   17AC2 : EC48                	lsr.w	#6,d0			; and this yields $003E.
   32739/   17AC4 : 41F9 000E 6800      	lea	(Off_Objects).l,a0	; Next, we load the first pointer in the object layout list pointer index,
   32740/   17ACA : 2248                	movea.l	a0,a1			; then copy it for quicker use later.
   32741/   17ACC : D0F0 0000           	adda.w	(a0,d0.w),a0		; (Point1 * 2) + $003E
   32742/   17AD0 : 4A78 FFD8           	tst.w	(Two_player_mode).w	; skip if not in 2-player vs mode
   32743/   17AD4 : 671A                	beq.s	+
   32744/   17AD6 : 0C38 000C FE10      	cmpi.b	#casino_night_zone,(Current_Zone).w	; skip if not Casino Night Zone
   32745/   17ADC : 6612                	bne.s	+
   32746/   17ADE : 41F9 0001 802A      	lea	(Objects_CNZ1_2P).l,a0	; CNZ 1 2-player object layout
   32747/   17AE4 : 4A38 FE11           	tst.b	(Current_Act).w		; skip if not past act 1
   32748/   17AE8 : 6706                	beq.s	+
   32749/   17AEA : 41F9 0001 8492      	lea	(Objects_CNZ2_2P).l,a0	; CNZ 2 2-player object layout
   32750/   17AF0 :                     +
   32751/   17AF0 :                     	; initialize each object load address with the first object in the layout
   32752/   17AF0 : 21C8 F770           	move.l	a0,(Obj_load_addr_right).w
   32753/   17AF4 : 21C8 F774           	move.l	a0,(Obj_load_addr_left).w
   32754/   17AF8 : 21C8 F778           	move.l	a0,(Obj_load_addr_right_P2).w
   32755/   17AFC : 21C8 F77C           	move.l	a0,(Obj_load_addr_left_P2).w
   32756/   17B00 : 45F8 FC00           	lea	(Object_Respawn_Table).w,a2
   32757/   17B04 : 34FC 0101           	move.w	#$0101,(a2)+	; the first two bytes are not used as respawn values
   32758/   17B08 :                     	; instead, they are used to keep track of the current respawn indexes
   32759/   17B08 :                     
