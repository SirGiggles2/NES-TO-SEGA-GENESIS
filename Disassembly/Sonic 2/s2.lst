   10269/    7822 :                     
   10270/    7822 :                      ; temporarily remap characters to title card letter format
   10271/    7822 :                      ; Characters are encoded as Aa, Bb, Cc, etc. through a macro
   10272/    7822 :                      charset 'A',0	; can't have an embedded 0 in a string
   10273/    7822 :                      charset 'B',"\4\8\xC\4\x10\x14\x18\x1C\x1E\x22\x26\x2A\4\4\x30\x34\x38\x3C\x40\x44\x48\x4C\x52\x56\4"
   10274/    7822 :                      charset 'a',"\4\4\4\4\4\4\4\4\2\4\4\4\6\4\4\4\4\4\4\4\4\4\6\4\4"
   10275/    7822 :                      charset '.',"\x5A"
   10276/    7822 :                     
   10277/    7822 :                     ; letter lookup string
   10278/    7822 : ="ABCDEFGHIJKLMN..   llookup	:= "ABCDEFGHIJKLMNOPQRSTUVWXYZ ."
   10279/    7822 :                     
   10280/    7822 :                     ; macro for defining title card letters in conjunction with the remapped character set
   10281/    7822 :                     titleLetters macro letters
   10282/    7822 :                          ;  ". ZYXWVUTSRQPONMLKJIHGFEDCBA"
   10283/    7822 :                     used := %0110000000000110000000010000	; set to initial state
   10284/    7822 :                         irpc char,letters
   10285/    7822 :                     	if ~~(used&1<<strstr(llookup,"char"))	; has the letter been used already?
   10286/    7822 :                     used := used|1<<strstr(llookup,"char")	; if not, mark it as used
   10287/    7822 :                     	dc.b "char"			; output letter code
   10288/    7822 :                     	if "char"=="."
   10289/    7822 :                     	dc.b 2			; output character size
   10290/    7822 :                     	else
   10291/    7822 :                     	dc.b lowstring("char")	; output letter size
   10292/    7822 :                     	endif
   10293/    7822 :                     	endif
   10294/    7822 :                         endm
   10295/    7822 :                     	dc.w $FFFF	; output string terminator
   10296/    7822 :                         endm
   10297/    7822 :                     
   10298/    7822 :                     ;word_7822:
   10299/    7822 :                     SpecialStage_ResultsLetters:
   10300/    7822 : (MACRO)              	titleLetters	"ACDGHILMPRSTUW."
   10300/    7822 :                          ;  ". ZYXWVUTSRQPONMLKJIHGFEDCBA"
   10300/    7822 : =$6006010            used := %0110000000000110000000010000   ; set to initial state
   10300/    7822 :                         irpc char,"ACDGHILMPRSTUW."
   10300/    7822 :                             if ~~(used&1<<strstr(llookup,"char"))   ; has the letter been used already?
   10300/    7822 :                     used := used|1<<strstr(llookup,"char")  ; if not, mark it as used
   10300/    7822 :                             dc.b "char"                     ; output letter code
   10300/    7822 :                             if "char"=="."
   10300/    7822 :                             dc.b 2                  ; output character size
   10300/    7822 :                             else
   10300/    7822 :                             dc.b lowstring("char")  ; output letter size
   10300/    7822 :                             endif
   10300/    7822 :                             endif
   10300/    7822 :                         endm
   10300/    7822 : =$6006011            used := used|1<<strstr(llookup,"A")  ; if not, mark it as used
   10300/    7822 : 00                          dc.b "A"                     ; output letter code
   10300/    7823 : 04                          dc.b lowstring("A")  ; output letter size
   10300/    7824 : =$6006015            used := used|1<<strstr(llookup,"C")  ; if not, mark it as used
   10300/    7824 : 08                          dc.b "C"                     ; output letter code
