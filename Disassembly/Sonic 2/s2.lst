    6196/    4CA8 : (MACRO)              	demoinput ,	$4C
    6196/    4CA8 : =$0                  btns_mask := 0
    6196/    4CA8 :                       irpc btn,""
    6196/    4CA8 :                         switch "btn"
    6196/    4CA8 :                         case "U"
    6196/    4CA8 :                     btns_mask := btns_mask|button_up_mask
    6196/    4CA8 :                         case "D"
    6196/    4CA8 :                     btns_mask := btns_mask|button_down_mask
    6196/    4CA8 :                         case "L"
    6196/    4CA8 :                     btns_mask := btns_mask|button_left_mask
    6196/    4CA8 :                         case "R"
    6196/    4CA8 :                     btns_mask := btns_mask|button_right_mask
    6196/    4CA8 :                         case "A"
    6196/    4CA8 :                     btns_mask := btns_mask|button_A_mask
    6196/    4CA8 :                         case "B"
    6196/    4CA8 :                     btns_mask := btns_mask|button_B_mask
    6196/    4CA8 :                         case "C"
    6196/    4CA8 :                     btns_mask := btns_mask|button_C_mask
    6196/    4CA8 :                         case "S"
    6196/    4CA8 :                     btns_mask := btns_mask|button_start_mask
    6196/    4CA8 :                         elsecase
    6196/    4CA8 :                         endcase
    6196/    4CA8 :                       endm
