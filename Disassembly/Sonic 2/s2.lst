    1671/    141E : 3601                	move.w	d1,d3
    1672/    1420 :                     
    1673/    1420 : 3C99                -	move.w	(a1)+,(a6)	; from source address to destination in VDP
    1674/    1422 : 51CB FFFC           	dbf	d3,-		; next tile
