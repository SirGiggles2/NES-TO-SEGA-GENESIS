   89649/   45A86 : =$1                  .zone_entries_left := .zone_entries-1
   89649/   45A86 : =$2                  .cur_zone_id := .cur_zone_id+1
   89649/   45A86 : ="2"                 .cur_zone_str := "\{.cur_zone_id}"
   89649/   45A86 :                                 shift
   89649/   45A86 :   (MACRO-3)                      zoneTableEntry.w 
