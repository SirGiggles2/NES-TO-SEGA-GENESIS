   19129/    DE70 :                     	; is $40 items long, this is incorrect, and will cause accesses to
   19130/    DE70 :                     	; exceed the bounds of CPZ_CameraSections and read invalid data. This
   19131/    DE70 :                     	; is most notably a problem in Marble Zone's version of this code.
   19132/    DE70 : 0240 07F0           	andi.w	#$7F0,d0
   19134/    DE74 : E848                	lsr.w	#4,d0
   19135/    DE76 : 41F0 0000           	lea	(a0,d0.w),a0
   19136/    DE7A : 6000 000A           	bra.w	DrawBlockColumn_Advanced
