   15234/    C542 : 323C 001F           	move.w	#32-1,d1
   15235/    C546 : 22C0                -	move.l	d0,(a1)+
   15236/    C548 : 51C9 FFFC           	dbf	d1,-
   15237/    C54C :                     
   15238/    C54C : 3600                	move.w	d0,d3
