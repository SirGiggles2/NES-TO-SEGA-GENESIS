   20112/    E482 :                     
   20113/    E482 :                     ;loadLevelLayout_Sonic1:
   20114/    E482 :                     	; This loads level layout data in Sonic 1's format. Curiously, this
   20115/    E482 :                     	; function has been changed since Sonic 1: in particular, it repeats
   20116/    E482 :                     	; the rows of the source data to fill the rows of the destination
   20117/    E482 :                     	; data, which provides some explanation for why so many of Sonic 2's
   20118/    E482 :                     	; backgrounds are repeated in their layout data. This repeating is
   20119/    E482 :                     	; needed to prevent Hidden Palace Zone's background from disappearing
   20120/    E482 :                     	; when the player moves to the left.
   20121/    E482 :                     
   20122/    E482 :                     	; Clear layout data.
   20123/    E482 : 47F8 8000           	lea	(Level_Layout).w,a3
   20124/    E486 : 323C 03FF           	move.w	#bytesToLcnt(Level_Layout_End-Level_Layout),d1
   20125/    E48A : 7000                	moveq	#0,d0
   20126/    E48C : 26C0                -	move.l	d0,(a3)+
   20127/    E48E : 51C9 FFFC           	dbf	d1,-
   20128/    E492 :                     
   20129/    E492 :                     	; The rows of the foreground and background layouts are interleaved
   20130/    E492 :                     	; in memory. This is done here:
   20131/    E492 : 47F8 8000           	lea	(Level_Layout).w,a3	; Foreground.
   20132/    E496 : 7200                	moveq	#0,d1			; Index into 'Off_Level' to get level foreground layout.
   20133/    E498 : 6100 0008           	bsr.w	.loadLayout
   20134/    E49C : 47F8 8080           	lea	(Level_Layout+$80).w,a3	; Background.
   20135/    E4A0 : 7202                	moveq	#2,d1			; Index into 'Off_Level' to get level background layout.
   20136/    E4A2 :                     
   20137/    E4A2 :                     ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
   20138/    E4A2 :                     
   20139/    E4A2 :                     ; sub_E4A2:
   20140/    E4A2 :                     .loadLayout:
   20141/    E4A2 :                     	; This expects 'Off_Level' to be in the format that it was in
   20142/    E4A2 :                     	; Sonic 1.
   20143/    E4A2 : 7000                	moveq	#0,d0
