   18944/    DD82 :                     Draw_BG3:
   18945/    DD82 : 4A12                	tst.b	(a2)
   18946/    DD84 : 6700 0048           	beq.w	++	; rts
   18947/    DD88 :                     
   18948/    DD88 : 0C38 000D FE10      	cmpi.b	#chemical_plant_zone,(Current_Zone).w
   18949/    DD8E : 6700 0082           	beq.w	Draw_BG3_CPZ
   18954/    DD92 :                     
