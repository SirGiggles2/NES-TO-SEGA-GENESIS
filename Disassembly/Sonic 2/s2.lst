   29597/   15F9C :                     ; -------------------------------------------------------------------------------
   29598/   15F9C :                     ; This runs the code of all the objects that are in Object_RAM
   29599/   15F9C :                     ; -------------------------------------------------------------------------------
   29600/   15F9C :                     
   29601/   15F9C :                     ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
   29602/   15F9C :                     
   29603/   15F9C :                     ; sub_15F9C: ObjectsLoad:
   29604/   15F9C :                     RunObjects:
   29605/   15F9C : 4A38 F623           	tst.b	(Teleport_flag).w
   29606/   15FA0 : 6642                	bne.s	RunObjects_End	; rts
   29607/   15FA2 : 41F8 B000           	lea	(Object_RAM).w,a0 ; a0=object
   29608/   15FA6 :                     
   29609/   15FA6 : 7E7F                	moveq	#(Object_RAM_End-Object_RAM)/object_size-1,d7 ; run the first $80 objects out of levels
   29610/   15FA8 : 7000                	moveq	#0,d0
   29611/   15FAA : 0C38 0008 F600      	cmpi.b	#GameModeID_Demo,(Game_Mode).w	; demo mode?
   29612/   15FB0 : 6708                	beq.s	+	; if in a level in a demo, branch
   29613/   15FB2 : 0C38 000C F600      	cmpi.b	#GameModeID_Level,(Game_Mode).w	; regular level mode?
   29614/   15FB8 : 6612                	bne.s	RunObject ; if not in a level, branch to RunObject
   29615/   15FBA :                     +
   29616/   15FBA : 3E3C 008F           	move.w	#(LevelOnly_Object_RAM_End-Object_RAM)/object_size-1,d7	; run the first $90 objects in levels
   29617/   15FBE : 4A78 FFD8           	tst.w	(Two_player_mode).w
   29618/   15FC2 : 6608                	bne.s	RunObject ; if in 2 player competition mode, branch to RunObject
   29619/   15FC4 :                     
   29620/   15FC4 : 0C38 0006 B024      	cmpi.b	#6,(MainCharacter+routine).w
   29621/   15FCA : 641A                	bhs.s	RunObjectsWhenPlayerIsDead ; if dead, branch
   29622/   15FCC :                     	; continue straight to RunObject
