   72295/   366D6 :                     ; ===========================================================================
   72296/   366D6 :                     ; ---------------------------------------------------------------------------
   72297/   366D6 :                     ; Get Orientation To Player
   72298/   366D6 :                     ; Returns the horizontal and vertical distances of the closest player object.
   72299/   366D6 :                     ;
   72300/   366D6 :                     ; input variables:
   72301/   366D6 :                     ;  a0 = object
   72302/   366D6 :                     ;
   72303/   366D6 :                     ; returns:
   72304/   366D6 :                     ;  a1 = address of closest player character
   72305/   366D6 :                     ;  d0 = 0 if player is left from object, 2 if right
   72306/   366D6 :                     ;  d1 = 0 if player is above object, 2 if below
   72307/   366D6 :                     ;  d2 = closest character's horizontal distance to object
   72308/   366D6 :                     ;  d3 = closest character's vertical distance to object
   72309/   366D6 :                     ;
   72310/   366D6 :                     ; writes:
   72311/   366D6 :                     ;  d0, d1, d2, d3, d4, d5
   72312/   366D6 :                     ;  a1
   72313/   366D6 :                     ;  a2 = sidekick
   72314/   366D6 :                     ; ---------------------------------------------------------------------------
   72315/   366D6 :                     ;loc_366D6:
   72316/   366D6 :                     Obj_GetOrientationToPlayer:
   72317/   366D6 : 7000                	moveq	#0,d0
   72318/   366D8 : 7200                	moveq	#0,d1
   72319/   366DA : 43F8 B000           	lea	(MainCharacter).w,a1 ; a1=character
   72320/   366DE : 3428 0008           	move.w	x_pos(a0),d2
   72321/   366E2 : 9469 0008           	sub.w	x_pos(a1),d2
   72322/   366E6 : (MACRO)              	mvabs.w	d2,d4	; absolute horizontal distance to main character
   72322/   366E6 : 3802                        move.w  d2,d4
   72322/   366E8 : 6A02                        bpl.s   .skip
   72322/   366EA : 4444                        neg.w   d4
   72322/   366EC :                     .skip:
   72323/   366EC : 45F8 B040           	lea	(Sidekick).w,a2 ; a2=character
   72324/   366F0 : 3628 0008           	move.w	x_pos(a0),d3
   72325/   366F4 : 966A 0008           	sub.w	x_pos(a2),d3
   72326/   366F8 : (MACRO)              	mvabs.w	d3,d5	; absolute horizontal distance to sidekick
   72326/   366F8 : 3A03                        move.w  d3,d5
   72326/   366FA : 6A02                        bpl.s   .skip
   72326/   366FC : 4445                        neg.w   d5
   72326/   366FE :                     .skip:
   72327/   366FE : B845                	cmp.w	d5,d4	; get shorter distance
   72328/   36700 : 6304                	bls.s	+	; branch, if main character is closer
   72329/   36702 :                     	; if sidekick is closer
   72330/   36702 : 224A                	movea.l	a2,a1
   72331/   36704 : 3403                	move.w	d3,d2
   72332/   36706 :                     +
   72333/   36706 : 4A42                	tst.w	d2	; is player to enemy's left?
   72334/   36708 : 6A02                	bpl.s	+	; if not, branch
   72335/   3670A : 5440                	addq.w	#2,d0
   72336/   3670C :                     +
   72337/   3670C : 3628 000C           	move.w	y_pos(a0),d3
   72338/   36710 : 9669 000C           	sub.w	y_pos(a1),d3	; vertical distance to closest character
   72339/   36714 : 6402                	bhs.s	+	; branch, if enemy is under
   72340/   36716 : 5441                	addq.w	#2,d1
   72341/   36718 :                     +
   72342/   36718 : 4E75                	rts
   72343/   3671A :                     ; ===========================================================================
   72344/   3671A :                     ; ---------------------------------------------------------------------------
   72345/   3671A :                     ; Cap Object Speed
   72346/   3671A :                     ; Prevents an object from going over a specified speed value.
   72347/   3671A :                     ;
   72348/   3671A :                     ; input variables:
   72349/   3671A :                     ;  d0 = max x velocity
   72350/   3671A :                     ;  d1 = max y velocity
   72351/   3671A :                     ;
   72352/   3671A :                     ;  a0 = object
   72353/   3671A :                     ;
   72354/   3671A :                     ; writes:
   72355/   3671A :                     ;  d0, d1, d2, d3
   72356/   3671A :                     ; ---------------------------------------------------------------------------
   72357/   3671A :                     ; loc_3671A:
   72358/   3671A :                     Obj_CapSpeed:
   72359/   3671A : 3428 0010           	move.w	x_vel(a0),d2
   72360/   3671E : 6A0C                	bpl.s	+	; branch, if object is moving right
   72361/   36720 :                     	; going left
   72362/   36720 : 4440                	neg.w	d0	; set opposite direction
   72363/   36722 : B440                	cmp.w	d0,d2	; is object's current x velocity lower than max?
   72364/   36724 : 640C                	bhs.s	++	; if yes, branch
   72365/   36726 : 3400                	move.w	d0,d2	; else, cap speed
   72366/   36728 : 6000 0008           	bra.w	++
   72367/   3672C :                     ; ===========================================================================
   72368/   3672C :                     +	; going right
   72369/   3672C : B440                	cmp.w	d0,d2	; is object's current x velocity lower than max?
   72370/   3672E : 6302                	bls.s	+	; if yes, branch
   72371/   36730 : 3400                	move.w	d0,d2	; else, cap speed
   72372/   36732 :                     +
   72373/   36732 : 3628 0012           	move.w	y_vel(a0),d3
   72374/   36736 : 6A0C                	bpl.s	+	; branch, if object is moving down
   72375/   36738 :                     	; going up
   72376/   36738 : 4441                	neg.w	d1	; set opposite direction
   72377/   3673A : B641                	cmp.w	d1,d3	; is object's current y velocity lower than max?
   72378/   3673C : 640C                	bhs.s	++	; if yes, branch
   72379/   3673E : 3601                	move.w	d1,d3	; else, cap speed
   72380/   36740 : 6000 0008           	bra.w	++
   72381/   36744 :                     ; ===========================================================================
   72382/   36744 :                     +	; going down
   72383/   36744 : B641                	cmp.w	d1,d3	; is object's current y velocity lower than max?
   72384/   36746 : 6302                	bls.s	+	; if yes, branch
   72385/   36748 : 3601                	move.w	d1,d3	; else, cap speed
   72386/   3674A :                     +	; update speed
   72387/   3674A : 3142 0010           	move.w	d2,x_vel(a0)
   72388/   3674E : 3143 0012           	move.w	d3,y_vel(a0)
   72389/   36752 : 4E75                	rts
   72390/   36754 :                     ; ===========================================================================
   72391/   36754 :                     ; ---------------------------------------------------------------------------
   72392/   36754 :                     ; Movement Stop
   72393/   36754 :                     ; Stops an object's movement.
   72394/   36754 :                     ;
   72395/   36754 :                     ; input variables:
   72396/   36754 :                     ;  a0 = object
   72397/   36754 :                     ;
   72398/   36754 :                     ; writes:
   72399/   36754 :                     ;  d0 = 0
   72400/   36754 :                     ; ---------------------------------------------------------------------------
   72401/   36754 :                     ;loc_36754:
   72402/   36754 :                     Obj_MoveStop:
   72403/   36754 : 7000                	moveq	#0,d0
   72404/   36756 : 3140 0010           	move.w	d0,x_vel(a0)
   72405/   3675A : 3140 0012           	move.w	d0,y_vel(a0)
   72406/   3675E : 4E75                	rts
   72407/   36760 :                     ; ===========================================================================
   72408/   36760 :                     ; ---------------------------------------------------------------------------
   72409/   36760 :                     ; Align Child XY
   72410/   36760 :                     ; Moves a referenced object to the position of the current object with
   72411/   36760 :                     ; variable x and y offset.
   72412/   36760 :                     ;
   72413/   36760 :                     ; input variables:
   72414/   36760 :                     ;  d0 = x offset
   72415/   36760 :                     ;  d1 = y offset
   72416/   36760 :                     ;
   72417/   36760 :                     ;  a0 = parent object
   72418/   36760 :                     ;  a1 = child object
   72419/   36760 :                     ;
   72420/   36760 :                     ; writes:
   72421/   36760 :                     ;  d2 = new x position
   72422/   36760 :                     ;  d3 = new y position
   72423/   36760 :                     ; ---------------------------------------------------------------------------
   72424/   36760 :                     ;loc_36760:
   72425/   36760 :                     Obj_AlignChildXY:
   72426/   36760 : 3428 0008           	move.w	x_pos(a0),d2
   72427/   36764 : D440                	add.w	d0,d2
