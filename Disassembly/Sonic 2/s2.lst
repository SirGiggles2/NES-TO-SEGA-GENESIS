   15210/    C51E :                     ; loc_C51E:
   15211/    C51E :                     SwScrl_Title:
   15212/    C51E :                     	; Update the background's vertical scrolling.
   15213/    C51E : 31F8 EE0C F618      	move.w	(Camera_BG_Y_pos).w,(Vscroll_Factor_BG).w
   15214/    C524 :                     
   15215/    C524 :                     	; Automatically scroll the background.
   15216/    C524 : 5278 EE00           	addq.w	#1,(Camera_X_pos).w
   15217/    C528 :                     
   15218/    C528 :                     	; Calculate the background X position from the foreground X position.
   15219/    C528 : 3438 EE00           	move.w	(Camera_X_pos).w,d2
   15220/    C52C : 4442                	neg.w	d2
   15221/    C52E : E442                	asr.w	#2,d2
   15222/    C530 :                     
   15223/    C530 :                     	; Update the background's (and foreground's) horizontal scrolling.
   15224/    C530 : 43F8 E000           	lea	(Horiz_Scroll_Buf).w,a1
   15225/    C534 :                     
   15226/    C534 :                     	; Do 160 lines that don't move.
   15227/    C534 : 7000                	moveq	#0,d0
   15228/    C536 : 323C 009F           	move.w	#160-1,d1
   15229/    C53A : 22C0                -	move.l	d0,(a1)+
   15230/    C53C : 51C9 FFFC           	dbf	d1,-
   15231/    C540 :                     
   15232/    C540 :                     	; Do 32 lines that scroll with the camera.
