   44059/   1F05E :                     ; Checks a 16x16 block to find solid walls. May check an additional
   44060/   1F05E :                     ; 16x16 block up for walls.
   44061/   1F05E :                     ; d5 = ($c,$d) or ($e,$f) - solidity type bit (L/R/B or top)
