   10457/    7A5E :                     
   10458/    7A5E :                      ; temporarily remap characters to title card letter format
   10459/    7A5E :                      ; Characters are encoded as Aa, Bb, Cc, etc. through a macro
   10460/    7A5E :                      charset 'A',0	; can't have an embedded 0 in a string
   10461/    7A5E :                      charset 'B',"\4\8\xC\4\x10\x14\x18\x1C\x1E\x22\x26\x2A\4\4\x30\x34\x38\x3C\x40\x44\x48\x4C\x52\x56\4"
   10462/    7A5E :                      charset 'a',"\4\4\4\4\4\4\4\4\2\4\4\4\6\4\4\4\4\4\4\4\4\4\6\4\4"
   10463/    7A5E :                      charset '.',"\x5A"
   10464/    7A5E :                     
   10465/    7A5E :                     ; Defines which letters load for the continue screen
   10466/    7A5E :                     ; Each letter occurs only once, and  the letters ENOZ (i.e. ZONE) aren't loaded here
   10467/    7A5E :                     ; However, this is hidden by the titleLetters macro, and normal titles can be used
   10468/    7A5E :                     ; (the macro is defined near SpecialStage_ResultsLetters, which uses it before here)
   10469/    7A5E :                     
   10470/    7A5E :                     ; word_7A5E:
   10471/    7A5E :                     ContinueScreen_AdditionalLetters:
   10472/    7A5E : (MACRO)              	titleLetters "CONTINUE"
   10472/    7A5E :                          ;  ". ZYXWVUTSRQPONMLKJIHGFEDCBA"
   10472/    7A5E : =$6006010            used := %0110000000000110000000010000   ; set to initial state
   10472/    7A5E :                         irpc char,"CONTINUE"
   10472/    7A5E :                             if ~~(used&1<<strstr(llookup,"char"))   ; has the letter been used already?
   10472/    7A5E :                     used := used|1<<strstr(llookup,"char")  ; if not, mark it as used
   10472/    7A5E :                             dc.b "char"                     ; output letter code
   10472/    7A5E :                             if "char"=="."
   10472/    7A5E :                             dc.b 2                  ; output character size
   10472/    7A5E :                             else
   10472/    7A5E :                             dc.b lowstring("char")  ; output letter size
   10472/    7A5E :                             endif
   10472/    7A5E :                             endif
   10472/    7A5E :                         endm
   10472/    7A5E : =$6006014            used := used|1<<strstr(llookup,"C")  ; if not, mark it as used
   10472/    7A5E : 08                          dc.b "C"                     ; output letter code
   10472/    7A5F : 04                          dc.b lowstring("C")  ; output letter size
   10472/    7A60 : =$6086014            used := used|1<<strstr(llookup,"T")  ; if not, mark it as used
   10472/    7A60 : 40                          dc.b "T"                     ; output letter code
   10472/    7A61 : 04                          dc.b lowstring("T")  ; output letter size
   10472/    7A62 : =$6086114            used := used|1<<strstr(llookup,"I")  ; if not, mark it as used
   10472/    7A62 : 1C                          dc.b "I"                     ; output letter code
   10472/    7A63 : 02                          dc.b lowstring("I")  ; output letter size
   10472/    7A64 : =$6186114            used := used|1<<strstr(llookup,"U")  ; if not, mark it as used
   10472/    7A64 : 44                          dc.b "U"                     ; output letter code
   10472/    7A65 : 04                          dc.b lowstring("U")  ; output letter size
   10472/    7A66 : FFFF                        dc.w $FFFF      ; output string terminator
   10473/    7A68 :                     
   10474/    7A68 :                      charset ; revert character set
