     343/      21 : ED 56               	im	1	; interrupt handling mode = 1
     344/      23 : 36 E9               	ld	(hl),0E9h ; replace the first instruction with a jump to itself
     345/      25 : E9                  	jp	(hl)	  ; jump to the first instruction (to stay there forever)
