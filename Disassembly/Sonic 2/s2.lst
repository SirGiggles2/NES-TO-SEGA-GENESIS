    5851/    498C :                     ; ---------------------------------------------------------------------------
    5852/    498C :                     ; dword_498C:
    5853/    498C :                     EndingDemoScriptPointers:
    5854/    498C :                     	; Empty, since Sonic 2 doesn't have demos during its credits.
    5855/    498C :                     ; ---------------------------------------------------------------------------
    5856/    498C :                     	; Leftover unused demo data from Sonic 1.
    5857/    498C :                     	; It involves Sonic slowly running right, jumping once,
    5858/    498C :                     	; then running at full speed for a few seconds.
    5859/    498C :                     	; Interestingly, this lines up with our knowledge of
    5860/    498C :                     	; the fabled Tokyo Game Show prototype.
    5861/    498C :                     	; See it in action: https://youtu.be/S8_IAfQbUu0
    5862/    498C : (MACRO)              	demoinput ,	$8C
    5862/    498C : =$0                  btns_mask := 0
    5862/    498C :                       irpc btn,""
    5862/    498C :                         switch "btn"
    5862/    498C :                         case "U"
    5862/    498C :                     btns_mask := btns_mask|button_up_mask
    5862/    498C :                         case "D"
    5862/    498C :                     btns_mask := btns_mask|button_down_mask
    5862/    498C :                         case "L"
    5862/    498C :                     btns_mask := btns_mask|button_left_mask
    5862/    498C :                         case "R"
    5862/    498C :                     btns_mask := btns_mask|button_right_mask
    5862/    498C :                         case "A"
    5862/    498C :                     btns_mask := btns_mask|button_A_mask
    5862/    498C :                         case "B"
    5862/    498C :                     btns_mask := btns_mask|button_B_mask
    5862/    498C :                         case "C"
    5862/    498C :                     btns_mask := btns_mask|button_C_mask
    5862/    498C :                         case "S"
    5862/    498C :                     btns_mask := btns_mask|button_start_mask
    5862/    498C :                         elsecase
    5862/    498C :                         endcase
    5862/    498C :                       endm
    5862/    498C : 008B                        dc.b    btns_mask,$8C-1
