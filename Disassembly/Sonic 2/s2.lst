   84772/   3F74A : B069 000C           	cmp.w	y_pos(a1),d0
   84773/   3F74E :                     	; Return. This means that if Sonic jumps upwards into the side of a
   84774/   3F74E :                     	; monitor, then he'll just phase through it.
   84775/   3F74E : 653A                	blo.s	return_3F78A
   84776/   3F750 :                     
   84777/   3F750 :                     	; If we've gotten this far, then Sonic has just jumped into the
   84778/   3F750 :                     	; bottom of this monitor: knock it down.
