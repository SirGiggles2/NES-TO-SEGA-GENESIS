(1)    1/   EC0E8 :                     ; Sonic the Hedgehog 2 disassembled Z80 sound driver
(1)    2/   EC0E8 :                     
(1)    3/   EC0E8 :                     ; Disassembled by Xenowhirl for AS
(1)    4/   EC0E8 :                     ; Additional disassembly work by RAS Oct 2008
(1)    5/   EC0E8 :                     ; RAS' work merged into SVN by Flamewing
(1)    6/   EC0E8 :                     ; ---------------------------------------------------------------------------
(1)    7/   EC0E8 :                     
(1)    8/   EC0E8 : =$0                  FixDriverBugs = fixBugs
(1)    9/   EC0E8 : =$0                  OptimiseDriver = 0
(1)   10/   EC0E8 :                     
(1)   11/   EC0E8 :                     ; ---------------------------------------------------------------------------
(1)   12/   EC0E8 :                     ; NOTES:
(1)   13/   EC0E8 :                     ;
(1)   14/   EC0E8 :                     ; Set your editor's tab width to 8 characters wide for viewing this file.
(1)   15/   EC0E8 :                     ;
(1)   16/   EC0E8 :                     ; This code is compressed in the ROM, but you can edit it here as uncompressed
(1)   17/   EC0E8 :                     ; and it will automatically be assembled and compressed into the correct place
(1)   18/   EC0E8 :                     ; during the build process.
(1)   19/   EC0E8 :                     ;
(1)   20/   EC0E8 :                     ; This Z80 code can use labels and equates defined in the 68k code,
(1)   21/   EC0E8 :                     ; and the 68k code can use the labels and equates defined in here.
(1)   22/   EC0E8 :                     ; This is fortunate, as they contain references to each other's addresses.
(1)   23/   EC0E8 :                     ;
(1)   24/   EC0E8 :                     ; If you want to add significant amounts of extra code to this driver,
(1)   25/   EC0E8 :                     ; try putting your code as far down as possible, after the function zDecEnd.
(1)   26/   EC0E8 :                     ; That will make you less likely to run into space shortages from dislocated data alignment.
(1)   27/   EC0E8 :                     ;
(1)   28/   EC0E8 :                     ; >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
(1)   29/   EC0E8 :                     ; Setup defines and macros
(1)   30/   EC0E8 :                     
(1)   31/   EC0E8 :                     	; zComRange:	@ 1B80h
(1)   32/   EC0E8 :                     	; 	+00h	-- Priority of current SFX (cleared when 1-up song is playing)
(1)   33/   EC0E8 :                     	; 	+01h	-- tempo clock
(1)   34/   EC0E8 :                     	; 	+02h	-- current tempo
(1)   35/   EC0E8 :                     	; 	+03h	-- Pause/unpause flag: 7Fh for pause; 80h for unpause (set from 68K)
(1)   36/   EC0E8 :                     	; 	+04h	-- total volume levels to continue decreasing volume before fade out considered complete (starts at 28h, works downward)
(1)   37/   EC0E8 :                     	; 	+05h	-- delay ticker before next volume decrease
(1)   38/   EC0E8 :                     	; 	+06h	-- communication value
(1)   39/   EC0E8 :                     	; 	+07h	-- "DAC is updating" flag (set to FFh until completion of DAC track change)
(1)   40/   EC0E8 :                     	; 	+08h	-- When NOT set to 80h, 68K request new sound index to play
(1)   41/   EC0E8 :                     	; 	+09h	-- SFX to Play queue slot
(1)   42/   EC0E8 :                     	; 	+0Ah	-- Play stereo sound queue slot
(1)   43/   EC0E8 :                     	; 	+0Bh	-- Unknown SFX Queue slot
(1)   44/   EC0E8 :                     	; 	+0Ch	-- Address to table of voices
(1)   45/   EC0E8 :                     	;
(1)   46/   EC0E8 :                     	; 	+0Eh	-- Set to 80h while fading in (disabling SFX) then 00h
(1)   47/   EC0E8 :                     	; 	+0Fh	-- Same idea as +05h, except for fade IN
(1)   48/   EC0E8 :                     	; 	+10h	-- Same idea as +04h, except for fade IN
(1)   49/   EC0E8 :                     	; 	+11h	-- 80h set indicating 1-up song is playing (stops other sounds)
(1)   50/   EC0E8 :                     	; 	+12h	-- main tempo value
(1)   51/   EC0E8 :                     	; 	+13h	-- original tempo for speed shoe restore
(1)   52/   EC0E8 :                     	; 	+14h	-- Speed shoes flag
(1)   53/   EC0E8 :                     	; 	+15h	-- If 80h, FM Channel 6 is NOT in use (DAC enabled)
(1)   54/   EC0E8 :                     	; 	+16h	-- value of which music bank to use (0 for MusicPoint1, $80 for MusicPoint2)
(1)   55/   EC0E8 :                     	; 	+17h	-- Pal mode flag
(1)   56/   EC0E8 :                     	;
(1)   57/   EC0E8 :                     	; ** zTracksSongStart starts @ +18h
(1)   58/   EC0E8 :                     	;
(1)   59/   EC0E8 :                     	; 	1B98 base
(1)   60/   EC0E8 :                     	; 	Track 1 = DAC
(1)   61/   EC0E8 :                     	; 	Then 6 FM
(1)   62/   EC0E8 :                     	; 	Then 3 PSG
(1)   63/   EC0E8 :                     	;
(1)   64/   EC0E8 :                     	;
(1)   65/   EC0E8 :                     	; 	1B98 = DAC
(1)   66/   EC0E8 :                     	; 	1BC2 = FM 1
(1)   67/   EC0E8 :                     	; 	1BEC = FM 2
(1)   68/   EC0E8 :                     	; 	1C16 = FM 3
(1)   69/   EC0E8 :                     	; 	1C40 = FM 4
(1)   70/   EC0E8 :                     	; 	1C6A = FM 5
(1)   71/   EC0E8 :                     	; 	1C94 = FM 6
(1)   72/   EC0E8 :                     	; 	1CBE = PSG 1
(1)   73/   EC0E8 :                     	; 	1CE8 = PSG 2
(1)   74/   EC0E8 :                     	; 	1D12 = PSG 3 (tone or noise)
(1)   75/   EC0E8 :                     	;
(1)   76/   EC0E8 :                     	; 	1D3C = SFX FM 3
(1)   77/   EC0E8 :                     	; 	1D66 = SFX FM 4
(1)   78/   EC0E8 :                     	; 	1D90 = SFX FM 5
(1)   79/   EC0E8 :                     	; 	1DBA = SFX PSG 1
(1)   80/   EC0E8 :                     	; 	1DE4 = SFX PSG 2
(1)   81/   EC0E8 :                     	; 	1E0E = SFX PSG 3 (tone or noise)
(1)   82/   EC0E8 :                     	;
(1)   83/   EC0E8 :                     	;
(1)   84/       0 :                     zTrack STRUCT DOTS
(1)   85/       0 :                     	; 	"playback control"; bits:
(1)   86/       0 :                     	; 	1 (02h): track is at rest
(1)   87/       0 :                     	; 	2 (04h): SFX is overriding this track
(1)   88/       0 :                     	; 	3 (08h): modulation on
(1)   89/       0 :                     	; 	4 (10h): do not attack next note
(1)   90/       0 :                     	; 	7 (80h): track is playing
(1)   91/       0 : (MACRO)              	PlaybackControl:	ds.b 1
(1)   91/       0 :                                     !ds.b 1
(1)   92/       1 :                     	; 	"voice control"; bits:
(1)   93/       1 :                     	; 	2 (04h): If set, bound for part II, otherwise 0 (see zWriteFMIorII)
(1)   94/       1 :                     	; 		-- bit 2 has to do with sending key on/off, which uses this differentiation bit directly
(1)   95/       1 :                     	; 	7 (80h): PSG track
(1)   96/       1 : (MACRO)              	VoiceControl:		ds.b 1
(1)   96/       1 :                                     !ds.b 1
(1)   97/       2 : (MACRO)              	TempoDivider:		ds.b 1	; Timing divisor; 1 = Normal, 2 = Half, 3 = Third...
(1)   97/       2 :                                     !ds.b 1
(1)   98/       3 : (MACRO)              	DataPointerLow:		ds.b 1	; Track's position low byte
(1)   98/       3 :                                     !ds.b 1
(1)   99/       4 : (MACRO)              	DataPointerHigh:	ds.b 1	; Track's position high byte
(1)   99/       4 :                                     !ds.b 1
(1)  100/       5 : (MACRO)              	Transpose:		ds.b 1	; Transpose (from coord flag E9)
(1)  100/       5 :                                     !ds.b 1
(1)  101/       6 : (MACRO)              	Volume:			ds.b 1	; Channel volume (only applied at voice changes)
(1)  101/       6 :                                     !ds.b 1
(1)  102/       7 : (MACRO)              	AMSFMSPan:		ds.b 1	; Panning / AMS / FMS settings
(1)  102/       7 :                                     !ds.b 1
(1)  103/       8 : (MACRO)              	VoiceIndex:		ds.b 1	; Current voice in use OR current PSG tone
(1)  103/       8 :                                     !ds.b 1
(1)  104/       9 : (MACRO)              	VolFlutter:		ds.b 1	; PSG flutter (dynamically affects PSG volume for decay effects)
(1)  104/       9 :                                     !ds.b 1
(1)  105/       A : (MACRO)              	StackPointer:		ds.b 1	; "Gosub" stack position offset (starts at 2Ah, i.e. end of track, and each jump decrements by 2)
(1)  105/       A :                                     !ds.b 1
(1)  106/       B : (MACRO)              	DurationTimeout:	ds.b 1	; Current duration timeout; counting down to zero
(1)  106/       B :                                     !ds.b 1
(1)  107/       C : (MACRO)              	SavedDuration:		ds.b 1	; Last set duration (if a note follows a note, this is reapplied to 0Bh)
(1)  107/       C :                                     !ds.b 1
(1)  108/       D :                     	;
(1)  109/       D :                     	; 	; 0Dh / 0Eh change a little depending on track -- essentially they hold data relevant to the next note to play
(1)  110/       D :                     	SavedDAC:			; DAC: Next drum to play
(1)  111/       D : (MACRO)              	FreqLow:		ds.b 1	; FM/PSG: frequency low byte
(1)  111/       D :                                     !ds.b 1
(1)  112/       E : (MACRO)              	FreqHigh:		ds.b 1	; FM/PSG: frequency high byte
(1)  112/       E :                                     !ds.b 1
(1)  113/       F : (MACRO)              	NoteFillTimeout:	ds.b 1	; Currently set note fill; counts down to zero and then cuts off note
(1)  113/       F :                                     !ds.b 1
(1)  114/      10 : (MACRO)              	NoteFillMaster:		ds.b 1	; Reset value for current note fill
(1)  114/      10 :                                     !ds.b 1
(1)  115/      11 : (MACRO)              	ModulationPtrLow:	ds.b 1	; Low byte of address of current modulation setting
(1)  115/      11 :                                     !ds.b 1
(1)  116/      12 : (MACRO)              	ModulationPtrHigh:	ds.b 1	; High byte of address of current modulation setting
(1)  116/      12 :                                     !ds.b 1
(1)  117/      13 : (MACRO)              	ModulationWait:		ds.b 1	; Wait for ww period of time before modulation starts
(1)  117/      13 :                                     !ds.b 1
(1)  118/      14 : (MACRO)              	ModulationSpeed:	ds.b 1	; Modulation speed
(1)  118/      14 :                                     !ds.b 1
(1)  119/      15 : (MACRO)              	ModulationDelta:	ds.b 1	; Modulation change per mod. Step
(1)  119/      15 :                                     !ds.b 1
(1)  120/      16 : (MACRO)              	ModulationSteps:	ds.b 1	; Number of steps in modulation (divided by 2)
(1)  120/      16 :                                     !ds.b 1
(1)  121/      17 : (MACRO)              	ModulationValLow:	ds.b 1	; Current modulation value low byte
(1)  121/      17 :                                     !ds.b 1
(1)  122/      18 : (MACRO)              	ModulationValHigh:	ds.b 1	; Current modulation value high byte
(1)  122/      18 :                                     !ds.b 1
(1)  123/      19 : (MACRO)              	Detune:			ds.b 1	; Set by detune coord flag E1; used to add directly to FM/PSG frequency
(1)  123/      19 :                                     !ds.b 1
(1)  124/      1A : (MACRO)              	VolTLMask:		ds.b 1	; zVolTLMaskTbl value set during voice setting (value based on algorithm indexing zGain table)
(1)  124/      1A :                                     !ds.b 1
(1)  125/      1B : (MACRO)              	PSGNoise:		ds.b 1	; PSG noise setting
(1)  125/      1B :                                     !ds.b 1
(1)  126/      1C : (MACRO)              	VoicePtrLow:		ds.b 1	; Low byte of custom voice table (for SFX)
(1)  126/      1C :                                     !ds.b 1
(1)  127/      1D : (MACRO)              	VoicePtrHigh:		ds.b 1	; High byte of custom voice table (for SFX)
(1)  127/      1D :                                     !ds.b 1
(1)  128/      1E : (MACRO)              	TLPtrLow:		ds.b 1	; Low byte of where TL bytes of current voice begin (set during voice setting)
(1)  128/      1E :                                     !ds.b 1
(1)  129/      1F : (MACRO)              	TLPtrHigh:		ds.b 1	; High byte of where TL bytes of current voice begin (set during voice setting)
(1)  129/      1F :                                     !ds.b 1
(1)  130/      20 : (MACRO)              	LoopCounters:		ds.b $A	; Loop counter index 0
(1)  130/      20 :                                     !ds.b $A
(1)  131/      2A :                     	;   ... open ...
(1)  132/      2A :                     	GoSubStack:			; start of next track, every two bytes below this is a coord flag "gosub" (F8h) return stack
(1)  133/      2A :                     	;
(1)  134/      2A :                     	;	The bytes between +20h and +29h are "open"; starting at +20h and going up are possible loop counters
(1)  135/      2A :                     	;	(for coord flag F7) while +2Ah going down (never AT 2Ah though) are stacked return addresses going
(1)  136/      2A :                     	;	down after calling coord flag F8h.  Of course, this does mean collisions are possible with either
(1)  137/      2A :                     	;	or other track memory if you're not careful with these!  No range checking is performed!
(1)  138/      2A :                     	;
(1)  139/      2A :                     	; 	All tracks are 2Ah bytes long
