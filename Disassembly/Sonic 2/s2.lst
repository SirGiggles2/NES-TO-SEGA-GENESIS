   90740/   EC000 :                     ; Subroutine to load the sound driver
   90741/   EC000 :                     ; ---------------------------------------------------------------------------
   90742/   EC000 :                     ; sub_EC000:
   90743/   EC000 :                     SoundDriverLoad:
   90744/   EC000 : 40E7                	move	sr,-(sp)
   90745/   EC002 : 48E7 FFFE           	movem.l	d0-a6,-(sp)
   90746/   EC006 : 46FC 2700           	move	#$2700,sr
   90747/   EC00A : 47F9 00A1 1100      	lea	(Z80_Bus_Request).l,a3
   90748/   EC010 : 45F9 00A1 1200      	lea	(Z80_Reset).l,a2
   90749/   EC016 : 7400                	moveq	#0,d2
   90750/   EC018 : 323C 0100           	move.w	#$100,d1
   90751/   EC01C : 3681                	move.w	d1,(a3)	; get Z80 bus
   90752/   EC01E : 3481                	move.w	d1,(a2)	; release Z80 reset (was held high by console on startup)
   90753/   EC020 : 0513                -	btst	d2,(a3)
   90754/   EC022 : 66FC                	bne.s	-	; wait until the 68000 has the bus
   90755/   EC024 : 4EBA 0024           	jsr	DecompressSoundDriver(pc)
   90756/   EC028 : 0839 0000 00C0      	btst	#0,(VDP_control_port+1).l	; check video mode
            EC02E : 0005             
   90757/   EC030 : 56F9 00A0 0007      	sne	(Z80_RAM+zPalModeByte).l	; set if PAL
   90758/   EC036 : 3482                	move.w	d2,(a2)	; hold Z80 reset
   90759/   EC038 : 3682                	move.w	d2,(a3)	; release Z80 bus
   90760/   EC03A : 70E6                	moveq	#signextendB($E6),d0
   90761/   EC03C : 51C8 FFFE           -	dbf	d0,-	; wait for 2,314 cycles
   90762/   EC040 : 3481                	move.w	d1,(a2)	; release Z80 reset
   90763/   EC042 : 4CDF 7FFF           	movem.l	(sp)+,d0-a6
   90764/   EC046 : 46DF                	move	(sp)+,sr
   90765/   EC048 : 4E75                	rts
   90766/   EC04A :                     
   90767/   EC04A :                     ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
   90768/   EC04A :                     ; Handles the decompression of the sound driver (Saxman compression, an LZSS variant)
   90769/   EC04A :                     ; https://segaretro.org/Saxman_compression
   90770/   EC04A :                     
   90771/   EC04A :                     ; a4 == start of decompressed data (used for dictionary match offsets)
   90772/   EC04A :                     ; a5 == current address of end of decompressed data
   90773/   EC04A :                     ; a6 == current address in compressed sound driver
   90774/   EC04A :                     ; d3 == length of match minus 1
   90775/   EC04A :                     ; d4 == offset into decompressed data of dictionary match
   90776/   EC04A :                     ; d5 == number of bytes decompressed so far
   90777/   EC04A :                     ; d6 == descriptor field
   90778/   EC04A :                     ; d7 == bytes left to decompress
   90779/   EC04A :                     
   90780/   EC04A :                     ; Interestingly, this appears to be a direct translation of the Z80 version in the sound driver
   90781/   EC04A :                     ; (or maybe the Z80 version is a direct translation of this...)
   90782/   EC04A :                     
   90783/   EC04A :                     ; loc_EC04A:
   90784/   EC04A :                     DecompressSoundDriver:
   90785/   EC04A : 4DFA 009C           	lea	Snd_Driver(pc),a6
   90786/   EC04E :                     ; WARNING: the build script needs editing if you rename this label
   90787/   EC04E : 3E3C 0F64           movewZ80CompSize:	move.w	#Snd_Driver_End-Snd_Driver,d7 ; patched (by build.lua) after compression since the exact size can't be known beforehand
   90788/   EC052 : 7C00                	moveq	#0,d6	; The decompressor knows it's run out of descriptor bits when it starts reading 0's in bit 8
   90789/   EC054 : 4BF9 00A0 0000      	lea	(Z80_RAM).l,a5
   90790/   EC05A : 7A00                	moveq	#0,d5
   90791/   EC05C : 49F9 00A0 0000      	lea	(Z80_RAM).l,a4
   90792/   EC062 :                     ; loc_EC062:
   90793/   EC062 :                     SaxDec_Loop:
   90794/   EC062 : E24E                	lsr.w	#1,d6	; Next descriptor bit
   90795/   EC064 : 0806 0008           	btst	#8,d6	; Check if we've run out of bits
   90796/   EC068 : 660A                	bne.s	+	; (lsr 'shifts in' 0's)
   90797/   EC06A : 4EBA 0072           	jsr	SaxDec_GetByte(pc)
   90798/   EC06E : 1C00                	move.b	d0,d6
   90799/   EC070 : 0046 FF00           	ori.w	#$FF00,d6	; These set bits will disappear from the high byte as the register is shifted
   90800/   EC074 :                     +
   90801/   EC074 : 0806 0000           	btst	#0,d6
   90802/   EC078 : 670C                	beq.s	SaxDec_ReadCompressed
   90803/   EC07A :                     
   90804/   EC07A :                     ; SaxDec_ReadUncompressed:
   90805/   EC07A : 4EBA 0062           	jsr	SaxDec_GetByte(pc)
   90806/   EC07E : 1AC0                	move.b	d0,(a5)+
   90807/   EC080 : 5245                	addq.w	#1,d5
   90808/   EC082 : 6000 FFDE           	bra.w	SaxDec_Loop
   90809/   EC086 :                     ; ---------------------------------------------------------------------------
   90810/   EC086 :                     ; loc_EC086:
   90811/   EC086 :                     SaxDec_ReadCompressed:
   90812/   EC086 : 4EBA 0056           	jsr	SaxDec_GetByte(pc)
   90813/   EC08A : 7800                	moveq	#0,d4
   90814/   EC08C : 1800                	move.b	d0,d4
   90815/   EC08E : 4EBA 004E           	jsr	SaxDec_GetByte(pc)
   90816/   EC092 : 1600                	move.b	d0,d3
   90817/   EC094 : 0243 000F           	andi.w	#$F,d3
   90818/   EC098 : 5443                	addq.w	#2,d3	; d3 is the length of the match minus 1
   90819/   EC09A : 0240 00F0           	andi.w	#$F0,d0
   90820/   EC09E : E948                	lsl.w	#4,d0
   90821/   EC0A0 : D840                	add.w	d0,d4
   90822/   EC0A2 : 0644 0012           	addi.w	#$12,d4
   90823/   EC0A6 : 0244 0FFF           	andi.w	#$FFF,d4	; d4 is the offset into the current $1000-byte window
   90824/   EC0AA :                     	; This part is a little tricky. You see, d4 currently contains the low three nibbles of an offset into the decompressed data,
   90825/   EC0AA :                     	; where the dictionary match lies. The way the high nibble is decided is first by taking it from d5 - the offset of the end
   90826/   EC0AA :                     	; of the decompressed data so far. Then, we see if the resulting offset in d4 is somehow higher than d5.
   90827/   EC0AA :                     	; If it is, then it's invalid... *unless* you subtract $1000 from it, in which case it refers to data in the previous $1000 block of bytes.
   90828/   EC0AA :                     	; This is all just a really gimmicky way of having an offset with a range of $1000 bytes from the end of the decompressed data.
   90829/   EC0AA :                     	; If, however, we cannot subtract $1000 because that would put the pointer before the start of the decompressed data, then
   90830/   EC0AA :                     	; this is actually a 'zero-fill' match, which encodes a series of zeroes.
   90831/   EC0AA : 3005                	move.w	d5,d0
   90832/   EC0AC : 0240 F000           	andi.w	#$F000,d0
   90833/   EC0B0 : D840                	add.w	d0,d4
   90834/   EC0B2 : BA44                	cmp.w	d4,d5
   90835/   EC0B4 : 6416                	bhs.s	SaxDec_IsDictionaryReference
