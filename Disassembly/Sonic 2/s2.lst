   70920/   35604 :                      ; temporarily remap characters to title card letter format
   70921/   35604 :                      ; Characters are encoded as Aa, Bb, Cc, etc. through a macro
   70922/   35604 :                      charset 'a','z','A'	; Convert to uppercase
   70923/   35604 :                      charset 'A',"\xD\x11\7\x11\1\x11"
   70924/   35604 :                      charset 'G',0	; can't have an embedded 0 in a string
   70925/   35604 :                      charset 'H',"\xB\4\x11\x11\9\xF\5\8\xC\x11\3\6\2\xA\x11\x10\x11\xE\x11"
   70926/   35604 :                      charset '!',"\x11"
   70927/   35604 :                      charset '.',"\x12"
   70928/   35604 :                     
   70929/   35604 :                     specialText macro letters
   70930/   35604 :                     	dc.b letters
