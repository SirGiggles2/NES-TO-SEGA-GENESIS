   19051/    DE11 :                     
   19052/    DE11 :                     	; Total height: 8 128x128 chunks.
   19053/    DE11 :                     	; CPZ's background is only 7 chunks tall, but extending to
   19054/    DE11 :                     	; 8 is necessary for wrapping to be achieved using bitmasks.
   19055/    DE11 :                     
   19056/    DE11 : (MACRO)              	even
   19056/    DE11 : =$F                  paddingSoFar            set paddingSoFar+1
   19056/    DE11 : 00                                          dc.b 0 ;ds.b 1 
   19057/    DE12 :                     
   19058/    DE12 :                     ; ===========================================================================
   19059/    DE12 :                     ; loc_DE12:
   19060/    DE12 :                     Draw_BG3_CPZ:
   19061/    DE12 :                     	; This is a lighty-modified duplicate of Scrap Brain Zone's drawing
   19062/    DE12 :                     	; code (which is still in this game - it's labelled 'Draw_BG2_SBZ').
   19063/    DE12 :                     	; This is an advanced form of the usual background-drawing code that
   19064/    DE12 :                     	; allows each row of blocks to update and scroll independently...
   19065/    DE12 :                     	; kind of. There are only three possible 'cameras' that each row can
   19066/    DE12 :                     	; align itself with. Still, each row is free to decide which camera
   19067/    DE12 :                     	; it aligns with.
   19068/    DE12 :                     	; This could have really benefitted Oil Ocean Zone's background,
   19069/    DE12 :                     	; which has a section that goes unseen because the regular background
   19070/    DE12 :                     	; drawer is too primitive to display it without making the sun and
   19071/    DE12 :                     	; clouds disappear. Using this would have avoided that.
   19072/    DE12 :                     	; This code differs from the Scrap Brain Zone version by being
   19073/    DE12 :                     	; hardcoded to a different table ('CPZ_CameraSections' instead of
   19074/    DE12 :                     	; 'SBZ_CameraSections'), and lacking support for redrawing the whole
   19075/    DE12 :                     	; row when it uses "camera 0".
   19076/    DE12 :                     
   19077/    DE12 :                     	; Handle loading the rows as the camera moves up and down.
   19078/    DE12 : 78F0                	moveq	#-block_height,d4	; Y offset
   19079/    DE14 : 0892 0000           	bclr	#scroll_flag_advanced_bg_up,(a2)
   19080/    DE18 : 660A                	bne.s	.doUpOrDown
   19081/    DE1A : 0892 0001           	bclr	#scroll_flag_advanced_bg_down,(a2)
   19082/    DE1E : 672E                	beq.s	.checkIfShouldDoLeftOrRight
   19083/    DE20 : 383C 00E0           	move.w	#screen_height,d4	; Y offset
   19084/    DE24 :                     
   19085/    DE24 :                     .doUpOrDown:
   19086/    DE24 :                     	; Select the correct camera, so that the X value of the loaded row is
   19087/    DE24 :                     	; right.
   19088/    DE24 : (MACRO)              	lea_	CPZ_CameraSections+1,a0
   19088/    DE24 : 41FA FFAB                           !lea CPZ_CameraSections+1(pc),a0
   19089/    DE28 : 3038 EE0C           	move.w	(Camera_BG_Y_pos).w,d0
   19090/    DE2C : D044                	add.w	d4,d0
   19091/    DE2E : 0240 03F0           	andi.w	#$3F0,d0	; After right-shifting, the is a mask of $3F. Since CPZ_CameraSections is $40 items long, this is correct.
   19092/    DE32 : E848                	lsr.w	#4,d0
   19093/    DE34 : 1030 0000           	move.b	(a0,d0.w),d0
   19094/    DE38 : 367B 0044           	movea.w	BGCameraLookup(pc,d0.w),a3	; Camera, either BG, BG2 or BG3 depending on Y
   19095/    DE3C : 7AF0                	moveq	#-block_width,d5	; X offset
   19096/    DE3E : 48E7 0C00           	movem.l	d4-d5,-(sp)
   19097/    DE42 : 6100 0442           	bsr.w	CalculateVRAMAddressOfBlockForPlayer1
   19098/    DE46 : 4CDF 0030           	movem.l	(sp)+,d4-d5
   19099/    DE4A : 6100 0146           	bsr.w	DrawBlockRow
   19100/    DE4E :                     
   19101/    DE4E :                     .checkIfShouldDoLeftOrRight:
   19102/    DE4E :                     	; If there are other scroll flags set, then go do them.
   19103/    DE4E : 4A12                	tst.b	(a2)
   19104/    DE50 : 6602                	bne.s	.doLeftOrRight
   19105/    DE52 : 4E75                	rts
