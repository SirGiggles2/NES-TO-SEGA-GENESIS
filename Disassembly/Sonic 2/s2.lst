    5908/    49E8 :                     ; ===========================================================================
    5909/    49E8 :                     ; ---------------------------------------------------------------------------
    5910/    49E8 :                     ; Pointers to primary collision indexes
    5911/    49E8 :                     
    5912/    49E8 :                     ; Contains an array of pointers to the primary collision index data for each
    5913/    49E8 :                     ; level. 1 pointer for each level, pointing the primary collision index.
    5914/    49E8 :                     ; ---------------------------------------------------------------------------
    5915/    49E8 : (MACRO)              Off_ColP: zoneOrderedTable 4,1
    5915/    49E8 : =$49E8               Off_ColP label *
    5915/    49E8 :                     ; set some global variables
    5915/    49E8 : ="Off_ColP"          .zone_table_name := "Off_ColP"
    5915/    49E8 : =$49E8               .zone_table_addr := *
    5915/    49E8 : =$4                  .zone_entry_len := 4
    5915/    49E8 : =$1                  .zone_entries := 1
    5915/    49E8 : =$0                  .zone_entries_left := 0
