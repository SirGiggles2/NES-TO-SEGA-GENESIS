   88535/   42594 :                     ; ---------------------------------------------------------------------------
   88536/   42594 :                     ; "MAIN LEVEL LOAD BLOCK" (after Nemesis)
   88537/   42594 :                     ;
   88538/   42594 :                     ; This struct array tells the engine where to find all the art associated with
   88539/   42594 :                     ; a particular zone. Each zone gets three longwords, in which it stores three
   88540/   42594 :                     ; pointers (in the lower 24 bits) and three jump table indeces (in the upper eight
   88541/   42594 :                     ; bits). The assembled data looks something like this:
   88542/   42594 :                     ;
   88543/   42594 :                     ; aaBBBBBB
   88544/   42594 :                     ; ccDDDDDD
   88545/   42594 :                     ; eeFFFFFF
   88546/   42594 :                     ;
   88547/   42594 :                     ; aa = index for primary pattern load request list
   88548/   42594 :                     ; BBBBBB = pointer to level art
   88549/   42594 :                     ; cc = index for secondary pattern load request list
   88550/   42594 :                     ; DDDDDD = pointer to 16x16 block mappings
   88551/   42594 :                     ; ee = index for palette
   88552/   42594 :                     ; FFFFFF = pointer to 128x128 block mappings
   88553/   42594 :                     ;
   88554/   42594 :                     ; Nemesis refers to this as the "main level load block". However, that name implies
   88555/   42594 :                     ; that this is code (obviously, it isn't), or at least that it points to the level's
   88556/   42594 :                     ; collision, object and ring placement arrays (it only points to art...
   88557/   42594 :                     ; although the 128x128 mappings do affect the actual level layout and collision)
   88558/   42594 :                     ; ---------------------------------------------------------------------------
   88559/   42594 :                     
   88560/   42594 :                     ; declare some global variables to be used by the levartptrs macro
   88561/   42594 : =$0                  cur_zone_id := 0
   88562/   42594 : ="0"                 cur_zone_str := "0"
   88563/   42594 :                     
   88564/   42594 :                     ; macro for declaring a "main level load block" (MLLB)
   88565/   42594 :                     levartptrs macro plc1,plc2,palette,art,map16x16,map128x128
   88566/   42594 :                     	!org LevelArtPointers+zone_id_{cur_zone_str}*12
   88567/   42594 :                     	dc.l (plc1<<24)|art
   88568/   42594 :                     	dc.l (plc2<<24)|map16x16
   88569/   42594 :                     	dc.l (palette<<24)|map128x128
   88570/   42594 :                     cur_zone_id := cur_zone_id+1
   88571/   42594 :                     cur_zone_str := "\{cur_zone_id}"
   88572/   42594 :                         endm
   88573/   42594 :                     
   88574/   42594 :                     ; BEGIN SArt_Ptrs Art_Ptrs_Array[17]
   88575/   42594 :                     ; dword_42594: MainLoadBlocks: saArtPtrs:
   88576/   42594 :                     LevelArtPointers:
   88577/   42594 : (MACRO)              	levartptrs PLCID_Ehz1,        PLCID_Ehz2,      PalID_EHZ,  ArtKos_EHZ, BM16_EHZ, BM128_EHZ ; EHZ    ; EMERALD HILL ZONE
