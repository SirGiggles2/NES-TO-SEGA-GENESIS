(1) 3004/     CFC :                     ; (via Saxman's doc): panning, AMS, FMS
(1) 3005/     CFC :                     ; zloc_CFC
(1) 3006/     CFC :                     cfPanningAMSFMS:
(1) 3007/     CFC :                     	;Panning, AMS, FMS
(1) 3008/     CFC :                         ;* xx - Value (reg a)
(1) 3009/     CFC :                         ;      o Bit 7 - Left channel status
(1) 3010/     CFC :                         ;      o Bit 6 - Right channel Status
(1) 3011/     CFC :                         ;      o Bit 5-3 - AMS
(1) 3012/     CFC :                         ;      o Bit 2 - 0
(1) 3013/     CFC :                         ;      o Bit 1-0 - FMS
(1) 3014/     CFC :                     
(1) 3015/     CFC :                     	; Note that the AMS and FMS bits are saved; this command was only meant to
(1) 3016/     CFC :                     	; change the panning of a given channel.
(1) 3017/     CFC :                     
(1) 3018/     CFC : DD CB 01 7E         	bit	7,(ix+zTrack.VoiceControl)	; Is this a PSG track?
(1) 3019/     D00 : F8                  	ret	m				; If so, quit!
(1) 3021/     D01 :                     	; This check is in the wrong place.
(1) 3022/     D01 :                     	; If this flag is triggered by a music track while it's being overridden
(1) 3023/     D01 :                     	; by an SFX, it will use the old panning when the SFX ends.
(1) 3024/     D01 :                     	; This is because zTrack.AMSFMSPan doesn't get updated.
(1) 3025/     D01 : DD CB 00 56         	bit	2,(ix+zTrack.PlaybackControl)	; If "SFX overriding" bit set...
(1) 3026/     D05 : C0                  	ret	nz				; return
(1) 3028/     D06 : 4F                  	ld	c,a				; input val 'a' -> c
(1) 3029/     D07 : DD 7E 07            	ld	a,(ix+zTrack.AMSFMSPan)		; old PAF value
(1) 3030/     D0A : E6 37               	and	37h				; retains AMS and FMS bits
(1) 3031/     D0C : B1                  	or	c				; OR'd with new settings
(1) 3032/     D0D : DD 77 07            	ld	(ix+zTrack.AMSFMSPan),a		; new PAF value
(1) 3038/     D10 : 4F                  	ld	c,a				; a -> c (YM2612 data write)
(1) 3039/     D11 : DD 7E 01            	ld	a,(ix+zTrack.VoiceControl)	; Get voice control byte
(1) 3040/     D14 : E6 03               	and	3				; Channels only!
(1) 3041/     D16 : C6 B4               	add	a,0B4h				; Add register B4, stereo output control and LFO sensitivity
(1) 3042/     D18 : D7                  	rst	zWriteFMIorII			; Depends on bit 2 of (ix+zTrack.VoiceControl)
(1) 3043/     D19 : C9                  	ret
