   19580/    E0DE : 6606                	bne.s	.flipX		; if it is, branch
   19581/    E0E0 : 2C99                	move.l	(a1)+,(a6)	; write top two 8x8s to VRAM
   19582/    E0E2 : 24D9                	move.l	(a1)+,(a2)+	; store bottom two 8x8s for later writing
   19583/    E0E4 : 4E75                	rts
