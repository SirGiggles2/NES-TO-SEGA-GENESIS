   15178/    C4FC :                     ; ---------------------------------------------------------------------------
   15179/    C4FC :                     ; JUMP TABLE FOR SOFTWARE SCROLL MANAGERS
   15180/    C4FC :                     ;
   15181/    C4FC :                     ; "Software scrolling" is my term for what Nemesis (and by extension, the rest
   15182/    C4FC :                     ; of the world) calls "rasterized layer deformation".* Software scroll managers
   15183/    C4FC :                     ; are needed to achieve certain special camera effects - namely, locking the
   15184/    C4FC :                     ; screen for a boss fight and defining the limits of said screen lock, or in
   15185/    C4FC :                     ; the case of Sky Chase Zone ($10), moving the camera at a fixed rate through
   15186/    C4FC :                     ; a predefined course.
   15187/    C4FC :                     ; They are also used for things like controlling the parallax scrolling and
   15188/    C4FC :                     ; water ripple effects in EHZ, and moving the clouds in HTZ and the stars in DEZ.
   15189/    C4FC :                     ; ---------------------------------------------------------------------------
   15190/    C4FC : (MACRO)              SwScrl_Index: zoneOrderedOffsetTable 2,1	; JmpTbl_SwScrlMgr
   15190/    C4FC :  (MACRO-2)           SwScrl_Index zoneOrderedTable 2,1
   15190/    C4FC : =$C4FC               SwScrl_Index label *
   15190/    C4FC :                     ; set some global variables
   15190/    C4FC : ="SwScrl_Index"      .zone_table_name := "SwScrl_Index"
   15190/    C4FC : =$C4FC               .zone_table_addr := *
   15190/    C4FC : =$2                  .zone_entry_len := 2
   15190/    C4FC : =$1                  .zone_entries := 1
   15190/    C4FC : =$0                  .zone_entries_left := 0
   15190/    C4FC : =$0                  .cur_zone_id := 0
   15190/    C4FC : ="0"                 .cur_zone_str := "0"
   15190/    C4FC : =$C4FC               .current_offset_table := SwScrl_Index
   15191/    C4FC : (MACRO)              	zoneOffsetTableEntry.w SwScrl_EHZ	; EHZ
   15191/    C4FC :  (MACRO-2)                   zoneTableEntry.w SwScrl_EHZ-.current_offset_table
   15191/    C4FC :                                     !org .zone_table_addr+zone_id_{.cur_zone_str}*.zone_entry_len*.zone_entries
   15191/    C4FC : 0082                                dc.w SwScrl_EHZ-.current_offset_table
   15191/    C4FE : =$0                  .zone_entries_left := .zone_entries-1
   15191/    C4FE : =$1                  .cur_zone_id := .cur_zone_id+1
   15191/    C4FE : ="1"                 .cur_zone_str := "\{.cur_zone_id}"
   15191/    C4FE :                                 shift
