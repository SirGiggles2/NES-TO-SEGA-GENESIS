   88187/   41D0C :                     ; OBJECT DEBUG LISTS
   88188/   41D0C :                     
   88189/   41D0C :                     ; The jump table goes by level ID, so Metropolis Zone's list is repeated to
   88190/   41D0C :                     ; account for its third act. Hidden Palace Zone uses Oil Ocean Zone's list.
   88191/   41D0C :                     ; ---------------------------------------------------------------------------
   88192/   41D0C :                     ; JmpTbl_DbgObjLists:
   88193/   41D0C : (MACRO)              DebugObjectLists: zoneOrderedOffsetTable 2,1
   88193/   41D0C :  (MACRO-2)           DebugObjectLists zoneOrderedTable 2,1
   88193/   41D0C : =$41D0C              DebugObjectLists label *
   88193/   41D0C :                     ; set some global variables
   88193/   41D0C : ="DebugObjectLists"  .zone_table_name := "DebugObjectLists"
   88193/   41D0C : =$41D0C              .zone_table_addr := *
   88193/   41D0C : =$2                  .zone_entry_len := 2
   88193/   41D0C : =$1                  .zone_entries := 1
   88193/   41D0C : =$0                  .zone_entries_left := 0
   88193/   41D0C : =$0                  .cur_zone_id := 0
   88193/   41D0C : ="0"                 .cur_zone_str := "0"
   88193/   41D0C : =$41D0C              .current_offset_table := DebugObjectLists
   88194/   41D0C : (MACRO)              	zoneOffsetTableEntry.w DbgObjList_EHZ	; EHZ
   88194/   41D0C :  (MACRO-2)                   zoneTableEntry.w DbgObjList_EHZ-.current_offset_table
   88194/   41D0C :                                     !org .zone_table_addr+zone_id_{.cur_zone_str}*.zone_entry_len*.zone_entries
   88194/   41D0C : 0034                                dc.w DbgObjList_EHZ-.current_offset_table
   88194/   41D0E : =$0                  .zone_entries_left := .zone_entries-1
   88194/   41D0E : =$1                  .cur_zone_id := .cur_zone_id+1
   88194/   41D0E : ="1"                 .cur_zone_str := "\{.cur_zone_id}"
   88194/   41D0E :                                 shift
   88194/   41D0E :   (MACRO-3)                      zoneTableEntry.w 
   88195/   41D0E : (MACRO)              	zoneOffsetTableEntry.w DbgObjList_Def	; Zone 1
   88195/   41D0E :  (MACRO-2)                   zoneTableEntry.w DbgObjList_Def-.current_offset_table
   88195/   41D0E :                                     !org .zone_table_addr+zone_id_{.cur_zone_str}*.zone_entry_len*.zone_entries
   88195/   41D0E : 0022                                dc.w DbgObjList_Def-.current_offset_table
   88195/   41D10 : =$0                  .zone_entries_left := .zone_entries-1
   88195/   41D10 : =$2                  .cur_zone_id := .cur_zone_id+1
   88195/   41D10 : ="2"                 .cur_zone_str := "\{.cur_zone_id}"
   88195/   41D10 :                                 shift
   88195/   41D10 :   (MACRO-3)                      zoneTableEntry.w 
   88196/   41D10 : (MACRO)              	zoneOffsetTableEntry.w DbgObjList_Def	; WZ
   88196/   41D10 :  (MACRO-2)                   zoneTableEntry.w DbgObjList_Def-.current_offset_table
   88196/   41D10 :                                     !org .zone_table_addr+zone_id_{.cur_zone_str}*.zone_entry_len*.zone_entries
   88196/   41D10 : 0022                                dc.w DbgObjList_Def-.current_offset_table
   88196/   41D12 : =$0                  .zone_entries_left := .zone_entries-1
   88196/   41D12 : =$3                  .cur_zone_id := .cur_zone_id+1
   88196/   41D12 : ="3"                 .cur_zone_str := "\{.cur_zone_id}"
