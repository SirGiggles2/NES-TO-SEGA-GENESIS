   88706/   426E6 :                     ; macro for a pattern load request list header
   88707/   426E6 :                     ; must be on the same line as a label that has a corresponding _End label later
   88708/   426E6 :                     plrlistheader macro {INTLABEL}
   88709/   426E6 :                     __LABEL__ label *
   88710/   426E6 :                     	dc.w (((__LABEL___End - __LABEL__Plc) / 6) - 1)
   88711/   426E6 :                     __LABEL__Plc:
   88712/   426E6 :                         endm
   88713/   426E6 :                     
   88714/   426E6 :                     ; macro for a pattern load request
   88715/   426E6 :                     plreq macro toVRAMaddr,fromROMaddr
   88716/   426E6 :                     	dc.l	fromROMaddr
   88717/   426E6 :                     	dc.w	tiles_to_bytes(toVRAMaddr)
   88718/   426E6 :                         endm
   88719/   426E6 :                     
