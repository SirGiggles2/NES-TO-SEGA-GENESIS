   24347/   118CE : ="0"                 .cur_zone_str := "0"
   24348/   118CE :                     
   24349/   118CE :                     zoneAnimals macro first,second
   24350/   118CE :                     	zoneTableEntry.b (Obj28_Properties_first - Obj28_Properties) / 8
   24351/   118CE :                     	zoneTableEntry.b (Obj28_Properties_second - Obj28_Properties) / 8
   24352/   118CE :                         endm
   24353/   118CE :                     	; This table declares what animals will appear in the zone.
   24354/   118CE :                     	; When an enemy is destroyed, a random animal is chosen from the 2 selected animals.
   24355/   118CE :                     	; Note: you must also load the corresponding art in the PLCs.
   24356/   118CE : (MACRO)              	zoneAnimals.b Squirrel,	Flicky	; EHZ
