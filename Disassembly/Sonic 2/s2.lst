(1)  717/     1A4 : 32 AA 01            	ld	(.lownybble+2),a	; 13	; store into the instruction after .lownybble (self-modifying code)
(1)  718/     1A7 : 08                  	ex	af,af'			; 4	; shadow register 'a' is the 'd' value for 'jman2050' encoding
(1)  719/     1A8 :                     
