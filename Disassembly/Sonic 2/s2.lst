   35224/   19A76 : 4A69 0010           	tst.w	x_vel(a1)		; Is Sonic moving left?
   35225/   19A7A : 6B14                	bmi.s	SolidObject_AtEdge	; If yes, branch
   35226/   19A7C : 6006                	bra.s	SolidObject_StopCharacter
   35227/   19A7E :                     ; ===========================================================================
   35228/   19A7E :                     ; loc_19A7E:
   35229/   19A7E :                     SolidObject_InsideRight:
   35230/   19A7E : 4A69 0010           	tst.w	x_vel(a1)		; is Sonic moving right?
   35231/   19A82 : 6A0C                	bpl.s	SolidObject_AtEdge	; if yes, branch
   35232/   19A84 :                     ; loc_19A84:
   35233/   19A84 :                     SolidObject_StopCharacter:
   35234/   19A84 : 337C 0000 0014      	move.w	#0,inertia(a1)
   35235/   19A8A : 337C 0000 0010      	move.w	#0,x_vel(a1)		; stop Sonic moving
   35236/   19A90 :                     ; loc_19A90:
   35237/   19A90 :                     SolidObject_AtEdge:
   35238/   19A90 : 9169 0008           	sub.w	d0,x_pos(a1)		; correct Sonic's position
   35239/   19A94 : 0829 0001 0022      	btst	#status.player.in_air,status(a1)	; is Sonic in the air?
   35240/   19A9A : 661A                	bne.s	SolidObject_SideAir	; if yes, branch
   35241/   19A9C : 2806                	move.l	d6,d4
   35242/   19A9E : 5404                	addq.b	#pushing_bit_delta,d4	; Character is pushing, not standing
   35243/   19AA0 : 09E8 0022           	bset	d4,status(a0)		; make object be pushed
   35244/   19AA4 : 08E9 0005 0022      	bset	#status.player.pushing,status(a1)	; make Sonic push object
   35245/   19AAA : 3806                	move.w	d6,d4
   35246/   19AAC : 0604 000D           	addi.b	#($10-p1_standing_bit+p1_touch_side_bit),d4
   35247/   19AB0 : 09C6                	bset	d4,d6	; This sets bits 0 (Sonic) or 1 (Tails) of high word of d6
   35248/   19AB2 : 7801                	moveq	#1,d4	; return side collision
   35249/   19AB4 : 4E75                	rts
