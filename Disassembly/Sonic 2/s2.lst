   29992/   163B0 : 2628 000C           	move.l	y_pos(a0),d3	; load y position
   29993/   163B4 : 3028 0010           	move.w	x_vel(a0),d0	; load horizontal speed
   29994/   163B8 : 48C0                	ext.l	d0
   29995/   163BA : E180                	asl.l	#8,d0	; shift velocity to line up with the middle 16 bits of the 32-bit position
   29996/   163BC : D480                	add.l	d0,d2	; add to x-axis position	; note this affects the subpixel position x_sub(a0) = 2+x_pos(a0)
   29997/   163BE : 3028 0012           	move.w	y_vel(a0),d0	; load vertical speed
   29998/   163C2 : 48C0                	ext.l	d0
   29999/   163C4 : E180                	asl.l	#8,d0	; shift velocity to line up with the middle 16 bits of the 32-bit position
   30000/   163C6 : D680                	add.l	d0,d3	; add to y-axis position	; note this affects the subpixel position y_sub(a0) = 2+y_pos(a0)
   30001/   163C8 : 2142 0008           	move.l	d2,x_pos(a0)	; update x-axis position
   30002/   163CC : 2143 000C           	move.l	d3,y_pos(a0)	; update y-axis position
   30003/   163D0 : 4E75                	rts
   30004/   163D2 :                     ; End of function ObjectMove
