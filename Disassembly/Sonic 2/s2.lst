   20850/    EB78 :                     ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
   20851/    EB78 :                     
   20852/    EB78 :                     ; Computes how much the background layer has been scrolled in X and Y and
   20853/    EB78 :                     ; stores result to Camera_BG_X_pos_diff and Camera_BG_Y_pos_diff.
   20854/    EB78 :                     ; Caps maximum scroll speed to 16 pixels per frame in either direction.
   20855/    EB78 :                     ; This is used to decide how much of the BG needs to be reloaded.
   20856/    EB78 :                     ;
   20857/    EB78 :                     ; Used for rising lava/terrain in HTZ, and for WFZ->DEZ transition in WFZ.
   20858/    EB78 :                     ;
   20859/    EB78 :                     ; Input:
   20860/    EB78 :                     ;	d0	Target X position of background
   20861/    EB78 :                     ;	d1	Target Y position of background
   20862/    EB78 :                     ;sub_EB78
   20863/    EB78 :                     ScrollBG:
   20864/    EB78 : 9078 EE08           	sub.w	(Camera_BG_X_pos).w,d0
   20865/    EB7C : 9078 EEE2           	sub.w	(Camera_BG_X_offset).w,d0
   20866/    EB80 : 6A0C                	bpl.s	.going_right
   20867/    EB82 : 0C40 FFF0           	cmpi.w	#-16,d0
   20868/    EB86 : 6E04                	bgt.s	.skip_x_cap
   20869/    EB88 : 303C FFF0           	move.w	#-16,d0
   20870/    EB8C :                     
   20871/    EB8C :                     .skip_x_cap:
   20872/    EB8C : 600A                	bra.s	.move_x
   20873/    EB8E :                     ; ===========================================================================
   20874/    EB8E :                     .going_right:
   20875/    EB8E : 0C40 0010           	cmpi.w	#16,d0
   20876/    EB92 : 6504                	blo.s	.move_x
   20877/    EB94 : 303C 0010           	move.w	#16,d0
   20878/    EB98 :                     
   20879/    EB98 :                     .move_x:
