(1)  701/     191 : 08                  	ex	af,af'			; 4	; back to regular registers
(1)  702/     192 : 41                  	ld	b,c			; 4	; reload 'b' with wait value
(1)  703/     193 : FB                  	ei				; 4	; enable interrupts (done updating DAC, busy waiting for next update)
(1)  704/     194 :                     
(1)  705/     194 : 10 FE               	djnz	$			; 8	; Busy wait for specific amount of time in 'b'
(1)  706/     196 :                     
(1)  707/     196 : F3                  	di				; 4	; disable interrupts (while updating DAC)
(1)  708/     197 : F5                  	push	af			; 11
(1)  709/     198 : F1                  	pop	af			; 11
(1)  710/     199 : 3E 2A               	ld	a,2Ah			; 7	; DAC port
(1)  711/     19B : 32 00 40            	ld	(zYM2612_A0),a		; 13	; Set DAC port register
(1)  712/     19E : 41                  	ld	b,c			; 4	; reload 'b' with wait value
(1)  713/     19F : 7E                  	ld	a,(hl)			; 7+3	; Get next DAC byte
