   24347/   118CE : =$118CE              Obj28_ZoneAnimals label *
   24347/   118CE :                     ; set some global variables
   24347/   118CE : ="Obj28_ZoneAnim..   .zone_table_name := "Obj28_ZoneAnimals"
   24347/   118CE : =$118CE              .zone_table_addr := *
   24347/   118CE : =$1                  .zone_entry_len := 1
   24347/   118CE : =$2                  .zone_entries := 2
