(1)  730/     1B3 :                     ; 'jman2050' DAC decode lookup table
(1)  731/     1B3 :                     ; zbyte_1B3
(1)  732/     1B3 :                     zDACDecodeTbl:
(1)  733/     1B3 :                     	binclude "sound/DAC/deltas.bin"
(1)  734/     1C3 :                     
(1)  735/     1C3 :                     	; The following two tables are used for when an SFX terminates
(1)  736/     1C3 :                     	; its track to properly restore the music track it temporarily took
(1)  737/     1C3 :                     	; over.  Note that an important rule here is that no SFX may use
(1)  738/     1C3 :                     	; DAC, FM Channel 1, FM Channel 2, or FM Channel 6, period.
(1)  739/     1C3 :                     	; Thus there's also only SFX tracks starting at FM Channel 3.
(1)  740/     1C3 :                     
(1)  741/     1C3 :                     	; The zeroes appear after FM 3 because it calculates the offsets into
(1)  742/     1C3 :                     	; these tables by their channel assignment, where between Channel 3
(1)  743/     1C3 :                     	; and Channel 4 there is a gap numerically.
(1)  744/     1C3 :                     
(1)  745/     1C3 : (MACRO)              	ensure1byteoffset 10h
(1)  746/     1C3 :                     ; zbyte_1C3
(1)  747/     1C3 :                     zMusicTrackOffs:
(1)  748/     1C3 :                     	; These are offsets to different music tracks starting with FM3
(1)  749/     1C3 : 16 1C 00 00 40 1C   	dw	zSongFM3,      0000h,  zSongFM4,  zSongFM5	; FM3, 0, FM4, FM5
              1C9 : 6A 1C             
(1)  750/     1CB : BE 1C E8 1C 12 1D   	dw	zSongPSG1, zSongPSG2, zSongPSG3, zSongPSG3	; PSG1, PSG2, PSG3, PSG3 (noise alternate)
              1D1 : 12 1D             
(1)  751/     1D3 :                     
(1)  752/     1D3 : (MACRO)              	ensure1byteoffset 10h
(1)  753/     1D3 :                     ; zbyte_1D3
