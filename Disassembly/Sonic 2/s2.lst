   89640/   45A80 :                     ; Offset index of level layouts
   89641/   45A80 :                     ; Two entries per zone, pointing to the level layouts for acts 1 and 2 of each zone
   89642/   45A80 :                     ; respectively.
   89643/   45A80 :                     ;---------------------------------------------------------------------------------------
   89644/   45A80 : (MACRO)              Off_Level: zoneOrderedOffsetTable 2,2
   89644/   45A80 :  (MACRO-2)           Off_Level zoneOrderedTable 2,2
   89644/   45A80 : =$45A80              Off_Level label *
   89644/   45A80 :                     ; set some global variables
   89644/   45A80 : ="Off_Level"         .zone_table_name := "Off_Level"
   89644/   45A80 : =$45A80              .zone_table_addr := *
   89644/   45A80 : =$2                  .zone_entry_len := 2
   89644/   45A80 : =$2                  .zone_entries := 2
   89644/   45A80 : =$0                  .zone_entries_left := 0
   89644/   45A80 : =$0                  .cur_zone_id := 0
   89644/   45A80 : ="0"                 .cur_zone_str := "0"
   89644/   45A80 : =$45A80              .current_offset_table := Off_Level
   89645/   45A80 :                     	; EHZ
   89646/   45A80 : (MACRO)              	zoneOffsetTableEntry.w Level_EHZ1	; Act 1
   89646/   45A80 :  (MACRO-2)                   zoneTableEntry.w Level_EHZ1-.current_offset_table
   89646/   45A80 :                                     !org .zone_table_addr+zone_id_{.cur_zone_str}*.zone_entry_len*.zone_entries
   89646/   45A80 : 0044                                dc.w Level_EHZ1-.current_offset_table
   89646/   45A82 : =$1                  .zone_entries_left := .zone_entries-1
   89646/   45A82 : =$1                  .cur_zone_id := .cur_zone_id+1
   89646/   45A82 : ="1"                 .cur_zone_str := "\{.cur_zone_id}"
   89646/   45A82 :                                 shift
   89646/   45A82 :   (MACRO-3)                      zoneTableEntry.w 
   89647/   45A82 : (MACRO)              	zoneOffsetTableEntry.w Level_EHZ2	; Act 2
   89647/   45A82 :  (MACRO-2)                   zoneTableEntry.w Level_EHZ2-.current_offset_table
   89647/   45A82 : 0204                                dc.w Level_EHZ2-.current_offset_table
   89647/   45A84 : =$0                  .zone_entries_left := .zone_entries_left-1
   89647/   45A84 :                                 shift
   89647/   45A84 :   (MACRO-3)                      zoneTableEntry.w 
   89648/   45A84 :                     	; Zone 1
   89649/   45A84 : (MACRO)              	zoneOffsetTableEntry.w Level_Invalid	; Act 1
   89649/   45A84 :  (MACRO-2)                   zoneTableEntry.w Level_Invalid-.current_offset_table
   89649/   45A84 :                                     !org .zone_table_addr+zone_id_{.cur_zone_str}*.zone_entry_len*.zone_entries
