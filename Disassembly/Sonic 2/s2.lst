   42917/   1E598 : D040                	add.w	d0,d0
   42918/   1E59A : 0240 0F00           	andi.w	#$F00,d0	; rounded 2*y_pos
   42919/   1E59E : 3203                	move.w	d3,d1	; x_pos
   42920/   1E5A0 : E649                	lsr.w	#3,d1
   42921/   1E5A2 : 3801                	move.w	d1,d4
   42922/   1E5A4 : E849                	lsr.w	#4,d1	; x_pos/128 = x_of_chunk
   42923/   1E5A6 : 0241 007F           	andi.w	#$7F,d1
   42924/   1E5AA : D041                	add.w	d1,d0	; d0 is relevant chunk ID now
   42925/   1E5AC : 72FF                	moveq	#-1,d1
   42926/   1E5AE : 4241                	clr.w	d1		; d1 is now $FFFF0000 = Chunk_Table
   42927/   1E5B0 : 43F8 8000           	lea	(Level_Layout).w,a1
   42928/   1E5B4 : 1231 0000           	move.b	(a1,d0.w),d1	; move 128*128 chunk ID to d1
   42929/   1E5B8 : D241                	add.w	d1,d1
   42930/   1E5BA : 323B 1014           	move.w	word_1E5D0(pc,d1.w),d1
   42931/   1E5BE : 3002                	move.w	d2,d0	; y_pos
   42932/   1E5C0 : 0240 0070           	andi.w	#$70,d0
   42933/   1E5C4 : D240                	add.w	d0,d1
   42934/   1E5C6 : 0244 000E           	andi.w	#$E,d4	; x_pos/8
   42935/   1E5CA : D244                	add.w	d4,d1
