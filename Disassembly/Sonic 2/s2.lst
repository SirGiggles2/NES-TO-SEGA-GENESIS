   29955/   16380 :                     ; Subroutine to make an object move and fall downward increasingly fast
   29956/   16380 :                     ; This moves the object horizontally and vertically
   29957/   16380 :                     ; and also applies gravity to its speed
   29958/   16380 :                     ; ---------------------------------------------------------------------------
   29959/   16380 :                     
   29960/   16380 :                     ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
   29961/   16380 :                     
   29962/   16380 :                     ; sub_16380: ObjectFall:
   29963/   16380 :                     ObjectMoveAndFall:
   29964/   16380 : 2428 0008           	move.l	x_pos(a0),d2	; load x position
   29965/   16384 : 2628 000C           	move.l	y_pos(a0),d3	; load y position
   29966/   16388 : 3028 0010           	move.w	x_vel(a0),d0	; load x speed
   29967/   1638C : 48C0                	ext.l	d0
   29968/   1638E : E180                	asl.l	#8,d0	; shift velocity to line up with the middle 16 bits of the 32-bit position
   29969/   16390 : D480                	add.l	d0,d2	; add x speed to x position	; note this affects the subpixel position x_sub(a0) = 2+x_pos(a0)
   29970/   16392 : 3028 0012           	move.w	y_vel(a0),d0	; load y speed
   29971/   16396 : 0668 0038 0012      	addi.w	#$38,y_vel(a0)	; increase vertical speed (apply gravity)
   29972/   1639C : 48C0                	ext.l	d0
   29973/   1639E : E180                	asl.l	#8,d0	; shift velocity to line up with the middle 16 bits of the 32-bit position
   29974/   163A0 : D680                	add.l	d0,d3	; add old y speed to y position	; note this affects the subpixel position y_sub(a0) = 2+y_pos(a0)
   29975/   163A2 : 2142 0008           	move.l	d2,x_pos(a0)	; store new x position
   29976/   163A6 : 2143 000C           	move.l	d3,y_pos(a0)	; store new y position
   29977/   163AA : 4E75                	rts
   29978/   163AC :                     ; End of function ObjectMoveAndFall
   29979/   163AC :                     ; >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
