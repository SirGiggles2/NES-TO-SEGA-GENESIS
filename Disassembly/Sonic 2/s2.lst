   90253/   94E74 :                     
   90254/   94E74 :                     ; >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
   90255/   94E74 :                     ; LEVEL ART AND BLOCK MAPPINGS (16x16 and 128x128)
   90256/   94E74 :                     ;
   90257/   94E74 :                     ; #define BLOCK_TBL_LEN  // table length unknown
   90258/   94E74 :                     ; #define BIGBLOCK_TBL_LEN // table length unknown
   90259/   94E74 :                     ; typedef uint16_t uword
   90260/   94E74 :                     ;
   90261/   94E74 :                     ; struct blockMapElement {
   90262/   94E74 :                     ;  uword unk : 5;    // u
   90263/   94E74 :                     ;  uword patternIndex : 11; };  // i
   90264/   94E74 :                     ; // uuuu uiii iiii iiii
   90265/   94E74 :                     ;
   90266/   94E74 :                     ; blockMapElement (*blockMapTable)[BLOCK_TBL_LEN][4] = 0xFFFF9000
   90267/   94E74 :                     ;
   90268/   94E74 :                     ; struct bigBlockMapElement {
   90269/   94E74 :                     ;  uword : 4
   90270/   94E74 :                     ;  uword blockMapIndex : 12; };  //I
   90271/   94E74 :                     ; // 0000 IIII IIII IIII
   90272/   94E74 :                     ;
   90273/   94E74 :                     ; bigBlockMapElement (*bigBlockMapTable)[BIGBLOCK_TBL_LEN][64] = 0xFFFF0000
   90274/   94E74 :                     ;
   90275/   94E74 :                     ; /*
   90276/   94E74 :                     ; This data determines how the level blocks will be constructed graphically. There are
   90277/   94E74 :                     ; two kinds of block mappings: 16x16 and 128x128.
   90278/   94E74 :                     ;
   90279/   94E74 :                     ; 16x16 blocks are made up of four cells arranged in a square (thus, 16x16 pixels).
   90280/   94E74 :                     ; Two bytes are used to define each cell, so the block is 8 bytes long. It can be
   90281/   94E74 :                     ; represented by the bitmap blockMapElement, of which the members are:
   90282/   94E74 :                     ;
   90283/   94E74 :                     ; unk
   90284/   94E74 :                     ;  These bits have to do with pattern orientation. I do not know their exact
   90285/   94E74 :                     ;  meaning.
   90286/   94E74 :                     ; patternIndex
   90287/   94E74 :                     ;  The pattern's address divided by $20. Otherwise said: an index into the
   90288/   94E74 :                     ;  pattern array.
   90289/   94E74 :                     ;
   90290/   94E74 :                     ; Each mapping can be expressed as an array of four blockMapElements, while the
   90291/   94E74 :                     ; whole table is expressed as a two-dimensional array of blockMapElements (blockMapTable).
   90292/   94E74 :                     ; The maps are read in left-to-right, top-to-bottom order.
   90293/   94E74 :                     ;
   90294/   94E74 :                     ; 128x128 maps are basically lists of indices into blockMapTable. The levels are built
   90295/   94E74 :                     ; out of these "big blocks", rather than the "small" 16x16 blocks. bigBlockMapTable is,
   90296/   94E74 :                     ; predictably, the table of big block mappings.
   90297/   94E74 :                     ; Each big block is 8 16x16 blocks, or 16 cells, square. This produces a total of 16
   90298/   94E74 :                     ; blocks or 64 cells.
   90299/   94E74 :                     ; As noted earlier, each element of the table provides 'i' for blockMapTable[i][j].
   90300/   94E74 :                     ; */
   90301/   94E74 :                     
   90302/   94E74 :                     ; All of these are compressed in the Kosinski format.
   90303/   94E74 :                     
   90304/   94E74 :                     BM16_EHZ:	BINCLUDE	"mappings/16x16/EHZ.kos"
   90305/   95C24 :                     ArtKos_EHZ:	BINCLUDE	"art/kosinski/EHZ_HTZ.kos"
   90306/   985A4 :                     BM16_HTZ:	BINCLUDE	"mappings/16x16/HTZ.kos"
   90307/   98AB4 :                     ArtKos_HTZ:	BINCLUDE	"art/kosinski/HTZ_Supp.kos" ; HTZ pattern suppliment to EHZ level patterns
   90308/   99D34 :                     BM128_EHZ:	BINCLUDE	"mappings/128x128/EHZ_HTZ.kos"
   90309/   9CFD4 :                     
   90310/   9CFD4 :                     BM16_MTZ:	BINCLUDE	"mappings/16x16/MTZ.kos"
   90311/   9DB64 :                     ArtKos_MTZ:	BINCLUDE	"art/kosinski/MTZ.kos"
   90312/   A06C4 :                     BM128_MTZ:	BINCLUDE	"mappings/128x128/MTZ.kos"
   90313/   A3364 :                     
