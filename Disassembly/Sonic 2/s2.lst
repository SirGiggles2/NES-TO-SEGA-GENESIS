   84036/   3E944 :                     ; Upscales the given tile to the pair of tiles on the output pointers.
   84037/   3E944 :                     ;
   84038/   3E944 :                     ; Input:
   84039/   3E944 :                     ; 	a1	Pixel source
   84040/   3E944 :                     ; 	d5	Number of tiles-1 to upscale
