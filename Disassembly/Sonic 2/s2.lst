   31941/   1723C :                     	; Note that this 'andi' occurs *before* an 'addi'. This can cause
   31942/   1723C :                     	; 'd2' to wrap incorrectly. This defect is the reason why rings disappear
   31943/   1723C :                     	; when they go halfway off the top of the screen. To fix this, simply
   31944/   1723C :                     	; swap these two instructions around.
   31945/   1723C : 0242 07FF           	andi.w	#$7FF,d2
   31946/   17240 : 0642 0088           	addi.w	#spriteScreenPositionY(8),d2
   31948/   17244 :                     	; This line is completely redundant: an apparent leftover from one of the
   31949/   17244 :                     	; prototypes, back when the above 'andi' didn't exist. S3K gets rid of this.
