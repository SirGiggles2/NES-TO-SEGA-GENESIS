   15663/    C894 :                     
   15664/    C894 :                     	; Find the first visible scrolling section
   15665/    C894 :                     .seg_loop:
   15666/    C894 : 101B                	move.b	(a3)+,d0		; Number of lines in this segment
   15667/    C896 : 524B                	addq.w	#1,a3			; Skip index
   15668/    C898 : 9240                	sub.w	d0,d1			; Does this segment have any visible lines?
   15669/    C89A : 64F8                	bcc.s	.seg_loop		; Branch if not
   15670/    C89C :                     
   15671/    C89C : 4441                	neg.w	d1			; d1 = number of lines to draw in this segment
   15672/    C89E : 343C 00DF           	move.w	#screen_height-1,d2		; Number of rows in hscroll buffer
   15673/    C8A2 : 3038 EE00           	move.w	(Camera_X_pos).w,d0
   15674/    C8A6 : 4440                	neg.w	d0
   15675/    C8A8 : 4840                	swap	d0
   15676/    C8AA : 162B FFFF           	move.b	-1(a3),d3		; Fetch TempArray_LayerDef index
   15677/    C8AE : 3032 3000           	move.w	(a2,d3.w),d0		; Fetch scroll value for this row...
   15678/    C8B2 : 4440                	neg.w	d0			; ...and flip sign for VDP
   15679/    C8B4 :                     
   15680/    C8B4 :                     .row_loop:
   15681/    C8B4 : 22C0                	move.l	d0,(a1)+
   15682/    C8B6 : 5341                	subq.w	#1,d1			; Has the current segment finished?
   15683/    C8B8 : 660A                	bne.s	.next_row		; Branch if not
   15684/    C8BA : 121B                	move.b	(a3)+,d1		; Fetch a new line count
   15685/    C8BC : 161B                	move.b	(a3)+,d3		; Fetch TempArray_LayerDef index
   15686/    C8BE : 3032 3000           	move.w	(a2,d3.w),d0		; Fetch scroll value for this row...
   15687/    C8C2 : 4440                	neg.w	d0			; ...and flip sign for VDP
   15688/    C8C4 :                     
   15689/    C8C4 :                     .next_row:
   15690/    C8C4 : 51CA FFEE           	dbf	d2,.row_loop
   15691/    C8C8 :                     
